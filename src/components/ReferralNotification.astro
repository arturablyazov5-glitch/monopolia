---
interface Props {
  bank: string;
  time: string;
  icon: string;
  /** Страница логотипа на Trace Logos — обратная ссылка с иконки */
  href?: string;
  alt?: string;
  masked?: boolean;
}
const { bank, time, icon, href, alt = "", masked = false } = Astro.props;
---

<div class="referral-notification">
  <span
    class:list={[
      "referral-notification-icon",
      { "referral-notification-tbank": masked },
    ]}
  >
    {href ? (
      <a href={href}>
        <img
          src={icon}
          alt={alt}
          loading="lazy"
          width="40"
          height="40"
          decoding="async"
        />
      </a>
    ) : (
      <img
        src={icon}
        alt={alt}
        loading="lazy"
        width="40"
        height="40"
        decoding="async"
      />
    )}
  </span>
  <div class="referral-notification-text">
    <div>
      <p>{bank}</p>
      <small>{time}</small>
    </div>
    <p>Пополнение на 5 000 ₽</p>
  </div>
</div>
