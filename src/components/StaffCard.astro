---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import Badge from "./Badge.astro";
interface Props {
  name?: string;
  role?: string;
  image?: string;
  badge?: string;
  facts?: string[];
  variant?: string;
  certificate?: string;
  /** false — карточка без фото (в макете фото ещё нет) */
  photo?: boolean;
}
const {
  variant = "",
  certificate,
  photo = true,
  name = "Евгения Матухнова",
  role = siteText("staff-card.role.1"),
  image = "/assets/staff-evgeniya-matukhnova.webp",
  badge = siteText("staff-card.badge.2"),
  facts = [
    siteText("staff-card.facts.3"),
    siteText("staff-card.facts.4"),
    siteText("staff-card.facts.5"),
  ],
} = Astro.props;
---

<Paper class={`staff-card ${variant}`} node="1380:5639">
  <div class="staff-photo brush-stroke">
    {photo && (
      <img
        class="staff-person person-photo"
        src={image}
        width="1000"
        height="1000"
        alt={name}
        loading="lazy"
        decoding="async"
      />
    )}
    <Badge text={badge} />
  </div>
  <div>
    <h3>{name}</h3>
    <p class="muted">{role}</p>
  </div>
  {certificate && (
    <Paper class="staff-certificate" tapeNode="I1467:10447;569:1633">
      <p>{siteText("staff-card.text.6")}</p>
      <p>{certificate}</p>
    </Paper>
  )}
  <hr />
  <ul class="diamond-list bullet-list">
    {facts.map((fact) => (
      <li>{fact}</li>
    ))}
  </ul>
</Paper>
