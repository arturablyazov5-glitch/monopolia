---
import Paper from "./Paper.astro";
import PlayButton from "./PlayButton.astro";
import VideoDuration from "./VideoDuration.astro";
const {
  name = "Светлана В.",
  image = "/assets/review-svetlana-thumbnail.webp",
  duration = "0:47",
  video,
  placeholder = false,
  reviewIcon = false,
} = Astro.props;
---

<Paper class="review-card" node="1380:5189">
  <div
    class:list={[
      "review-photo",
      "brush-stroke",
      { "review-photo-video": !!video },
    ]}
  >
    {placeholder ? (
      <div
        aria-hidden="true"
        style="width:100%;height:100%;background:var(--canvas)"
      ></div>
    ) : (
      <img
        src={image}
        width="269"
        height="340"
        alt={name}
        loading="lazy"
        decoding="async"
      />
    )}
    <PlayButton
      label={`Отзыв: ${name}`}
      video={video}
      reviewIcon={reviewIcon}
    />
    <VideoDuration time={duration} />
  </div>
  <h3>{name}</h3>
  <img
    src="/assets/rating-five-stars.svg"
    width="100"
    height="14"
    alt="5 звезд"
    loading="lazy"
    decoding="async"
  />
</Paper>

<style>
  .review-photo.review-photo-video > img {
    position: static;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
