---
import { siteText } from "../data/site-texts.mjs";
import { imageSize } from "../lib/image-size";
// Общий первый экран внутренних страниц: мастер Figma 1380:5758 («Продажа»)
// и 1380:6363 («Покупка»). Фон, команда, рейтинг, поля квиза одинаковые;
// Карточка квиза общая с попапами; ее контент хранится в data/hero-quiz.ts.
import RatingBadge from "./RatingBadge.astro";
import HeroQuizCard from "./HeroQuizCard.astro";
import MarketplaceBadge from "./MarketplaceBadge.astro";
import "../styles/inner-hero.css";

interface Props {
  /** data-node-id экземпляра в Figma. */
  node?: string;
  /** Строки заголовка h1 (каждая с новой строки). */
  title: string[];
  /** Рукописная вставка красным (Denistina) в конце строки accentLine. */
  accent?: string;
  accentLine?: number;
  /** Добавить строку «на [Авито] и [Циан]» (вариант «Покупки»). */
  markets?: boolean;
  description: string;
}

const {
  node = "1380:5758",
  title,
  accent,
  accentLine = 1,
  markets = false,
  description,
} = Astro.props;

// Команда: Figma I…;1174:9735 (1421 × 1021.151), порядок слоев как в макете.
const team = [
  {
    stroke: "inner-hero-team-shadow-left.svg",
    box: "9.86% 56.74% 44.98% 24.19%",
    bleed: "-14.82% -18.41% -14.96% -36.22%",
    photo: "hero-team-left-inner-portrait",
    mobilePhoto: "hero-team-left-inner-portrait-320w",
    pos: "--team-left:24.63%;--team-width:21.38%;--team-top:99.37px",
    ratio: "271.495117 / 413.48706",
  },
  {
    stroke: "home-hero-team/06-right-inner-shadow.svg",
    box: "10.53% 26.95% 43.09% 55.82%",
    bleed: "-14.34% -19.65% -15.94% -40.11%",
    photo: "home-hero-team/06-right-inner",
    pos: "--team-left:52%;--team-width:21.13%;--team-top:99.37px",
    ratio: "771 / 1345",
  },
  {
    stroke: "inner-hero-team-shadow-center.svg",
    box: "6.39% 41.12% 42.97% 40.2%",
    bleed: "-13.37% -17.74% -13.38% -36.62%",
    photo: "hero-team-center-portrait",
    mobilePhoto: "hero-team-center-portrait-320w",
    pos: "--team-left:38.79%;--team-width:21.72%;--team-bottom:54.92px",
    ratio: "275.914581 / 803.424316",
  },
];
---

<section
  class="inner-hero"
  aria-labelledby="inner-hero-title"
  data-node-id={node}
>
  <img
    class="inner-hero-background"
    src="/assets/inner-hero-background.webp"
    alt=""
    width="1440"
    height="840"
    fetchpriority="low"
    loading="eager"
    decoding="async"
  />
  <div class="inner-hero-container">
    <div class="inner-hero-copy">
      <RatingBadge loading="eager" />
      <h1 id="inner-hero-title" class:list={{ "with-markets": markets }}>
        {title.map((line, index) => (
          <>
            {index > 0 && <br />}
            {markets &&
            index === title.length - 1 &&
            line.endsWith(siteText("inner-hero.text.7")) ? (
              <>
                {line.slice(0, -4)}
                <span class="inner-hero-net-desktop">
                  {" "}
                  {siteText("inner-hero.text.7")}
                </span>
              </>
            ) : (
              line
            )}
            {accent && index === accentLine && (
              <>
                {" "}
                <span class="inner-hero-accent-space" aria-hidden="true">
                  {accent}
                </span>
                <span class="inner-hero-accent">{accent}</span>
              </>
            )}
          </>
        ))}
        {markets && (
          <span class="inner-hero-markets">
            <span>
              <span class="inner-hero-net-mobile">
                {siteText("inner-hero.text.7")}{" "}
              </span>
              {siteText("inner-hero.text.8")}
            </span>
            <MarketplaceBadge name="avito" loading="eager" />
            и
            <MarketplaceBadge name="cian" loading="eager" />
          </span>
        )}
      </h1>
      <p class="inner-hero-description">{description}</p>
    </div>

    <div
      class="inner-hero-team"
      role="img"
      aria-label="Специалисты агентства недвижимости Монополия"
    >
      {team.map((layer) => (
        <>
          <div class="inner-team-stroke" style={`inset:${layer.box}`}>
            <div style={`inset:${layer.bleed}`}>
              <img
                src={"/assets/" + layer.stroke}
                alt=""
                width={imageSize("/assets/" + layer.stroke).width}
                height={imageSize("/assets/" + layer.stroke).height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <picture style="display:contents">
            {layer.mobilePhoto && <source
              media="(max-width: 767px)"
              srcset={`/assets/${layer.mobilePhoto}.webp 320w, /assets/${layer.photo}.webp ${imageSize("/assets/" + layer.photo + ".webp").width}w`}
              sizes="160px"
              style="display:none"
            />}
            <img
              class="inner-team-portrait person-photo"
              src={"/assets/" + layer.photo + ".webp"}
              alt=""
              style={`${layer.pos};aspect-ratio:${layer.ratio}`}
              fetchpriority="auto"
              width={imageSize("/assets/" + layer.photo + ".webp").width}
              height={imageSize("/assets/" + layer.photo + ".webp").height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </>
      ))}
    </div>

    <HeroQuizCard
      variant={markets ? "buy" : "sell"}
      node={node + ";1170:9441"}
    />
  </div>
</section>
