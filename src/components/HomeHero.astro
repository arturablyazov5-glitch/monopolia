---
import { siteText } from "../data/site-texts.mjs";
import RatingBadge from "./RatingBadge.astro";
import Button from "./Button.astro";
import TornSlash from "./TornSlash.astro";
import HeroTeam from "./HeroTeam.astro";
import heroCrossOut from "../../public/assets/catalog-old-price-strikethrough.svg?raw";
import "../styles/home-hero.css";
---

<section
  class="home-hero"
  aria-labelledby="hero-title"
  data-node-id="1380:4914"
>
  <img
    class="hero-background"
    src="/assets/home-background-no-plane.webp"
    alt=""
    width="1440"
    height="840"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />
  <div class="container hero-container">
    <div class="hero-header-space" aria-hidden="true"></div>
    <div class="hero-content" data-node-id="1380:4924">
      <div class="hero-title-block">
        <span class="hero-annotation" aria-hidden="true">
          {siteText("home-hero.text.1")}
        </span>
        <h1 id="hero-title">
          <span class="hero-title-first">
            <span class="sr-only">{siteText("home-hero.text.1")}</span>
            <span class="crossed-word" aria-hidden="true">
              {siteText("home-hero.text.2")}
              <span
                class="hero-cross-out"
                aria-hidden="true"
                set:html={heroCrossOut}
              />
            </span>{" "}
            {siteText("home-hero.text.3")}
          </span>
          <span class="hero-title-second">
            {siteText("home-hero.text.4")} <RatingBadge loading="eager" />
          </span>
        </h1>
      </div>
      <p class="hero-description">
        {siteText("home-hero.text.5")} <br />
        {siteText("home-hero.text.6")}
      </p>
    </div>
    <div class="hero-actions" data-node-id="1380:4955">
      <Button
        loading="eager"
        label={siteText("home-hero.label.8")}
        icon="sell"
        href="/sell/"
      />
      <TornSlash />
      <Button
        loading="eager"
        label={siteText("home-hero.label.7")}
        icon="buy"
        href="/buy/"
      />
    </div>
  </div>
  <HeroTeam />
  <div class="hero-paper-edge" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="/assets/background-paper-buyer-section-mobile-opaque.webp"
      />
      <img
        src="/assets/background-paper-buyer-section.webp"
        fetchpriority="low"
        alt=""
        width="1440"
        height="1325"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>
</section>
