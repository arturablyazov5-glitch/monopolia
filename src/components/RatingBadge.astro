---
interface Props {
  loading?: "eager" | "lazy";
  rating?: string;
}
import { traceLogo } from "../data/trace-logos";
const { rating = "5.0" } = Astro.props;
const gis = traceLogo("2gis");
const domclick = traceLogo("domclick");
---

<div class="rating" data-node-id="1380:4934">
  <span class="rating-map gis">
    <a class="rating-map-link" href={gis.href}>
      <img
        src={gis.src}
        alt={gis.alt}
        width="18"
        height="18"
        loading="lazy"
        decoding="async"
      />
    </a>
  </span>
  <span class="rating-map yandex" role="img" aria-label="Яндекс Карты">
    <img
      class="yandex-pin"
      src="/assets/0a94f.svg"
      alt=""
      width="10.08"
      height="12.6"
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
    <img
      class="yandex-dot"
      src="/assets/4bec0.svg"
      alt=""
      width="3.5379"
      height="3.5379"
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
  </span>
  <span class="rating-map">
    <a class="rating-map-link" href={domclick.href}>
      <img
        src={domclick.src}
        alt={domclick.alt}
        width="18"
        height="18"
        loading="lazy"
        decoding="async"
      />
    </a>
  </span>
  <b aria-label={`Рейтинг ${rating}`}>
    <img
      src="/assets/00e35.svg"
      alt=""
      width="12"
      height="12"
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
    {rating}
  </b>
</div>
