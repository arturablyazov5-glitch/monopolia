---
import PlayIcon from "./PlayIcon.astro";
interface Props {
  label?: string;
  video?: string;
  reviewIcon?: boolean;
}
const {
  label = "Воспроизвести видео",
  video,
  reviewIcon = false,
} = Astro.props;
---

<button
  type="button"
  class:list={["play", { "play-review-video": reviewIcon }]}
  aria-label={label}
  data-video={video ?? ""}
  aria-haspopup={video ? "dialog" : undefined}
  aria-controls={video ? "video-dialog" : undefined}
>
  {reviewIcon ? (
    <svg
      class="review-video-icon"
      width="75"
      height="78"
      viewBox="0 0 75 78"
      fill="none"
      aria-hidden="true"
    >
      <use href="#review-video-play" />
    </svg>
  ) : (
    <PlayIcon />
  )}
</button>
