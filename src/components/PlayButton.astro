---
import PlayIcon from "./PlayIcon.astro";
interface Props {
  label?: string;
  video?: string;

}
const { label = "Воспроизвести видео", video } = Astro.props;
---

<button
  type="button"
  class="play"
  aria-label={label}
  data-video={video ?? ""}
  aria-haspopup={video ? "dialog" : undefined}
  aria-controls={video ? "video-dialog" : undefined}
>
  <PlayIcon />
</button>
