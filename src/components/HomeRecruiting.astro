---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import Button from "./Button.astro";
import { socialUrls } from "../data/social-links";
import "../styles/home-recruiting.css";

const benefitColumns = [
  [
    siteText("home-recruiting.benefitcolumns.1"),
    siteText("home-recruiting.benefitcolumns.2"),
  ],
  [
    siteText("home-recruiting.benefitcolumns.3"),
    siteText("home-recruiting.benefitcolumns.4"),
  ],
];
---

<section
  data-surface="dark"
  id="careers"
  class="home-recruiting"
  aria-labelledby="recruiting-title"
  data-node-id="1380:5699"
>
  <img
    class="recruiting-union"
    src="/assets/recruiting-background.webp"
    alt=""
    width="1440"
    height="743"
    loading="lazy"
    decoding="async"
  />
  <div class="recruiting-photo">
    <img
      class="person-photo"
      src="/assets/recruiting-specialist-at-atm.webp"
      alt="Девушка облокотилась на банкомат"
      width="1440"
      height="743"
      loading="lazy"
      decoding="async"
    />
    <img
      class="recruiting-atm-screen"
      src="/assets/recruiting-atm-counting.svg"
      alt=""
      width="1024"
      height="602"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="recruiting-container">
    <div class="recruiting-copy">
      <div class="recruiting-main">
        <div class="recruiting-intro">
          <h2 id="recruiting-title">
            {siteText("home-recruiting.text.5")}
          </h2>
          <div class="recruiting-note-wrap">
            <Paper class="recruiting-note" tapeNode="I1380:5721;569:1388" node="1380:5721">
              <img
                src="/assets/recruiting-note-icon.svg"
                alt=""
                width="36"
                height="36"
                loading="lazy"
                decoding="async"
              />
              <p>
                <strong>{siteText("home-recruiting.text.6")}</strong> {siteText("home-recruiting.text.7")}
              </p>
            </Paper>
          </div>
        </div>
        <div class="recruiting-benefits column-grid-mobile column-divider column-divider--overlay column-divider--light">
          {benefitColumns.map((column) => (
            <ul class="recruiting-list bullet-list">
              {column.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <div class="recruiting-actions">
        <div class="recruiting-buttons">
          <Button popup="team" label={siteText("home-recruiting.label.8")} subject="Хочу в команду" />
          <a
            class="button white recruiting-channel"
            href={socialUrls.TelegramJobs}
            target="_blank"
            rel="noopener noreferrer"
          >
            {siteText("home-telegram.text.9")}
            <span class="recruiting-channel-icon">
              <img
                src="/assets/icon-external-link.svg"
                alt=""
                width="18"
                height="18"
                loading="lazy"
                decoding="async"
              />
            </span>
          </a>
        </div>
        <p class="recruiting-caption">
          {siteText("home-recruiting.text.9")}
        </p>
      </div>
    </div>
  </div>
  <div class="recruiting-edge recruiting-edge-top" aria-hidden="true">
    <picture>
      <source media="(max-width: 767px)" srcset="/assets/recruiting-top-edge-mobile.svg" />
      <img
        src="/assets/recruiting-speech-tail.svg"
        alt=""
        width="1480"
        height="288"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <div class="recruiting-edge recruiting-edge-bottom" aria-hidden="true">
    <img
      src="/assets/recruiting-paper-edge.svg"
      alt=""
      width="1480"
      height="288"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
