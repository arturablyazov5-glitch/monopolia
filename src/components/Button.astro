---
interface Props {
  loading?: "eager" | "lazy";
  label?: string;
  tone?: "red" | "black";
  icon?: boolean | "buy" | "sell" | "access";
  disabled?: boolean;
  type?: "button" | "submit";
  subject?: string;
  source?: string;
  href?: string;
}
const {
  label = "Оставить заявку",
  tone = "red",
  icon = false,
  disabled = false,
  type = "button",
  subject,
  source,
  href,
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["button", tone, { "with-icon": icon }]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  data-lead={
    !href && type === "button" && !disabled
      ? label.replaceAll("\u00a0", " ")
      : undefined
  }
  data-lead-source={
    !href && type === "button" && !disabled
      ? (
          source ||
          `${subject ? (/^Подбор ипотеки:/.test(subject) ? "Подбор ипотеки" : subject) + " · " : ""}Кнопка «${label}»`
        ).replaceAll("\u00a0", " ")
      : undefined
  }
  data-subject={href ? undefined : subject?.replaceAll("\u00a0", " ")}
  aria-haspopup={!href && type === "button" && !disabled ? "dialog" : undefined}
>
  {label}
  {icon && (
    <img
      src={
        icon === "buy"
          ? "/assets/f1336.svg"
          : icon === "access"
            ? "/assets/26881.svg"
            : "/assets/b6e69.svg"
      }
      width="16"
      height="16"
      alt=""
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
  )}
</Tag>
