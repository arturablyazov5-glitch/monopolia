---
import { siteText } from "../data/site-texts.mjs";
interface Props {
  loading?: "eager" | "lazy";
  label?: string;
  tone?: "red" | "black" | "white";
  icon?: boolean | "buy" | "sell" | "access";
  disabled?: boolean;
  type?: "button" | "submit";
  subject?: string;
  source?: string;
  quiz?: "buy" | "sell";
  popup?:
    | "callback"
    | "office"
    | "analysis"
    | "closed-base"
    | "service"
    | "team"
    | "mortgage"
    | "viewing"
    | "new-build";
  href?: string;
}
const {
  label = siteText("lead-form.buttonlabel.3"),
  tone = "red",
  icon = false,
  disabled = false,
  type = "button",
  subject,
  source,
  quiz,
  popup = quiz ? undefined : "callback",
  href,
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["button", tone, { "with-icon": icon }]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  data-lead={!href && type === "button" && !disabled ? label : undefined}
  data-lead-source={
    !href && type === "button" && !disabled
      ? (
          source ||
          `Кнопка «${label}»`
        ).replaceAll("\u00a0", " ")
      : undefined
  }
  data-lead-popup={!href && type === "button" && !disabled ? popup : undefined}
  data-quiz-dialog={!href && type === "button" && !disabled ? quiz : undefined}
  data-subject={href ? undefined : subject?.replaceAll("\u00a0", " ")}
  aria-haspopup={!href && type === "button" && !disabled ? "dialog" : undefined}
>
  {label}
  {icon && (
    <img
      src={
        icon === "buy"
          ? "/assets/icon-button-buy.svg"
          : icon === "access"
            ? "/assets/icon-button-access.svg"
            : "/assets/icon-button-sell.svg"
      }
      width="16"
      height="16"
      alt=""
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
  )}
</Tag>
