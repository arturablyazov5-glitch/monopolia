---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import "../styles/company-about.css";
import "../styles/company-office-frame.css";
import "../styles/text-rough.css";
const stats = [
  [siteText("company-about.stats.1"), siteText("company-about.stats.2"), siteText("company-about.stats.3")],
  ["5 000+", siteText("company-about.stats.4"), siteText("company-about.stats.5")],
  ["300", siteText("company-about.stats.6"), siteText("company-about.stats.7")],
];
---

<section
  data-surface="dark"
  class="company-about"
  aria-labelledby="company-title"
  data-node-id="1380:5237"
>
  <svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
    <filter id="rough-edge" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.5" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <div class="company-container">
    <div class="company-copy">
      <div class="company-intro">
        <h2 id="company-title">
          {siteText("company-about.text.10")} <br />
          {siteText("company-about.text.11")} <br />
          {siteText("company-about.text.12")}
        </h2>
        <p>
          {siteText("company-about.text.13")}
        </p>
      </div>
      <Paper class="company-recommendations" tapeNode="I1380:5258;569:1388">
        <img
          src="/assets/company-recommendations-icon.svg"
          width="36"
          height="36"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <p>
          {siteText("company-about.text.14")} <strong>{siteText("company-about.text.15")}</strong> {siteText("company-about.text.16")}
        </p>

      </Paper>
      <div class="company-stats">
        {stats.map(([value, first, second]) => (
          <div>
            <div class="company-number">
              <span class="text-rough">{value}</span>
              <i aria-hidden="true"></i>
            </div>
            <p>
              {first} <br />
              {second}
            </p>
          </div>
        ))}
      </div>
      <div class="company-download">
        <a class="button red" href="/files/company-presentation.pdf" download="company-presentation.pdf" target="_blank" rel="noopener">
          {siteText("company-about.text.17")}
        </a>
        <p>{siteText("company-about.text.18")}</p>
      </div>
    </div>
    <div class="company-office">
      <img
        class="company-office-photo"
        src="/assets/company-office-interior.webp"
        srcset="/assets/company-office-interior-mobile.webp 760w, /assets/company-office-interior.webp 1106w"
        sizes="(max-width: 767px) calc(100vw - 64px), 1106px"
        width="548"
        height="577"
        alt="Офис агентства Монополия в Белогорске"
        loading="lazy"
        decoding="async"
      />
      <div class="company-partners brush-stroke">
        <span class="company-superagent">
          <img
            src="/assets/company-about-note-icon.svg"
            width="18.667"
            height="18.667"
            alt=""
            loading="lazy"
            decoding="async"
          />
          {siteText("company-about.text.8")}
        </span>
        <span>и</span>
        <span class="company-avito">
          <img
            src="/assets/company-avito-icon.svg"
            width="13.333"
            height="28"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <span>{siteText("company-about.text.9")}</span>
          <img
            src="/assets/company-about-decor.svg"
            width="12"
            height="28"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
      </div>
    </div>
  </div>
</section>
