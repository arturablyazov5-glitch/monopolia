---
import { siteText } from "../data/site-texts.mjs";
import StaffCard from "./StaffCard.astro";
import Carousel from "./Carousel.astro";
import { staff } from "../data/staff";
import "../styles/home-team.css";
---

<section
  id="team"
  class="home-team"
  aria-labelledby="team-title"
  data-node-id="1380:5622"
>
  <picture style="display: contents">
    <source
      media="(max-width: 767px)"
      srcset="/assets/background-paper-team-section-mobile-opaque.webp"
    />
    <img
      class="team-paper-background"
      src="/assets/background-paper-team-section.webp"
      width="1440"
      height="2187.293"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="home-team-container">
    <h2 id="team-title">
      {siteText("home-team.text.1")} <br />
      <span class="team-heading-strike">
        {siteText("home-team.text.2")}
        <img
          src="/assets/team-heading-underline.svg"
          alt=""
          width="656.109375"
          height="16.671875"
          loading="lazy"
          decoding="async"
        />
      </span>{" "}
      <br />
      {siteText("home-team.text.3")}
    </h2>
    <p class="home-team-description">
      {siteText("home-team.text.4")}{" "}
      <strong>{siteText("home-team.text.5")}</strong>
    </p>
    <Carousel swipeHint label="Команда Монополии">
      {staff.map((person) => (
        <StaffCard
          person={person.id}
          name={person.name}
          role={person.role}
          badge={person.badge}
          badgeTextWidth={person.badgeTextWidth}
          facts={person.facts}
          certificate={person.certificate}
          image={person.image}
          variant={person.variant}
          photo={Boolean(person.image)}
        />
      ))}
    </Carousel>
  </div>
</section>

<script>
  const heading = document.querySelector<HTMLElement>("#team-title");
  const strike = heading?.querySelector<HTMLElement>(".team-heading-strike");
  if (heading && strike) {
    const mobile = matchMedia("(max-width: 767px)");
    const drawLines = () => {
      heading
        .querySelectorAll(".team-heading-line")
        .forEach((line) => line.remove());
      heading.classList.remove("has-team-heading-lines");
      if (!mobile.matches) return;

      const text = [...strike.childNodes].find(
        (node) => node.nodeType === Node.TEXT_NODE && node.textContent?.trim(),
      );
      if (!text) return;
      const range = document.createRange();
      range.selectNodeContents(text);
      const origin = heading.getBoundingClientRect();
      for (const rect of range.getClientRects()) {
        if (!rect.width) continue;
        const line = document.createElement("i");
        line.className = "team-heading-line";
        line.setAttribute("aria-hidden", "true");
        line.style.left = `${rect.left - origin.left}px`;
        line.style.top = `${rect.top + rect.height * 0.55 - origin.top}px`;
        line.style.width = `${rect.width}px`;
        heading.append(line);
      }
      heading.classList.toggle(
        "has-team-heading-lines",
        !!heading.querySelector(".team-heading-line"),
      );
    };
    new ResizeObserver(drawLines).observe(heading);
    new MutationObserver(drawLines).observe(strike, {
      childList: true,
      characterData: true,
      subtree: true,
    });
    mobile.addEventListener("change", drawLines);
    void document.fonts.ready.then(drawLines);
  }
</script>
