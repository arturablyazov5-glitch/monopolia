---
import { siteText } from "../data/site-texts.mjs";
import SocialLinks from "./SocialLinks.astro";
interface Props {
  lines?: string[];
}
const { lines = [siteText("lead-form.text.7"), siteText("lead-form.text.8")] } =
  Astro.props;
---

<div class="form-social">
  <span>
    {lines.map((line, index) => (
      <>
        {index > 0 && <br />}
        {line}
      </>
    ))}
  </span>
  <SocialLinks />
</div>

<style>
  .form-social {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-muted);
    font: var(--text-small)/1.2 var(--font-body);
  }
  .form-social > span {
    min-width: 0;
  }
  .form-social :global(.socials) {
    flex-shrink: 0;
  }
</style>
