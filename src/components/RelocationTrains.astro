---
import {
  relocationRoutes,
  relocationTrainAnimations,
} from "../data/relocation-routes";
interface Route {
  src: string;
  left: number;
  top: number;
}
interface Props {
  routes: Route[];
  mobile?: boolean;
}
const { routes, mobile = false } = Astro.props;
const trainWidth = 32.6049 * (mobile ? 3 : 1);
const trainHeight = 26.2172 * (mobile ? 3 : 1);
---

<svg
  class:list={["relocation-trains", { "relocation-trains--mobile": mobile }]}
  viewBox="0 0 1160 570"
  width="1160"
  height="570"
  aria-hidden="true"
>
  {routes.map((route) => {
    const animation = relocationTrainAnimations[route.src];
    // Направление и фаза принадлежат маршруту, а не порядку слоев.
    const backwards = animation.reverse;
    const trainDuration = `${animation.durationSeconds}s`;
    const trainBegin = `${animation.beginSeconds}s`;
    const coordinates = relocationRoutes[route.src]
      .slice(1)
      .split(" L")
      .map((point) => point.split(" ").map(Number));
    if (mobile) {
      // Координаты пина и ближайших к нему концов маршрутов на карте 1160 × 570.
      const pinX = 711.5;
      const pinY = 335;
      // Контур метки в системе координат карты; зазор одинаков по всем сторонам.
      const outline = [
        [0, -36],
        [18, -31.2],
        [31.2, -18],
        [36, 0],
        [33, 17],
        [24, 30],
        [14, 43],
        [5, 60],
        [0, 63.3],
        [-5, 60],
        [-14, 43],
        [-24, 30],
        [-33, 17],
        [-36, 0],
        [-31.2, -18],
        [-18, -31.2],
      ];
      const distanceToPin = ([x, y]: number[]) => {
        const px = x + route.left - pinX;
        const py = y + route.top - pinY;
        let inside = false;
        for (let i = 0, j = outline.length - 1; i < outline.length; j = i++) {
          const [ax, ay] = outline[i];
          const [bx, by] = outline[j];
          if (
            ay > py !== by > py &&
            px < ((bx - ax) * (py - ay)) / (by - ay) + ax
          )
            inside = !inside;
        }
        if (inside) return 0;
        return Math.min(
          ...outline.map(([ax, ay], i) => {
            const [bx, by] = outline[(i + 1) % outline.length];
            const dx = bx - ax;
            const dy = by - ay;
            const t = Math.max(
              0,
              Math.min(
                1,
                ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy),
              ),
            );
            return Math.hypot(px - ax - t * dx, py - ay - t * dy);
          }),
        );
      };
      const gap = 20;
      const last = coordinates.length - 1;
      const startsNearPin =
        distanceToPin(coordinates[0]) < distanceToPin(coordinates[last]);
      // Обрезаем исходную кривую у пина вместо изгиба первых точек.
      if (!startsNearPin) coordinates.reverse();
      while (coordinates.length > 2 && distanceToPin(coordinates[1]) < gap) {
        coordinates.shift();
      }
      const inside = coordinates[0];
      const outside = coordinates[1];
      let low = 0;
      let high = 1;
      for (let step = 0; step < 24; step++) {
        const t = (low + high) / 2;
        const point = inside.map(
          (value, axis) => value + (outside[axis] - value) * t,
        );
        if (distanceToPin(point) < gap) low = t;
        else high = t;
      }
      coordinates[0] = inside.map(
        (value, axis) => value + (outside[axis] - value) * high,
      );
      if (!startsNearPin) coordinates.reverse();
    }

    if (backwards) coordinates.reverse();
    const [endX, endY] = coordinates[coordinates.length - 1];
    const [prevX, prevY] = coordinates[coordinates.length - 2];
    const angle = (Math.atan2(endY - prevY, endX - prevX) * 180) / Math.PI;
    const arrowTransform = `translate(${endX} ${endY}) rotate(${angle})`;
    const path = `M${coordinates.map((point) => point.join(" ")).join(" L")}`;
    // Пунктир заканчивается у основания стрелки, не просвечивая у острия.
    const lineCoordinates = coordinates.map((point) => [...point]);
    let arrowLength = 8;
    while (lineCoordinates.length > 1) {
      const end = lineCoordinates[lineCoordinates.length - 1];
      const previous = lineCoordinates[lineCoordinates.length - 2];
      const segmentLength = Math.hypot(
        end[0] - previous[0],
        end[1] - previous[1],
      );
      if (segmentLength <= arrowLength) {
        arrowLength -= segmentLength;
        lineCoordinates.pop();
      } else {
        lineCoordinates[lineCoordinates.length - 1] = end.map(
          (value, axis) =>
            value + ((previous[axis] - value) * arrowLength) / segmentLength,
        );
        break;
      }
    }
    const linePath = `M${lineCoordinates.map((point) => point.join(" ")).join(" L")}`;
    const lengths = [0];
    for (let i = 1; i < coordinates.length; i++) {
      lengths.push(
        lengths[i - 1] +
          Math.hypot(
            coordinates[i][0] - coordinates[i - 1][0],
            coordinates[i][1] - coordinates[i - 1][1],
          ),
      );
    }
    const duration = lengths[lengths.length - 1];
    const flips = coordinates
      .slice(0, -1)
      .map((point, i) => (coordinates[i + 1][0] < point[0] ? "1 1" : "1 -1"));
    flips.push(flips[flips.length - 1]);
    const keyTimes = lengths.map((length) => length / duration).join(";");
    return (
      <g transform={`translate(${route.left} ${route.top})`}>
        {mobile && (
          <path
            d={linePath}
            fill="none"
            stroke="var(--color-ink)"
            stroke-opacity="0.5"
            stroke-width="1"
            stroke-dasharray="4 4"
            stroke-linecap="round"
          />
        )}
        {mobile && (
          <path
            d="M-8 -4 L0 0 L-8 4 Z"
            fill="color-mix(in srgb, var(--color-muted) 50%, var(--color-caption))"
            transform={arrowTransform}
          />
        )}
        <g class="relocation-train" data-route={route.src}>
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.025;0.975;1"
            dur={trainDuration}
            begin={trainBegin}
            repeatCount="indefinite"
          />
          <image
            href="/assets/relocation-train-transparent.svg"
            x={-trainWidth / 2}
            y={-trainHeight / 2}
            width={trainWidth}
            height={trainHeight}
            transform={`scale(${flips[0]})`}
          >
            <animateTransform
              attributeName="transform"
              type="scale"
              values={flips.join(";")}
              keyTimes={keyTimes}
              calcMode="discrete"
              dur={trainDuration}
              begin={trainBegin}
              repeatCount="indefinite"
            />
          </image>
          <animateMotion
            path={path}
            dur={trainDuration}
            begin={trainBegin}
            repeatCount="indefinite"
            rotate="auto"
            calcMode="paced"
          />
        </g>
      </g>
    );
  })}
</svg>
