---
import {
  relocationRoutes,
  relocationTrainAnimations,
} from "../data/relocation-routes";
interface Route {
  src: string;
  left: number;
  top: number;
}
interface Props {
  routes: Route[];
  mobile?: boolean;
}
const { routes, mobile = false } = Astro.props;
const trainWidth = 32.6049 * (mobile ? 1.5 : 1);
const trainHeight = 26.2172 * (mobile ? 1.5 : 1);
---

<svg
  class:list={["relocation-trains", { "relocation-trains--mobile": mobile }]}
  viewBox="0 0 1160 570"
  width="1160"
  height="570"
  aria-hidden="true"
>
  {routes.map((route) => {
    const animation = relocationTrainAnimations[route.src];
    // Направление и фаза принадлежат маршруту, а не порядку слоев.
    const backwards = animation.reverse;
    const trainDuration = `${animation.durationSeconds}s`;
    const trainBegin = `${animation.beginSeconds}s`;
    const coordinates = relocationRoutes[route.src]
      .slice(1)
      .split(" L")
      .map((point) => point.split(" ").map(Number));
    if (mobile) {
      // Координаты пина и ближайших к нему концов маршрутов на карте 1160 × 570.
      const pinX = 711.5;
      const pinY = 335;
      const distanceToPin = ([x, y]: number[]) =>
        Math.hypot(x + route.left - pinX, y + route.top - pinY);
      const last = coordinates.length - 1;
      const startsNearPin = distanceToPin(coordinates[0]) < distanceToPin(coordinates[last]);
      const [x, y] = coordinates[startsNearPin ? 0 : last];
      const dx = x + route.left - pinX;
      const dy = y + route.top - pinY;
      const [tipX, tipY] = Math.abs(dx) > Math.abs(dy)
        ? [pinX + Math.sign(dx) * 33, pinY]
        : [pinX, dy < 0 ? 294 : 374];
      const offsetX = tipX - route.left - x;
      const offsetY = tipY - route.top - y;
      // Выравниваем зазор у пина, сохраняя остальной маршрут.
      for (let i = 0; i < 6; i++) {
        const point = coordinates[startsNearPin ? i : last - i];
        const weight = ((6 - i) / 6) ** 2;
        point[0] += offsetX * weight;
        point[1] += offsetY * weight;
      }
    }
    if (backwards) coordinates.reverse();
    const [endX, endY] = coordinates[coordinates.length - 1];
    const [prevX, prevY] = coordinates[coordinates.length - 2];
    const angle = Math.atan2(endY - prevY, endX - prevX) * 180 / Math.PI;
    const arrowTransform = `translate(${endX} ${endY}) rotate(${angle})`;
    const path = `M${coordinates.map((point) => point.join(" ")).join(" L")}`;
    const lengths = [0];
    for (let i = 1; i < coordinates.length; i++) {
      lengths.push(
        lengths[i - 1] +
          Math.hypot(
            coordinates[i][0] - coordinates[i - 1][0],
            coordinates[i][1] - coordinates[i - 1][1],
          ),
      );
    }
    const duration = lengths[lengths.length - 1];
    const flips = coordinates
      .slice(0, -1)
      .map((point, i) => (coordinates[i + 1][0] < point[0] ? "1 1" : "1 -1"));
    flips.push(flips[flips.length - 1]);
    const keyTimes = lengths.map((length) => length / duration).join(";");
    return (
      <g transform={`translate(${route.left} ${route.top})`}>
        {mobile && (
          <path
            d={path}
            fill="none"
            stroke="#1a1a1a"
            stroke-opacity="0.5"
            stroke-width="1"
            stroke-dasharray="4 4"
            stroke-linecap="round"
          />
        )}
        {mobile && (
          <path d="M-8 -4 L0 0 L-8 4 Z" fill="#777" transform={arrowTransform} />
        )}
        <g class="relocation-train" data-route={route.src}>
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.025;0.975;1"
            dur={trainDuration}
            begin={trainBegin}
            repeatCount="indefinite"
          />
          <image
            href="/assets/relocation-train-transparent.svg"
            x={-trainWidth / 2}
            y={-trainHeight / 2}
            width={trainWidth}
            height={trainHeight}
            transform={`scale(${flips[0]})`}
          >
            <animateTransform
              attributeName="transform"
              type="scale"
              values={flips.join(";")}
              keyTimes={keyTimes}
              calcMode="discrete"
              dur={trainDuration}
              begin={trainBegin}
              repeatCount="indefinite"
            />
          </image>
          <animateMotion
            path={path}
            dur={trainDuration}
            begin={trainBegin}
            repeatCount="indefinite"
            rotate="auto"
            calcMode="paced"
          />
        </g>
      </g>
    );
  })}
</svg>
