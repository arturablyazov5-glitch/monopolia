---
import { siteText } from "../data/site-texts.mjs";
import { phone } from "../data/contacts";
// Figma 1380:6462: 800+ эксклюзивных объектов, карточка проверки,
// кнопка доступа и окно Safari 1380:6483 с превью закрытой базы.
import { currentMonth } from "../scripts/calendar.mjs";
import Paper from "./Paper.astro";
import Badge from "./Badge.astro";
import BadgeGroup from "./BadgeGroup.astro";
import Button from "./Button.astro";
import "../styles/buy-closed-base.css";
import { selectPreview } from "../lib/catalog";
import "../styles/property-media.css";

const checks = [
  siteText("private-catalog.checks.1"),
  siteText("private-catalog.checks.2"),
  siteText("private-catalog.checks.3"),
  siteText("private-catalog.checks.4"),
  siteText("private-catalog.checks.5"),
  siteText("private-catalog.checks.6"),
  siteText("private-catalog.checks.7"),
  siteText("private-catalog.checks.8"),
  siteText("private-catalog.checks.9"),
];
// Примеры из публичных объявлений агентства для иллюстрации закрытой базы.
const listings = selectPreview();
---

<section
  class="buy-closed-base"
  aria-labelledby="buy-closed-base-title"
  data-node-id="1380:6462"
>
  <div class="buy-closed-base-container">
    <div class="buy-closed-base-copy" data-node-id="1380:6463">
      <h2 id="buy-closed-base-title" class="buy-closed-base-title">
        <span class="buy-closed-base-title-row">
          <span class="buy-closed-base-hand">800+</span>
          {siteText("buy-closed-base.text.1")}
        </span>
        <span>
          за <span data-current-month>{currentMonth()}</span> в закрытой базе
          <script is:inline>
            {
              const el = document.currentScript.previousElementSibling;
              el.textContent = new Intl.DateTimeFormat("ru-RU", {
                month: "long",
                timeZone: "Asia/Yakutsk",
              }).format(new Date());
              document.currentScript.remove();
            }
          </script>
        </span>
      </h2>
      <div class="buy-closed-base-card-wrap">
        <Paper
          class="buy-closed-base-card"
          tapeNode="I1380:6480;569:1388"
          node="1380:6480"
        >
          <p>
            {siteText("buy-closed-base.text.3")}{" "}
            <strong>{siteText("buy-closed-base.text.4")}</strong> <br />
            {siteText("private-catalog.text.18")}
          </p>
          <BadgeGroup class="buy-closed-base-checks">
            {checks.map((text, index) => (
              <Badge
                text={text}
                angle={[-1, 1, -1, -2, 2, 2, -0.5, -1, 2][index]}
                mobileOrder={[0, 0, 0, 1, 1, 0, 2, 3, 3][index]}
              />
            ))}
          </BadgeGroup>
        </Paper>
      </div>
      <Button
        popup="closed-base"
        label={siteText("private-catalog.label.19")}
        subject="Доступ к закрытой базе недвижимости"
      />
    </div>

    <!-- 1380:6482 Vector 318 — исходная векторная тень окна -->
    <picture style="display: contents">
      <source
        style="display: none"
        media="(max-width: 1199px)"
        srcset="/assets/mobile-empty.webp"
      />
      <img
        class="buy-closed-base-shadow"
        src="/assets/buy-catalog-booklet-shadow.svg"
        alt=""
        width="735.144"
        height="600.437"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <!-- 1380:6483 Safari Light — иллюстрация закрытой базы, не интерактивна -->
    <div
      class="buy-safari"
      role="img"
      aria-label="Превью закрытой базы объектов monopoly‑base.ru в окне браузера"
      data-node-id="1380:6483"
    >
      <div class="buy-safari-toolbar" aria-hidden="true">
        <div class="buy-safari-left">
          <img class="buy-safari-lights" src="/assets/catalog-browser-window-lights.svg" alt="" width="31" height="13" />
          <img class="buy-safari-controls" src="/assets/catalog-browser-navigation.svg" alt="" width="54" height="15" />
        </div>
        <span class="buy-safari-search">
          <img src="/assets/catalog-browser-page-options.svg" alt="" width="7" height="7" />
          <span class="buy-safari-url">monopoly‑base.ru</span>
          <img src="/assets/catalog-browser-reload.svg" alt="" width="5" height="6" />
        </span>
        <div class="buy-safari-right">
          <img class="buy-safari-actions" src="/assets/catalog-browser-toolbar-actions.svg" alt="" width="55" height="15" />
        </div>
      </div>

      <div class="buy-safari-page">
        <div class="buy-safari-header">
          <span class="buy-safari-brand">
            <img
              src="/assets/catalog-browser-decor.svg"
              alt=""
              width="14.1924"
              height="14.1924"
              loading="lazy"
              decoding="async"
            />
            <span class="buy-safari-brand-text">
              <img
                src="/assets/logo-monopoly-wordmark-browser.svg"
                alt=""
                width="58.1002"
                height="5.75175"
                loading="lazy"
                decoding="async"
              />
              <span>{siteText("site-header.text.4")}</span>
            </span>
          </span>
          <span class="buy-safari-nav">
            <span>{siteText("site-header.label.1")}</span>
            <span>{siteText("site-header.label.2")}</span>
            <span class="buy-safari-nav-base">
              {siteText("buy-closed-base.text.5")}
              <img
                src="/assets/catalog-browser-nav-dot.svg"
                alt=""
                width="2.21756"
                height="2.21756"
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
          <span class="buy-safari-contacts">
            <span class="buy-safari-contact-main">
              <span class="buy-safari-socials">
                <span class="buy-safari-icon">
                  <img
                    class="telegram"
                    src="/assets/catalog-browser-telegram-icon.svg"
                    alt=""
                    width="15.962"
                    height="15.7358"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="buy-safari-icon">
                  <img
                    class="max"
                    src="/assets/catalog-browser-max-icon.svg"
                    alt=""
                    width="14.9411"
                    height="15.4192"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </span>
              <span class="buy-safari-phone">
                <b>{phone.display}</b>
                <span class="buy-safari-status">
                  <i></i>
                  {siteText("buy-closed-base.text.6")}
                </span>
              </span>
            </span>
            <span class="buy-safari-icon">
              <img
                class="menu"
                src="/assets/catalog-browser-menu-icon.svg"
                alt=""
                width="15.6898"
                height="16.6459"
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
        </div>

        {listings.map((listing) => (
          <div class="buy-safari-listing">
            <div class="buy-safari-photo">
              <img
                src={listing.image}
                alt=""
                width={listing.photo.width}
                height={listing.photo.height}
                loading="lazy"
                decoding="async"
              />
              <span class="buy-safari-prices">
                {listing.illustrativeOldPrice && (
                  <span class="buy-safari-old-price" title="Условная старая цена для иллюстрации">
                    <span>
                      {listing.illustrativeOldPrice}
                      <img
                        src="/assets/catalog-old-price-strikethrough.svg"
                        alt=""
                        width="69.6587"
                        height="42.9098"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  </span>
                )}
                <span class="buy-safari-price">{listing.price}</span>
              </span>
            </div>
            <span class="buy-safari-caption">
              <b>{listing.title}</b>
              <span>{listing.caption}</span>
            </span>
          </div>
        ))}

        <span class="buy-safari-more">
          {siteText("buy-closed-base.text.7")}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { currentMonth } from "../scripts/calendar.mjs";
  const updateMonth = () =>
    document
      .querySelectorAll("[data-current-month]")
      .forEach((el) => (el.textContent = currentMonth()));
  document.addEventListener("visibilitychange", updateMonth);
  setInterval(updateMonth, 60 * 60 * 1000);
</script>
