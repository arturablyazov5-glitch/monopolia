---
import { siteText } from "../data/site-texts.mjs";
// Figma 1380:6462: 800+ эксклюзивных объектов, карточка проверки,
// кнопка доступа и окно Safari 1380:6483 с превью закрытой базы.
import { currentMonth } from "../scripts/calendar.mjs";
import Paper from "./Paper.astro";
import Badge from "./Badge.astro";
import BadgeGroup from "./BadgeGroup.astro";
import Button from "./Button.astro";
import "../styles/buy-closed-base.css";
import ClosedBasePreview from "./ClosedBasePreview.astro";
import "../styles/property-media.css";

const checks = [
  siteText("private-catalog.checks.1"),
  siteText("private-catalog.checks.2"),
  siteText("private-catalog.checks.3"),
  siteText("private-catalog.checks.4"),
  siteText("private-catalog.checks.5"),
  siteText("private-catalog.checks.6"),
  siteText("private-catalog.checks.7"),
  siteText("private-catalog.checks.8"),
  siteText("private-catalog.checks.9"),
];
---

<section
  class="buy-closed-base"
  aria-labelledby="buy-closed-base-title"
  data-node-id="1380:6462"
>
  <div class="buy-closed-base-container">
    <div class="buy-closed-base-copy" data-node-id="1380:6463">
      <h2 id="buy-closed-base-title" class="buy-closed-base-title">
        <span class="buy-closed-base-title-row">
          <span class="buy-closed-base-hand">800+</span>
          {siteText("buy-closed-base.text.1")}
        </span>
        <span>
          за <span data-current-month>{currentMonth()}</span> в закрытой базе
          <script is:inline>
            {
              const el = document.currentScript.previousElementSibling;
              el.textContent = new Intl.DateTimeFormat("ru-RU", {
                month: "long",
                timeZone: "Asia/Yakutsk",
              }).format(new Date());
              document.currentScript.remove();
            }
          </script>
        </span>
      </h2>
      <div class="buy-closed-base-card-wrap">
        <Paper
          class="buy-closed-base-card"
          tapeNode="I1380:6480;569:1388"
          node="1380:6480"
        >
          <p>
            {siteText("buy-closed-base.text.3")}{" "}
            <strong>{siteText("buy-closed-base.text.4")}</strong> <br />
            {siteText("private-catalog.text.18")}
          </p>
          <BadgeGroup class="buy-closed-base-checks">
            {checks.map((text, index) => (
              <Badge
                text={text}
                angle={[-1, 1, -1, -2, 2, 2, -0.5, -1, 2][index]}
                mobileOrder={[0, 0, 0, 1, 1, 0, 2, 3, 3][index]}
              />
            ))}
          </BadgeGroup>
        </Paper>
      </div>
      <Button
        popup="closed-base"
        label={siteText("private-catalog.label.19")}
        subject="Доступ к закрытой базе недвижимости"
      />
    </div>

    <!-- 1380:6482 Vector 318 — исходная векторная тень окна -->
    <picture style="display: contents">
      <source
        style="display: none"
        media="(max-width: 1199px)"
        srcset="/assets/mobile-empty.webp"
      />
      <img
        class="buy-closed-base-shadow"
        src="/assets/buy-catalog-booklet-shadow.svg"
        alt=""
        width="735.144"
        height="600.437"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <!-- 1380:6483 Safari Light — иллюстрация закрытой базы, не интерактивна -->
    <ClosedBasePreview />
  </div>
</section>

<script>
  import { currentMonth } from "../scripts/calendar.mjs";
  const updateMonth = () =>
    document
      .querySelectorAll("[data-current-month]")
      .forEach((el) => (el.textContent = currentMonth()));
  document.addEventListener("visibilitychange", updateMonth);
  setInterval(
    () => {
      if (!document.hidden) updateMonth();
    },
    60 * 60 * 1000,
  );
</script>
