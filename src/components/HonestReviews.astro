---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import "../styles/honest-reviews.css";
---

<section
  class="honest-reviews"
  aria-labelledby="honest-reviews-title"
  data-node-id="1380:5131"
>
  <div class="honest-reviews-background">
    <img
      src="/assets/honest-reviews-boxing-specialist.webp"
      width="1440"
      height="926"
      alt="Сотрудница Монополии в боксерских перчатках"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="honest-reviews-scene">
    <div class="honest-reviews-copy">
      <h2 id="honest-reviews-title">
        <span class="honest-reviews-muted">
          {siteText("honest-reviews.text.1")} <br />
          {siteText("honest-reviews.text.2")}
        </span>{" "}
        <br />
        {siteText("honest-reviews.text.3")} <br />
        <span class="honest-reviews-last">
          {siteText("honest-reviews.text.4")}{" "}
          <span class="honest-reviews-delete" aria-hidden="true">
            <img
              src="/assets/honest-reviews-background.svg"
              width="20"
              height="20"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </span>
        </span>
      </h2>
      <Paper class="honest-reviews-note" tapeNode="I1380:5150;569:1388" node="1380:5150">
        <img
          src="/assets/honest-reviews-person-shadow.svg"
          width="36"
          height="36"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <p>
          {siteText("honest-reviews.text.5")} <strong>{siteText("honest-reviews.text.6")}</strong>{siteText("honest-reviews.text.7")}
        </p>
      </Paper>
    </div>
    <img
      class="honest-reviews-broken"
      src="/assets/honest-reviews-fake-review-card.webp"
      srcset="/assets/honest-reviews-fake-review-card-mobile.webp 760w, /assets/honest-reviews-fake-review-card.webp 987w"
      sizes="(max-width: 767px) min(380px, 100vw - 40px), 987px"
      width="537"
      height="498"
      alt="Разбитая карточка заказного отзыва"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
