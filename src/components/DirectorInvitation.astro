---
import { people } from "../data/people.mjs";
import { siteText } from "../data/site-texts.mjs";
import Button from "./Button.astro";
import Paper from "./Paper.astro";
import TapedNote from "./TapedNote.astro";
import PersonLabel from "./PersonLabel.astro";
import ExpertProfile from "./ExpertProfile.astro";
import { traceLogo } from "../data/trace-logos";
import "../styles/director-invitation.css";
const domclick = traceLogo("domclick-full");
const ratingText = siteText("director-invitation.text.5");
const ratingParts = ratingText.split("Домклик");
---

<section
  data-surface="dark"
  class="director-invitation"
  aria-labelledby="director-title"
  data-node-id="1380:5573"
>
  <Paper class="director-frame paper-frame paper-frame-deep">
    <Paper class="director-card paper-white">
      <div class="director-copy">
        <img
          class="director-quote"
          src="/assets/director-quote-mark.svg"
          alt=""
          width="40.6347"
          height="31.2264"
          loading="lazy"
          decoding="async"
        />
        <h2 id="director-title">
          {siteText("director-invitation.text.1")} <span>3 000+</span> <br />
          {siteText("director-invitation.text.2")} <br />
          {siteText("director-invitation.text.3")}
        </h2>
        <ExpertProfile
          {...people["elena-sidelina"]}
          src="/assets/staff-elena-sidelina-mobile.webp"
        />
        <div class="director-bio">
          <div class="director-intro">
            <p>
              {siteText("director-invitation.text.4")}{" "}
              <strong class="director-rating-desktop">{ratingText}</strong>
              <strong class="director-rating-mobile">
                {ratingParts.length === 2 ? (
                  <>
                    {ratingParts[0]}
                    <a href={domclick.href} class="director-inline-logo">
                      <img
                        src={domclick.src}
                        alt="Домклик"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                    {ratingParts[1]}
                  </>
                ) : (
                  ratingText
                )}
              </strong>
            </p>
            <a href={domclick.href}>
              <img
                src={domclick.src}
                width="110.249"
                height="23.815"
                alt={domclick.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
          <p>{siteText("director-invitation.text.6")}</p>
        </div>
        <TapedNote
          class="director-coffee-note"
          variant="card"
          textured
          tapeNode="I1380:5590;569:1388"
          icon={{ src: "/assets/director-coffee-note-icon.svg", width: 36, height: 36 }}
        >
          {siteText("director-invitation.text.7")}{" "}
          <strong>{siteText("director-invitation.text.8")}</strong>
        </TapedNote>
        <div class="director-cta">
          <Button
            popup="office"
            label={siteText("director-invitation.label.9")}
            subject="Консультация в офисе за кофе"
          />
          <p>{siteText("director-invitation.text.10")}</p>
        </div>
      </div>
      <div class="director-photo">
        <img
          class="director-shadow"
          src="/assets/staff-elena-sidelina-shadow.svg"
          alt=""
          width="615.109"
          height="675.277"
          loading="lazy"
          decoding="async"
        />
        <img
          class="director-portrait person-photo"
          src="/assets/staff-elena-sidelina.webp"
          srcset="/assets/staff-elena-sidelina-mobile.webp 1450w, /assets/staff-elena-sidelina.webp 2336w"
          sizes="(max-width: 767px) 723px, 2336px"
          alt={people["elena-sidelina"].name}
          loading="lazy"
          width="2336"
          height="3504"
          decoding="async"
        />
        <PersonLabel
          class="director-signature"
          {...people["elena-sidelina"]}
        />
      </div>
    </Paper>
  </Paper>
</section>
