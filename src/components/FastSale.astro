---
import { siteText } from "../data/site-texts.mjs";
import Button from "./Button.astro";
import Paper from "./Paper.astro";
import PersonLabel from "./PersonLabel.astro";
import "../styles/fast-sale.css";
---

<section
  class="fast-sale"
  aria-labelledby="fast-sale-title"
  data-node-id="1380:4975"
>
  <img
    class="fast-sale-background"
    src="/assets/background-paper-buyer-section.webp"
    fetchpriority="low"
    alt=""
    width="1440"
    height="1325"
    loading="eager"
    decoding="async"
  />
  <div class="fast-sale-scene">
    <div class="fast-sale-copy">
      <h2 id="fast-sale-title">
        {siteText("fast-sale.text.1")} <br />
        {siteText("fast-sale.text.2")} <span class="fast-sale-time">{siteText("fast-sale.text.3")}</span> <br />
        <span class="fast-sale-muted">
          {siteText("fast-sale.text.4")} <br />
          {siteText("fast-sale.text.5")}
        </span>
      </h2>
      <Paper class="fast-sale-note" tapeNode="1380:4982" node="1380:4982">
        <img
          src="/assets/fast-sale-note-icon.svg"
          width="36"
          height="36"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <p>
          {siteText("fast-sale.text.6")} <br />
          {siteText("fast-sale.text.7")} <strong>{siteText("fast-sale.text.8")}</strong>
        </p>
      </Paper>
      <Button
        label={siteText("buyer-audience.label.10")}
        icon="sell"
        href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/sell/`}
      />
    </div>
    <div class="fast-sale-visual">
      <img
        class="fast-sale-shadow"
        src="/assets/fast-sale-person-shadow.svg"
        alt=""
        width="447.463"
        height="580.875"
        loading="lazy"
        decoding="async"
      />
      <img
        class="fast-sale-portrait person-photo"
        src="/assets/staff-pavel-barkovsky-fast-sale.webp"
        width="828"
        height="552"
        alt="Павел Барковский на фоне проданного объекта"
        loading="lazy"
        decoding="async"
      />
      <PersonLabel
        class="fast-sale-name"
        node="1380:5008"
        name="Павел Барковский"
        role="Старший специалист по недвижимости"
      />
    </div>
  </div>
  <!-- Figma 1380:5009: рваный край #EDEDED поверх низа фото -->
  <img
    class="fast-sale-edge"
    src="/assets/background-paper-edge-white.svg"
    width="1440"
    height="80"
    alt=""
    loading="lazy"
    decoding="async"
  />
</section>
