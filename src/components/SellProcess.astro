---
import { siteText } from "../data/site-texts.mjs";
// Figma 1380:5932: карта, 11 шагов и сравнение способов продажи.
import RelocationMap from "./RelocationMap.astro";
import DealSteps from "./DealSteps.astro";
import RealtorComparison from "./RealtorComparison.astro";
import { sellDealSteps } from "../data/sell-deal-steps";
import { sellRealtorComparison } from "../data/sell-realtor-comparison";
import "../styles/sell-process.css";

const layers = [
  { src: "/assets/relocation-belogorsk-pin.svg", width: 29, height: 40, left: 697, top: 319.762 },
  {
    src: "/assets/relocation-route-west-sell-alternate.svg",
    width: 556,
    height: 160.994,
    left: 158,
    top: 373.01,
  },
  {
    src: "/assets/relocation-route-central-sell.svg",
    width: 686,
    height: 184.074,
    left: -7,
    top: 153.936,
  },
  {
    src: "/assets/relocation-route-west-sell.svg",
    width: 374.464,
    height: 353.86,
    left: 710.433,
    top: -43.849,
  },
  {
    src: "/assets/relocation-route-east-sell.svg",
    width: 401.938,
    height: 191.843,
    left: 740,
    top: 284.655,
  },
  {
    src: "/assets/relocation-plane-arrow-sell.svg",
    width: 32.6049,
    height: 26.2172,
    left: 538.0,
    top: 497.0,
    rotate: 168.93,
  },
  {
    src: "/assets/relocation-plane-arrow-sell.svg",
    width: 32.6049,
    height: 26.2172,
    left: 449.84,
    top: 246.16,
    rotate: -156.4096,
  },
  {
    src: "/assets/relocation-plane-arrow.svg",
    width: 32.6049,
    height: 26.2172,
    left: 976.55,
    top: 162.54,
    rotate: -15.88,
    flipY: true,
  },
  {
    src: "/assets/relocation-plane-arrow-small.svg",
    width: 32.6049,
    height: 26.2172,
    left: 1020.205,
    top: 282.4,
    rotate: 32.35,
    flipY: true,
  },
];
---

<RelocationMap
  id="sell-relocation"
  class="sell-relocation"
  node="1380:5933"
  title={siteText("sell-process.title.1")}
  annotation="Меньше народа — больше кислорода"
  description={siteText("sell-process.description.2")}
  map={{
    src: "/assets/relocation-map-sell.svg",
    width: 5386.13,
    height: 3035.38,
    fade: "linear-gradient(178.472deg, var(--color-canvas) 825px, rgb(from var(--color-canvas) r g b / 0.0%) 2594px)",
  }}
  layers={layers}
/>
<DealSteps
  id="sell-steps"
  class="sell-steps"
  steps={sellDealSteps}
  node="1380:6182"
/>
<RealtorComparison
  id="sell-realtor"
  class="sell-realtor"
  node="1380:6296"
  rows={sellRealtorComparison}
  icons={["/assets/icon-comparison-cross-sell.svg", "/assets/icon-comparison-check-sell.svg"]}
  subject="Консультация: продажа с риелтором"
  showStatement={false}
  background={{ src: "/assets/sell-realtor-comparison-background.webp", width: 1440, height: 1262.004 }}
/>
