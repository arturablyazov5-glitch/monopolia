---
import { siteText } from "../data/site-texts.mjs";
// Figma 1380:6364: фон 1380:6365 + блок «02» (ипотека, 1380:6370)
// и блок «03» (объекты ниже рынка, 1380:6444) на странице «Покупка».
import Paper from "./Paper.astro";
import Button from "./Button.astro";
import NumberedBenefit from "./NumberedBenefit.astro";
import PartnerLogos from "./PartnerLogos.astro";
import "../styles/home-partners.css";
import RangeField from "./RangeField.astro";
import Carousel from "./Carousel.astro";
import PropertyCard from "./PropertyCard.astro";
import "../styles/buy-mortgage.css";
import "../styles/property-media.css";

const programs = [
  siteText("buy-mortgage.programs.1"),
  siteText("buy-mortgage.programs.2"),
  siteText("buy-mortgage.programs.3"),
  siteText("buy-mortgage.programs.4"),
  siteText("buy-mortgage.programs.5"),
];
const steps = [
  [siteText("buy-mortgage.steps.6"), siteText("buy-mortgage.steps.7")],
  [siteText("buy-mortgage.steps.8"), siteText("buy-mortgage.steps.9")],
  [siteText("buy-mortgage.steps.10"), siteText("buy-mortgage.steps.11")],
];
const endpoint =
  import.meta.env.PUBLIC_CATALOG_ENDPOINT || "/api/catalog";
const mediaBase = import.meta.env.PUBLIC_MEDIA_BASE || "";
---

<section
  class="buy-mortgage"
  aria-labelledby="buy-mortgage-title"
  data-node-id="1380:6364"
>
  <picture class="buy-mortgage-bg-picture">
    <source
      style="display: none"
      media="(max-width: 1199px)"
      srcset="/assets/buy-mortgage-background-mobile.webp"
    />
    <img
      class="buy-mortgage-bg"
      src="/assets/buy-mortgage-background.webp"
      alt=""
      width="1440"
      height="1911"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="buy-mortgage-approval" data-node-id="1380:6370">
    <div class="buy-mortgage-lead">
      <div class="buy-mortgage-intro">
        <h2 id="buy-mortgage-title" class="buy-mortgage-title">
          <span class="buy-mortgage-title-row">
            <span class="buy-mortgage-hand">
              {siteText("buy-mortgage.text.12")}
            </span>
            {siteText("buy-mortgage.text.13")}
          </span>{" "}
          {siteText("buy-mortgage.text.14")}
        </h2>
        <ul class="buy-mortgage-programs" aria-label="Ипотечные программы">
          {programs.map((program) => (
            <li class="chip selected">
              <img
                class="choice-check"
                src="/assets/icon-choice-check.svg"
                alt=""
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span class="buy-mortgage-program-label">{program}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="buy-mortgage-steps">
        {steps.map(([first, second], index) => (
          <>
            {index > 0 && (
              <span class="buy-mortgage-divider" aria-hidden="true" />
            )}
            <NumberedBenefit number={index + 1}>
              {first}<br />{" "}
              {second}
            </NumberedBenefit>
          </>
        ))}
      </div>
    </div>

    <div class="buy-mortgage-banks">
      <p>{siteText("buy-mortgage.text.15")}</p>
      <PartnerLogos home />
    </div>

    <div class="buy-mortgage-cards">
      <Paper class="buy-mortgage-calc" node="1380:6420">
        <div class="buy-mortgage-calc-field">
          <h3>{siteText("buy-mortgage.text.16")}</h3>
          <!-- Только на мобилке: отзыв внутри калькулятора (отдельная плашка скрыта) -->
          <div class="buy-mortgage-calc-review">
            <span class="buy-mortgage-photo expert-avatar-surface expert-avatar-torn">
              <img class="person-photo" src="/assets/staff-anna-stetsenko.webp" alt="" width="1000" height="1000" loading="lazy" />
            </span>
            <div class="buy-mortgage-review-text">
              <p>{siteText("buy-mortgage.text.23")}</p>
              <p class="buy-mortgage-author">{siteText("buy-mortgage.text.24")}</p>
            </div>
          </div>
          <RangeField
            id="buy-housing-price"
            label={siteText("buy-mortgage.label.17")}
            unit="млн"
            class="buy-mortgage-range"
          />
        </div>
        <div class="buy-mortgage-calc-result">
          <Button
            popup="mortgage"
            label={siteText("buy-mortgage.label.18")}
            subject="Подбор ипотеки: стоимость жилья 10,9 млн"
          />
          <div>
            <p class="buy-mortgage-payment">
              {siteText("buy-mortgage.text.19")}{" "}
              <output for="buy-housing-price" data-base-payment="9670">
                9 670
              </output>{" "}
              {siteText("buy-mortgage.text.20")}
            </p>
            <p class="buy-mortgage-note">{siteText("buy-mortgage.text.21")}</p>
          </div>
        </div>
      </Paper>
      <Paper class="buy-mortgage-review" node="1380:6438">
        <span class="buy-mortgage-photo expert-avatar-surface expert-avatar-torn">
          <img class="person-photo" src="/assets/staff-anna-stetsenko.webp" alt="" width="1000" height="1000" loading="lazy" />
        </span>
        <div class="buy-mortgage-review-text">
          <p>{siteText("buy-mortgage.text.23")}</p>
          <p class="buy-mortgage-author">{siteText("buy-mortgage.text.24")}</p>
        </div>
      </Paper>
    </div>
  </div>

  <div class="buy-mortgage-deals" data-node-id="1380:6444">
    <div class="buy-mortgage-deals-heading">
      <h2>{siteText("buy-mortgage.text.25")}</h2>
      <p>
        {siteText("buy-mortgage.text.26")} <br />
        {siteText("buy-mortgage.text.27")}
      </p>
    </div>
    <div
      data-catalog
      data-revision="-1"
      data-endpoint={endpoint}
      data-media-base={mediaBase}
      style="display: contents"
    >
      <div
        data-catalog-live
        hidden
        style="display: contents"
      >
        <Carousel
          label={"Объекты с ценой ниже рынка"}
          class="buy-mortgage-carousel"
          swipeHint
          catalogCount={0}
        >
        </Carousel>
      </div>
      <div data-catalog-empty>
        <div class="buy-deals-empty" role="status" data-catalog-status>
          Загружаем объекты…
        </div>
      </div>
      <template data-card-template>
        <PropertyCard
          title=""
          address=""
          price=""
          oldPrice=""
          pricePerMeter=""
          mortgage=""
          discount=" "
          cardImage={{ small: "", large: "" }}
        />
      </template>
    </div>
  </div>
</section>

<script>
  import "../scripts/catalog-refresh";
  // Демонстрационный расчет: платеж из макета (9 670 ₽ при 10,9 млн)
  // пропорционально стоимости. Точную сумму сообщает менеджер.
  document
    .querySelectorAll<HTMLElement>(".buy-mortgage-calc")
    .forEach((calc) => {
      const input = calc.querySelector<HTMLInputElement>("input[type=range]")!;
      const output = calc.querySelector<HTMLOutputElement>(
        "[data-base-payment]",
      )!;
      const button = calc.querySelector<HTMLButtonElement>("[data-lead]")!;
      const basePrice = Number(input.defaultValue);
      const basePayment = Number(output.dataset.basePayment);
      input.addEventListener("input", () => {
        const price = Number(input.value);
        const payment = Math.round((basePayment * price) / basePrice / 10) * 10;
        output.textContent = payment.toLocaleString("ru-RU");
        button.dataset.subject = `Подбор ипотеки: стоимость жилья ${price.toLocaleString("ru-RU")} млн`;
      });
    });
</script>
