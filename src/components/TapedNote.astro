---
// Бумажная заметка на двух лентах (мастер Figma 569:1388 + ленты 794:340340
// и 794:340399): «Комиссия за сделку — всего 3%» (1380:6985), «Весь процесс
// запишем на видео» (1380:6927). Белая обводка Figma — внутренняя, на
// размеры не влияет; рваный край — общий Paper.
import Paper from "./Paper.astro";
import "../styles/taped-note.css";

interface Props {
  /** Единая бежевая текстура из tokens.css; без нее — белый лист. */
  textured?: boolean;
  icon?: { src: string; width: number; height: number };
  rotate?: number;
  class?: string;
  node?: string;
  tapeNode?: string;
  tape?: boolean;
  /** card — многострочная заметка с иконкой у верхнего края текста. */
  variant?: "label" | "card";
  /** Явная привязка текста заметки к content-id (когда автопривязка
      неоднозначна). Формат как у data-content-* в собранном HTML. */
  contentId?: string;
  contentSlots?: string;
  contentParts?: string;
}

const {
  textured = false,
  icon,
  rotate = 0,
  class: className = "",
  node = "",
  tapeNode = "I1380:6985;569:1388",
  tape = true,
  variant = "label",
  contentId,
  contentSlots,
  contentParts,
} = Astro.props;
---

<div
  class:list={[
    variant === "card" ? "taped-note-card" : "taped-note",
    className,
  ]}
  style={rotate ? `--note-rotate:${rotate}deg` : undefined}
  data-node-id={node || undefined}
>
  <Paper
    class:list={[
      variant === "card" ? "taped-note-card-paper" : "taped-note-paper",
      { "taped-note-plain": !textured },
    ]}
    tapeNode={tape ? tapeNode : ""}
  >
    {icon && (
      <img
        class="taped-note-icon"
        src={icon.src}
        width={icon.width}
        height={icon.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
    <p
      data-content-id={contentId}
      data-content-slots={contentSlots}
      data-content-parts={contentParts}
    >
      <slot />
    </p>
  </Paper>
</div>
