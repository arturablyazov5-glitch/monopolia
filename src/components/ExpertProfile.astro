---
import { imageSize } from "../lib/image-size";
import { expertPortraits } from "../data/expert-portraits";
import type { PersonId } from "../data/people.mjs";
import SpeechBubble from "./SpeechBubble.astro";
interface Props {
  name: string;
  role: string;
  src: string;
  alwaysVisible?: boolean;
  quote?: string;
  /** Ключ сотрудника: включает редактирование имени и должности в админке. */
  person?: PersonId;
}
const { name, role, src, alwaysVisible = false, quote, person } = Astro.props;
const portrait = expertPortraits[src];
if (!portrait) throw new Error(`Не задан кадр портрета эксперта: ${src}`);
const signatureRole = role.charAt(0).toLocaleLowerCase("ru-RU") + role.slice(1);
const nameId = person ? `person.${person}.name` : "";
const roleId = person ? `person.${person}.role` : "";
---

<div
  class:list={[
    "expert-profile",
    { "expert-profile-always": alwaysVisible },
    { "expert-profile-quote": quote },
  ]}
  style={`--profile-image-width:${portrait.width}px;--profile-image-left:${portrait.left}px;--profile-image-top:${portrait.top}px;--profile-image-rotation:${portrait.rotation}deg`}
>
  <span class="expert-profile-avatar expert-avatar-surface expert-avatar-torn">
    <img
      class="person-photo"
      src={src}
      alt={name}
      width={imageSize(src).width}
      height={imageSize(src).height}
      loading="lazy"
      decoding="async"
    />
  </span>
  {quote ? (
    <div class="expert-profile-quote-body">
      <p class="expert-profile-bubble-name">
        <span
          data-content-id={nameId || undefined}
          data-content-slots={nameId ? "0" : undefined}
          data-content-parts={nameId ? "-1" : undefined}
        >
          {name}
        </span>
        ,{" "}
        <span
          data-content-id={roleId || undefined}
          data-content-slots={roleId ? "0" : undefined}
          data-content-parts={roleId ? "-1" : undefined}
        >
          {signatureRole}
        </span>
      </p>
      <SpeechBubble
        class="expert-profile-bubble"
        tail="speech-tail-blue-left.svg"
        text={quote}
      />
    </div>
  ) : (
    <span class="expert-profile-info">
      <strong
        data-content-id={nameId || undefined}
        data-content-slots={nameId ? "0" : undefined}
        data-content-parts={nameId ? "-1" : undefined}
      >
        {name}
      </strong>
      <span
        data-content-id={roleId || undefined}
        data-content-slots={roleId ? "0" : undefined}
        data-content-parts={roleId ? "-1" : undefined}
      >
        {role}
      </span>
    </span>
  )}
</div>

<style>
  .expert-profile {
    display: none;
  }
  .expert-profile.expert-profile-always {
    display: flex;
  }
  .expert-profile {
    align-items: center;
    gap: 12px;
    margin: 4px 0;
  }
  .expert-profile.expert-profile-quote {
    flex-wrap: wrap;
    row-gap: 8px;
  }
  .expert-profile-quote .expert-profile-avatar {
    align-self: flex-start;
  }
  .expert-profile-quote-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 0 1 auto;
    min-width: 0;
    /* аватар 76px + gap 12px: колонка не шире остатка строки */
    max-width: calc(100% - 88px);
  }
  .expert-profile-bubble-name {
    margin: 0 0 4px;
    color: var(--color-muted);
    font: 14px/1.3 var(--font-body);
    white-space: nowrap;
  }
  .expert-profile-avatar {
    position: relative;
    flex: 0 0 76px;
    width: 76px;
    height: 76px;
  }
  .expert-profile-avatar img {
    position: absolute;
    top: var(--profile-image-top);
    left: var(--profile-image-left);
    width: var(--profile-image-width);
    height: auto;
    max-width: none;
    transform: rotate(var(--profile-image-rotation));
    transform-origin: 52% 18%;
  }
  .expert-profile-info {
    display: grid;
    gap: 4px;
    font: 14px/1.2 var(--font-body);
  }
  .expert-profile-info strong {
    font-size: 16px;
  }
  .expert-profile-info > span {
    color: var(--color-muted);
  }
  @media (max-width: 767px) {
    .expert-profile {
      display: flex;
    }
    /* Имя в две строки делает колонку выше фото — прижимаем аватар
       к низу, чтобы низ реплики не уходил ниже снимка. */
    .expert-profile-quote .expert-profile-avatar {
      align-self: flex-end;
    }
    .expert-profile-bubble-name {
      font-size: 12.5px;
      /* в одну строку имя+должность не влезает в колонку 246px — разрешаем перенос */
      white-space: normal;
    }
    @media (max-width: 391px) {
      .expert-profile-bubble-name {
        font-size: 12px;
      }
    }
  }
</style>

<style is:global>
  /* Класс висит на корне SpeechBubble — scoped-стили сюда не достают,
     поэтому типографику облачка задаём глобально. */
  .speech-bubble.expert-profile-bubble p {
    padding: 10px 16px 8px;
    font-size: 16px;
    line-height: 1.3;
    white-space: pre-line;
  }
  /* На телефоне реплика с хвостиком должна помещаться в высоту фото (76px):
     уменьшаем поля и кегль только внутри медиа-запроса. */
  @media (max-width: 767px) {
    .speech-bubble.expert-profile-bubble p {
      padding: 6px 10px 5px;
      font-size: 14px;
      line-height: 1.22;
    }
    @media (max-width: 391px) {
      .speech-bubble.expert-profile-bubble p {
        font-size: 12px;
      }
    }
  }
</style>
