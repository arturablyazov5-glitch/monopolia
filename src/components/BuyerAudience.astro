---
import Button from "./Button.astro";
import Paper from "./Paper.astro";
import "../styles/buyer-audience.css";
---

<section
  class="buyer-audience"
  aria-labelledby="buyer-audience-title"
  data-node-id="1380:4963"
>
  <img
    class="buyer-paper-background"
    src="/assets/e159e.webp"
    fetchpriority="low"
    alt=""
    width="1440"
    height="1325"
    loading="lazy"
    decoding="async"
  />
  <div class="buyer-audience-container">
    <img
      class="buyer-portrait-shadow"
      src="/assets/0cd6b.svg"
      alt=""
      width="282.415"
      height="384.063"
      loading="lazy"
      decoding="async"
    />
    <img
      class="buyer-portrait"
      src="/assets/56909.webp"
      alt="Елена Сиделина за рабочим столом"
      width="844"
      height="633"
      loading="lazy"
      decoding="async"
    />
    <Paper class="buyer-name" node="1380:4974">
      <p class="buyer-name-title">Елена Сиделина</p>
      <p class="buyer-name-role">Генеральный директор Монополии</p>
    </Paper>
    <div class="buyer-audience-content">
      <img
        class="buyer-quote-mark"
        src="/assets/86862.svg"
        fetchpriority="low"
        alt=""
        width="42.6102"
        height="33.2195"
        loading="lazy"
        decoding="async"
      />
      <div class="buyer-audience-copy">
        <h2 id="buyer-audience-title">
          А что если я скажу, <br />
          что <span class="buyer-count-space">1 500 человек</span> <br />
          хотят купить вашу <br />
          недвижимость уже <br />
          сейчас?
        </h2>
        <span class="buyer-count" aria-hidden="true">
          1 500 человек
        </span>
        <Paper class="buyer-note" tapeNode="I1380:4972;569:1388" node="1380:4972">
          <p>
            В нашей базе только проверенные потенциальные покупатели{" "}
            <strong>с наличкой или с предодобренной ипотекой</strong>. Они готовы в ближайшее время купить квартиру, дом или помещение для бизнеса
          </p>
        </Paper>
      </div>
      <Button
        label="Найти покупателя"
        icon="sell"
        subject="Найти покупателя для недвижимости"
      />
    </div>
  </div>
</section>
