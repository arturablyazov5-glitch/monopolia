---
import { siteText } from "../data/site-texts.mjs";
// Общий мастер 1380:6560 / 1380:6326. Тексты экземпляров отличаются.
import Button from "./Button.astro";
import TapedNote from "./TapedNote.astro";
import "../styles/office-consultation.css";
import "../styles/mobile-photo-scene.css";
interface Props {
  variant?: "buy" | "sell";
  id?: string;
  node?: string;
}
const {
  variant = "buy",
  id = `${variant}-consultation`,
  node = variant === "buy" ? "1380:6560" : "1380:6326",
} = Astro.props;
const selling = variant === "sell";
const notes = (selling
  ? [
      ["office-consultation.text.5", "office-consultation.text.6", "office-consultation.text.7"],
      ["office-consultation.text.10", "office-consultation.text.11", "office-consultation.text.12"],
    ]
  : [
      ["office-consultation.text.8", "office-consultation.text.9", "office-consultation.text.7"],
      ["office-consultation.text.13", "office-consultation.text.14", "home-hero.text.3"],
    ]
).map((keys) => keys.map((key) => siteText(key)));
---

<section
  data-surface="dark"
  class:list={["office-consultation", { "office-consultation-sell": selling }]}
  data-node-id={node}
  aria-labelledby={`${id}-title`}
>
  <TapedNote
    tapeNode={`I${node};786:6642;569:1388`}
    class="office-consultation-label"
    textured
    rotate={-1}
  >
    {siteText("office-consultation.text.1")}
  </TapedNote>
  <div class="office-consultation-inner">
    <div class="office-consultation-copy">
      <h2 id={`${id}-title`}>
        {selling ? (
          <>
            {siteText("office-consultation.text.2")} <br />
            {siteText("office-consultation.text.3")}
          </>
        ) : (
          siteText("office-consultation.text.4")
        )}
      </h2>
  <picture class="office-consultation-photo mobile-photo-scene">
    <img
      class="office-consultation-background"
      src="/assets/office-consultation-background.webp"
      width="1440"
      height="798.704"
      alt="Встреча в офисе Монополии"
      loading="lazy"
      decoding="async"
    />
  </picture>
      <div class="office-consultation-notes">
        {notes.map((lines, index) => (
          <TapedNote
            tapeNode={`I${node};${index === 0 ? "1281:4701" : "1281:4795"};569:1388`}
            class="office-consultation-note"
            textured
          >
            {lines.map((line, lineIndex) => <>{lineIndex > 0 && <br />}{line}</>)}
          </TapedNote>
        ))}
      </div>
      <ul class="office-consultation-points bullet-list">
        {notes.map((lines) => <li>{lines.join(" ")}</li>)}
      </ul>
    </div>
    <div class="office-consultation-actions">
      <Button
        popup="office"
        label={siteText("client-cases.label.28")}
        subject={`Консультация в офисе: ${selling ? "продажа" : "покупка"}`}
      />
      <p>
        <span>{siteText("office-consultation.text.15")}{" "}{siteText("office-consultation.text.16")}</span>
        <strong>{siteText("office-consultation.text.17")}</strong>
      </p>
    </div>
  </div>
</section>
