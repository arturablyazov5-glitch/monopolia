---
import { iconPaths, type IconName } from "../scripts/admin/icons";
interface Props {
  name: IconName;
}
const { name } = Astro.props;
---

<svg
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={iconPaths[name]} />
</svg>
