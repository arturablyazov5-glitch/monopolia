---
import { siteText } from "../data/site-texts.mjs";
import ReferralNotification from "./ReferralNotification.astro";
import TapedNote from "./TapedNote.astro";
import { traceLogo } from "../data/trace-logos";
import "../styles/referral-bonus.css";
import { referralPeriod, referralHeadingPrefix } from "../scripts/referral-bonus.mjs";
const period = referralPeriod();
const notifications = [
  {
    bank: siteText("referral-bonus.bank.1"),
    time: siteText("referral-bonus.time.2"),
    icon: "sber",
    left: 1,
    top: 0,
    width: 277.19,
    height: 135.788,
    rotate: -15.96,
  },
  {
    bank: siteText("referral-bonus.bank.3"),
    time: siteText("referral-bonus.time.4"),
    icon: "t-bank",
    left: 0,
    top: 190,
    width: 273.638,
    height: 81.695,
    rotate: 3.79,
  },
  {
    bank: siteText("referral-bonus.bank.5"),
    time: siteText("referral-bonus.time.6"),
    icon: "alfa-bank",
    left: 1,
    top: 80,
    width: 277.18,
    height: 112.858,
    rotate: -10.66,
  },
  {
    bank: siteText("referral-bonus.bank.7"),
    time: siteText("referral-bonus.time.8"),
    icon: "ozon-bank",
    left: 223,
    top: 48,
    width: 273.922,
    height: 83.365,
    rotate: 4.15,
  },
  {
    bank: siteText("referral-bonus.bank.9"),
    time: siteText("referral-bonus.time.10"),
    icon: "mts-money",
    left: 228,
    top: 140.6,
    width: 277.021,
    height: 110.055,
    rotate: -10.03,
  },
  {
    bank: siteText("referral-bonus.bank.11"),
    time: siteText("referral-bonus.time.4"),
    icon: "wildberries",
    left: 116.8,
    top: 97.56,
    width: 276.956,
    height: 139.573,
    rotate: -16.86,
  },
];
---

<section
  class="referral-bonus"
  data-referral-bonus
  aria-labelledby="sell-referral-title"
  data-node-id="1380:6343"
>
  <div class="referral-bonus-row">
    <div
      class="referral-bonus-notifications"
      role="img"
      aria-label="Иллюстрация уведомлений о вознаграждении 5 000 рублей, из макета"
    >
      {notifications.map((n) => (
        <div
          class="referral-notification-slot"
          style={`--notification-left:${n.left}px;--notification-top:${n.top}px;--notification-width:${n.width}px;--notification-height:${n.height}px;--notification-rotation:${n.rotate}deg`}
        >
          <ReferralNotification
            bank={n.bank}
            time={n.time}
            icon={traceLogo(n.icon).src}
            href={traceLogo(n.icon).href}
            alt={traceLogo(n.icon).alt}
          />
        </div>
      ))}
    </div>
    <div class="referral-bonus-copy">
      <div>
        <h2 id="sell-referral-title">
          {siteText("referral-bonus.text.12")}
          <br />
          {siteText("referral-bonus.text.13")}
          <br />
          <span data-referral-prefix data-content-id="referral-bonus.text.14" data-content-slots="0" data-content-parts="-1">{referralHeadingPrefix(siteText("referral-bonus.text.14"))}</span> <span data-referral-month>{period.month}</span>
        </h2>
        <p>{siteText("referral-bonus.text.15")}</p>
      </div>
      <TapedNote class="referral-promotion-label" tapeNode="I1380:6355;569:1388" textured rotate={-1}>
        {siteText("referral-bonus.text.16")}{" "}<strong><span data-referral-days>{period.days}</span>{" "}<span data-referral-word>{period.word}</span></strong>
      </TapedNote>
    </div>
  </div>
  <!-- В узле 6343 кнопки нет (сверка волны 3): кнопка H «Привести друга» убрана. -->
</section>

<script>
  import { updateReferralBonuses } from "../scripts/referral-bonus.mjs";
  updateReferralBonuses();
  setInterval(updateReferralBonuses, 60 * 60 * 1000);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) updateReferralBonuses();
  });
  for (const prefix of document.querySelectorAll("[data-referral-prefix]")) {
    new MutationObserver(updateReferralBonuses).observe(prefix, { childList: true, characterData: true, subtree: true });
  }
</script>
