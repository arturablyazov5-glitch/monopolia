---
import { siteText } from "../data/site-texts.mjs";
// Figma 1380:6839 («Покупка»): темная секция «Наша миссия — комиссия»
// и 10 шагов сделки. Рваный верх deal-steps-paper-edge.svg (повернут на 180°), фон var(--color-dark)
// с текстурой transaction-registration-documents (10%) и градиентом. Левая колонка закреплена при
// прокрутке, полоса прогресса показывает, какая часть шагов пройдена.
// Шаги — данные (src/data/deal-steps.ts), для «Продажи» передать свои.
import Paper from "./Paper.astro";
import TapedNote from "./TapedNote.astro";
import type { DealStep } from "../data/deal-steps";
import "../styles/deal-steps.css";

interface Props {
  id?: string;
  class?: string;
  steps: DealStep[];
  missionTitle?: string;
  missionAccent?: string;
  missionText?: string;
  node?: string;
}

const responsiveImages = new Set([
  "/assets/property-selection-catalog.webp",
  "/assets/mortgage-documents-stack.webp",
  "/assets/property-viewing-route-map.webp",
  "/assets/transaction-preliminary-contract.webp",
  "/assets/transaction-key-handover.webp",
  "/assets/property-sale-plan.webp",
  "/assets/property-advertising-channels.webp",
  "/assets/property-viewing-house.webp",
  "/assets/transaction-buyer-documents.webp",
  "/assets/transaction-money-and-keys.webp",
]);

const {
  id = "buy-steps",
  class: className = "",
  steps,
  missionTitle = siteText("deal-steps.missiontitle.1"),
  missionAccent = siteText("deal-steps.missionaccent.2"),
  missionText = siteText("deal-steps.missiontext.3"),
  node = "1380:6839",
} = Astro.props;
---

<section
  class:list={["deal-steps", className]}
  aria-labelledby={`${id}-title`}
  data-node-id={node}
  data-deal-steps
>
  <img
    loading="lazy"
    class="deal-steps-edge"
    src="/assets/deal-steps-paper-edge.svg"
    width="1447"
    height="95.713"
    alt=""
    aria-hidden="true"
    decoding="async"
  />
  <div class="deal-steps-body">
    <div class="deal-steps-bg" aria-hidden="true">
      <img
        src="/assets/transaction-registration-documents.webp"
        width="569"
        height="740"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="deal-steps-grid" data-node-id="1380:6842">
      <div class="deal-mission" data-node-id="1380:6843">
        <div class="deal-mission-head">
          <div class="deal-mission-portrait" aria-hidden="true">
            <img
              loading="lazy"
              class="deal-mission-shadow"
              src="/assets/deal-mission-person-shadow.svg"
              width="137.143"
              height="143.333"
              alt=""
              decoding="async"
            />
            <picture style="display: contents">
              <source
                style="display: none"
                media="(max-width: 767px)"
                srcset="/assets/deal-mission-specialist-mobile.webp"
              />
              <img
                class="deal-mission-photo person-photo"
                src="/assets/deal-mission-specialist.webp"
                width="131"
                height="139"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <h2 id={`${id}-title`}>
            <span class="deal-mission-muted">{missionTitle}</span>
            <span class="deal-mission-accent">
              {missionAccent}
              <img
                src="/assets/deal-mission-emoji.webp"
                width="38"
                height="38"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          </h2>
          <picture style="display: contents">
            <img
              loading="lazy"
              class="deal-mission-quote"
              src="/assets/deal-mission-quote.svg"
              width="42.6102"
              height="33.2195"
              alt=""
              aria-hidden="true"
              decoding="async"
            />
          </picture>
        </div>
        <p class="deal-mission-text">{missionText}</p>
        <div
          class="deal-progress"
          role="progressbar"
          aria-label="Пройдено шагов сделки"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-deal-progress
        >
          <span class="deal-progress-track">
            <span class="deal-progress-fill" data-deal-progress-fill></span>
          </span>
          <span class="deal-progress-value" data-deal-progress-value>
            0%
          </span>
        </div>
      </div>

      <ol class="deal-steps-list" data-deal-steps-list>
        {steps.map((step, index) => (
          <li class="deal-step" data-node-id={step.node}>
            <div class="deal-step-rail" aria-hidden="true">
              <span class="deal-step-dash deal-step-dash-top">
                {index > 0 && (
                  <img
                    loading="lazy"
                    src="/assets/deal-steps-vertical-dash.svg"
                    width="2"
                    height="26"
                    alt=""
                    decoding="async"
                  />
                )}
              </span>
              <span class="deal-step-number">{index + 1}</span>
              <span class="deal-step-dash deal-step-dash-bottom">
                {step.line && (
                  <img
                    loading="lazy"
                    src={step.line.src}
                    width="2"
                    height={step.line.height}
                    alt=""
                    decoding="async"
                  />
                )}
              </span>
            </div>
            <div class="deal-step-holder">
              <Paper class="deal-step-card">
                <div class="deal-step-main">
                  {step.image && (
                    <div
                      class:list={["deal-step-image", { "deal-step-image-badged": !!step.image.badge }]}
                      style={step.image.badge ? undefined : `aspect-ratio:${step.image.width} / ${step.image.height}`}
                    >
                      <picture>
                        {responsiveImages.has(step.image.src) && (
                          <source
                            style="display: none"
                            media="(max-width: 1199px)"
                            srcset={`${step.image.src.replace(".webp", "")}-560w.webp 560w, ${step.image.src.replace(".webp", "")}-900w.webp 900w, ${step.image.src.replace(".webp", "")}-1304w.webp 1304w`}
                            sizes="(max-width: 767px) calc(100vw - 116px), 632px"
                          />
                        )}
                        <img
                          src={step.image.src}
                          width={step.image.width}
                          height={step.image.height}
                          alt={step.image.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                      {step.image.badge && (
                        <span class="badge deal-step-badge">
                          <img
                            src="/assets/icon-choice-check.svg"
                            width="20"
                            height="20"
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="deal-step-badge-label">{step.image.badge}</span>
                        </span>
                      )}
                    </div>
                  )}
                  <h3>
                    {step.textParts
                      ? step.textParts.map((part) => (
                          <span style={part.muted ? "color:rgb(from var(--color-ink) r g b / 40%)" : undefined}>
                            {part.text}
                          </span>
                        ))
                      : step.text}
                  </h3>
                </div>
                {step.chips && (
                  <ul
                    class="deal-step-chips"
                    data-checks={
                      step.chips.some((chip) => /43/.test(chip.text))
                        ? ""
                        : undefined
                    }
                  >
                    {step.chips.map((chip) => (
                      <li
                        style={
                          chip.box
                            ? `width:${chip.box[0]}px;height:${chip.box[1]}px`
                            : undefined
                        }
                      >
                        <span class="paper-label"
                          style={
                            chip.rotate
                              ? `transform: rotate(${chip.rotate}deg)`
                              : undefined
                          }
                        >
                          {chip.text}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
                {step.list && (
                  <ul class="deal-step-list bullet-list">
                    {step.list.map((item) => (
                      <li>
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
                {step.note && (
                  <TapedNote
                    tapeNode={
                      id.startsWith("sell") || id.includes("sell")
                        ? "I1380:6257;785:7567;1380:6256;569:1388"
                        : "I1380:6928;785:7567;1380:6927;569:1388"
                    }
                    class="deal-step-note"
                    icon={step.note.icon}
                  >
                    {step.note.text}
                  </TapedNote>
                )}
                {step.funnel && (
                  <div
                    class="deal-funnel"
                    style={`--funnel-width:${step.funnel.width}px`}
                  >
                    <ul
                      class="deal-funnel-labels"
                      style={`--funnel-height:${step.funnel.height}px`}
                      aria-label="Что отсеиваем"
                    >
                      {step.funnel.labels.map((label) => (
                        <li
                          class="paper-label"
                          style={`--label-x:${label.x}px;--label-y:${label.y}px;--funnel-angle:${label.rotate}deg`}
                        >
                          {label.text}
                        </li>
                      ))}
                    </ul>
                    <picture style="display: contents">
                      {step.funnel.image.src === "/assets/property-selection-funnel.webp" && (
                        <source
                          style="display: none"
                          media="(max-width: 767px)"
                          srcset="/assets/property-selection-funnel-mobile.webp"
                        />
                      )}
                      <img
                        class="deal-funnel-image"
                        style={`--funnel-width:${step.funnel.width}px;${step.funnel.image.src === "/assets/property-selection-funnel.webp" ? "--funnel-image-ratio:596 / 891" : ""}`}
                        src={step.funnel.image.src}
                        width={step.funnel.image.width}
                        height={step.funnel.image.height}
                        alt={step.funnel.image.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                    <img
                      class="deal-funnel-icon"
                      src={step.funnel.icon.src}
                      width={step.funnel.icon.width}
                      height={step.funnel.icon.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <p class="deal-funnel-result brush-stroke">{step.funnel.result}</p>
                  </div>
                )}
              </Paper>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  // Прогресс: доля списка шагов, прошедшая через середину окна.
  for (const section of document.querySelectorAll<HTMLElement>(
    "[data-deal-steps]",
  )) {
    const list = section.querySelector<HTMLElement>("[data-deal-steps-list]");
    const bar = section.querySelector<HTMLElement>("[data-deal-progress]");
    const fill = section.querySelector<HTMLElement>(
      "[data-deal-progress-fill]",
    );
    const value = section.querySelector<HTMLElement>(
      "[data-deal-progress-value]",
    );
    if (!list || !bar || !fill || !value) continue;
    let frame = 0;
    let previousPercent = -1;
    const update = () => {
      frame = 0;
      const rect = list.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (window.innerHeight / 2 - rect.top) / rect.height));
      const percent = Math.round(ratio * 100);
      if (percent === previousPercent) return;
      fill.style.transform = `scaleX(${percent / 100})`;
      previousPercent = percent;
      value.textContent = `${percent}%`;
      bar.setAttribute("aria-valuenow", String(percent));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>
