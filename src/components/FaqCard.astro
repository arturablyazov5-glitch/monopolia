---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import Button from "./Button.astro";
import type { FaqAnswerBlock } from "../data/faq";

interface Props {
  question?: string;
  answer?: string | FaqAnswerBlock[];
  cta?: string;
  quiz?: "buy" | "sell";
  popup?: "closed-base";
  /** kit — прежний вид UI kit; accordion — карточка секции FAQ (Figma 1380:5740) */
  variant?: "kit" | "accordion";
  /** Уникальный id для связки кнопки и ответа (только accordion) */
  id?: string;
  /** Ответ раскрыт при загрузке — в макете все ответы открыты */
  open?: boolean;
  node?: string;
}
const {
  question = siteText("faq-card.question.1"),
  answer = siteText("faq-card.answer.2"),
  cta = siteText("client-cases.label.28"),
  quiz,
  popup,
  variant = "kit",
  id = "faq-card",
  open = true,
  node = "1380:5740",
} = Astro.props;
const blocks = typeof answer === "string" ? [answer] : answer;
---

{variant === "accordion" ? (
  <Paper class="faq-card faq-card-accordion" node={node}>
    <h3 class="faq-question">
      <button
        class="faq-toggle"
        type="button"
        id={`${id}-question`}
        aria-expanded={open ? "true" : "false"}
        aria-controls={`${id}-answer`}
      >
        <span class="faq-question-text">{question}</span>
        <span class="faq-toggle-icon" aria-hidden="true">
          <img
            class="faq-toggle-bg"
            src="/assets/faq-toggle-background-bg.svg"
            alt=""
            width="38.5917"
            height="37.8297"
            loading="lazy"
            decoding="async"
          />
          <img
            class="faq-toggle-cross"
            src="/assets/faq-toggle-background-cross.svg"
            alt=""
            width="38.5917"
            height="37.8297"
            loading="lazy"
            decoding="async"
          />
        </span>
      </button>
    </h3>
    <div
      class:list={["faq-answer", { "is-closed": !open }]}
      id={`${id}-answer`}
      role="region"
      aria-labelledby={`${id}-question`}
      inert={!open}
    >
      <div class="faq-answer-clip">
        <div class="faq-answer-inner">
          <div class="faq-answer-text">
            {blocks.map((block) =>
              typeof block === "string" ? (
                <p>{block}</p>
              ) : (
                <ul>
                  {block.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ),
            )}
          </div>
          <Button
            label={cta}
            tone="black"
            subject={`Вопрос: ${question}`}
            quiz={quiz}
            popup={quiz ? undefined : (popup ?? "office")}
          />
        </div>
      </div>
    </div>
  </Paper>
) : (
  <Paper class="faq-card" node={node}>
    <h3>
      <img
        src="/assets/faq-toggle-background.svg"
        width="30"
        height="30"
        alt=""
        loading="lazy"
        decoding="async"
      />
      {question}
    </h3>
    <p>{blocks.filter((block) => typeof block === "string").join(" ")}</p>
    <Button
      label={cta}
      tone="black"
      popup={popup ?? "office"}
      subject={`Вопрос: ${question}`}
    />
  </Paper>
)}

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const panelAnimations = new WeakMap<HTMLElement, Animation>();

  // Один делегированный обработчик вместо слушателя на каждую кнопку.
  document.addEventListener("click", (event) => {
    const toggle = (
      event.target as HTMLElement | null
    )?.closest<HTMLButtonElement>(".faq-toggle");
    if (!toggle) return;
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    const panel = document.getElementById(
      toggle.getAttribute("aria-controls")!,
    );
    if (panel) {
      const animateHeight = !reducedMotion.matches;
      const from = animateHeight ? panel.offsetHeight : 0;
      panelAnimations.get(panel)?.cancel();
      panel.classList.toggle("is-closed", expanded);
      if (animateHeight) {
        const animation = panel.animate(
          [{ height: `${from}px` }, { height: `${panel.offsetHeight}px` }],
          { duration: 400, easing: "ease" },
        );
        panelAnimations.set(panel, animation);
      }
      panel.inert = expanded;
    }
  });
</script>
