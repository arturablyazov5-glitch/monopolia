---
import { siteText } from "../data/site-texts.mjs";
// «Продажа», Figma 1380:5814 «05»: видеоистория продажи за 1 день и форма связи.
import Button from "./Button.astro";
import ConsentCheckbox from "./ConsentCheckbox.astro";
import ContactMethods from "./ContactMethods.astro";
import PhoneField from "./PhoneField.astro";
import Paper from "./Paper.astro";
import PlayButton from "./PlayButton.astro";
import SocialLinks from "./SocialLinks.astro";
import VideoDuration from "./VideoDuration.astro";
const storyVideo = { src: "/videos/client-review-1.mp4", duration: "2:06" };
---

<div
  class="sell-week"
  aria-labelledby="sell-week-title"
  data-node-id="1380:5814"
>
  <h2 id="sell-week-title">{siteText("sell-week-case.text.1")}</h2>
  <div class="sell-week-grid">
    <article class="sell-week-video brush-stroke" data-node-id="1380:5817">
      <img
        class="sell-week-video-frame"
        src="/assets/sell-week-video-thumbnail.webp"
        alt="Кадр истории продажи жилья"
        width="960"
        height="640"
        loading="lazy"
        decoding="async"
      />
      <VideoDuration time={storyVideo.duration} placement="top-right" />
      <div class="sell-week-play">
        <p class="sell-week-play-hint" aria-hidden="true">
          {siteText("sell-week-case.text.2")}
          <br />
          {siteText("sell-week-case.text.3")}
        </p>
        <span class="sell-week-play-arrow" aria-hidden="true">
          <span>
            <img
              src="/assets/sell-week-play-arrow.svg"
              alt=""
              width="65.6246"
              height="23.5714"
              loading="lazy"
              decoding="async"
            />
          </span>
        </span>
        <PlayButton
          label="Посмотреть историю продажи квартиры за 1 день"
          video={storyVideo.src}
        />
      </div>
      <div class="sell-week-story" data-node-id="1380:5820">
        <Paper class="sell-week-story-card">
          <Paper class="sell-week-story-label" node="1380:5821">
            <p>{siteText("sell-week-case.text.4")}</p>
          </Paper>
          <p>
            {siteText("sell-week-case.text.5")} <br />
            {siteText("sell-week-case.text.6")} <br />
            {siteText("sell-week-case.text.7")} <br />
            {siteText("sell-week-case.text.8")} <br />
            <strong>{siteText("sell-week-case.text.9")}</strong>
          </p>
          <div class="sell-week-author">
            <span class="sell-week-author-photo">
              <img
                src="/assets/staff-tatyana-savchenko.webp"
                alt="Татьяна Савченко"
                width="1000"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            </span>
            <p class="sell-week-author-copy">
              {siteText("sell-week-case.text.10")}
              <span class="sell-week-author-role">{siteText("sell-week-case.text.11")}</span>
            </p>
          </div>
          <img
            class="sell-week-quote"
            src="/assets/sell-week-story-quote.svg"
            alt=""
            width="26.0607"
            height="20.4199"
            loading="lazy"
            decoding="async"
          />
        </Paper>
      </div>
    </article>

    <Paper class="sell-week-form-card" node="1380:5832">
      <form
        class="lead-form sell-week-form"
        data-form="sell-week"
        data-lead-source="Хотите продать жилье на этой неделе? · Кнопка «Хочу срочно продать объект»"
        data-endpoint={
          import.meta.env.PUBLIC_LEAD_ENDPOINT ||
          (import.meta.env.DEV ? "/lead" : "")
        }
      >
        <span hidden aria-hidden="true">
          <input name="honeypot" tabindex="-1" autocomplete="off" />
        </span>
        <div class="sell-week-form-fields">
          <h3>
            {siteText("sell-week-case.text.12")}
          </h3>
          <p class="sell-week-form-intro">
            Возможно, покупатель вашего жилья уже есть и ждёт вас
          </p>
          <input name="subject" type="hidden" value="Срочная продажа объекта" />
          <label class="sr-only" for="sell-week-phone">
            {siteText("lead-form.text.6")}
          </label>
          <PhoneField id="sell-week-phone" />
          <p class="sell-week-contact-label">Выберите удобный способ связи:</p>
          <ContactMethods />
          <input
            class="sr-only"
            type="text"
            name="channel"
            value=""
            tabindex="-1"
            autocomplete="off"
            required
            aria-label="Способ связи"
          />
          <ConsentCheckbox />
        </div>
        <div class="sell-week-form-bottom">
          <Button label={siteText("sell-week-case.label.13")} type="submit" />
          <div class="sell-week-messengers">
            <span>
              {siteText("sell-week-case.text.14")}
              <br />
              {siteText("sell-week-case.text.15")}
            </span>
            <SocialLinks
              links={[
                { label: "Telegram", icon: "social-telegram-color.svg" },
                { label: "Макс", icon: "social-max-color.svg" },
                { label: "WhatsApp", icon: "social-whatsapp-color.svg" },
              ]}
            />
          </div>
          <p class="form-result" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </Paper>
  </div>
</div>
