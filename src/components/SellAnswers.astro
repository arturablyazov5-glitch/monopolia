---
import { siteText } from "../data/site-texts.mjs";
// «Продажа», Figma 1380:5914 («23»): карточка «Вам не придется отвечать
// покупателям по 100 раз…», 11 меток-тем (1380:5919) и кнопка (1380:5931).
// Секция держит верхний отступ 120 px (зазор от 1380:5852); нижний зазор 120 px
// даёт следующий блок 1380:5932 (RelocationMap со своим padding-top).
import Button from "./Button.astro";
import Paper from "./Paper.astro";
import Badge from "./Badge.astro";
import BadgeGroup from "./BadgeGroup.astro";
import "../styles/sell-answers.css";

interface Props {
  id?: string;
  subject?: string;
}
const {
  id = "sell-answers",
  subject = "Продажа: подготовим ответы покупателям",
} = Astro.props;


// box — габарит повёрнутой метки в Figma (w × h), rotate — угол в градусах.
const topics: { text: string; box: [number, number]; rotate: number }[] = [
  { text: siteText("sell-answers.text.1"), box: [171.48, 31.98], rotate: -1 },
  { text: siteText("sell-answers.text.2"), box: [147.484, 31.561], rotate: 1 },
  { text: siteText("sell-answers.text.3"), box: [113.489, 30.968], rotate: -1 },
  { text: siteText("sell-answers.text.4"), box: [101.951, 32.507], rotate: -2 },
  { text: siteText("sell-answers.text.5"), box: [83.962, 31.879], rotate: 2 },
  { text: siteText("sell-answers.text.6"), box: [90.957, 32.123], rotate: 2 },
  { text: siteText("sell-answers.text.7"), box: [97.249, 29.845], rotate: -0.5 },
  { text: siteText("sell-answers.text.8"), box: [103.49, 30.793], rotate: -1 },
  { text: siteText("sell-answers.text.9"), box: [142.926, 33.938], rotate: 2 },
  { text: siteText("sell-answers.text.10"), box: [176.905, 35.125], rotate: 2 },
  { text: siteText("sell-answers.text.11"), box: [139.485, 31.421], rotate: -1 },
];
---

<section class="sell-answers" aria-labelledby={`${id}-title`} id={id}>
  <Paper class="sell-answers-card paper-white paper-torn-card" node="1380:5914">
    <div class="sell-answers-heading" data-node-id="1380:5916">
      <h2 id={`${id}-title`}>
        {siteText("sell.answers.title")}
      </h2>
      <p>
        {siteText("sell.answers.description")}
      </p>
    </div>
    <BadgeGroup class="sell-answers-topics">
      {topics.map((topic, index) => (
        <Badge text={topic.text} angle={topic.rotate} mobileOrder={[0, 1, 1, 2, 0, 2, 2, 3, 3, 4, 4][index]} />
      ))}
    </BadgeGroup>
    <Button quiz="sell" label={siteText("buyer-audience.label.10")} icon="access" subject={subject} />
  </Paper>
</section>
