---
import { siteText } from "../data/site-texts.mjs";
import Button from "./Button.astro";
import "../styles/certificates.css";
import "../styles/decorative-stroke.css";
---

<section
  data-surface="dark"
  class="certificates"
  aria-labelledby="certificates-title"
  data-node-id="1380:5104"
>
  <img
    class="certificates-background"
    src="/assets/certificates-background.webp"
    alt=""
    width="1440"
    height="620"
    loading="lazy"
    decoding="async"
  />
  <div class="certificates-scene">
    <img
      class="certificates-art"
      src="/assets/certificates-composition.webp"
      srcset="/assets/certificates-composition-mobile.webp 1440w, /assets/certificates-composition.webp 2880w"
      sizes="(max-width: 767px) 720px, 1440px"
      alt=""
      aria-hidden="true"
      width="2880"
      height="1001"
      loading="lazy"
      decoding="async"
    />
    <div class="certificates-content">
      <h2 id="certificates-title">{siteText("certificates.text.1")}</h2>
      <p class="certificates-handwriting">{siteText("certificates.text.2")}</p>
      <div class="certificates-actions">
        <Button popup="office"
          label={siteText("certificates.label.3")}
          subject="Консультация"
        />
        <p>
          {siteText("certificates.text.4")}
        </p>
      </div>
    </div>
    <span class="decorative-stroke decorative-stroke--light certificates-divider" aria-hidden="true"></span>
  </div>
</section>
