---
import Button from "./Button.astro";
import "../styles/certificates.css";
---

<section
  class="certificates"
  aria-labelledby="certificates-title"
  data-node-id="1380:5104"
>
  <img
    class="certificates-background"
    src="/assets/96185.webp"
    alt=""
    width="1440"
    height="620"
    loading="lazy"
    decoding="async"
  />
  <div class="certificates-scene">
    <div class="certificates-ribbon" aria-hidden="true">
      <div>
        <img
          src="/assets/40519.webp"
          alt=""
          width="718"
          height="386"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="certificate-sheet first" aria-hidden="true">
      <img
        src="/assets/89c61.webp"
        alt=""
        width="377"
        height="376"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="certificate-sheet second" aria-hidden="true">
      <img
        src="/assets/89c61.webp"
        alt=""
        width="377"
        height="376"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="certificates-content">
      <h2 id="certificates-title">Маткапитал, СВО‑выплаты и сертификаты</h2>
      <p class="certificates-handwriting">работаем со всем</p>
      <div class="certificates-actions">
        <Button
          label="Получить консультацию"
          subject="Маткапитал, СВО-выплаты и сертификаты"
        />
        <p>
          Знаем все законные лазейки — запишитесь на бесплатную консультацию
        </p>
      </div>
    </div>
    <span class="certificates-divider" aria-hidden="true"></span>
  </div>
</section>
