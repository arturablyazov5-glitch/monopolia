---
import { siteText } from "../data/site-texts.mjs";
import Button from "./Button.astro";
import FormSocial from "./FormSocial.astro";
import ContactMethods from "./ContactMethods.astro";
import PhoneField from "./PhoneField.astro";
import ResumeField from "./ResumeField.astro";
import ConsentCheckbox from "./ConsentCheckbox.astro";
import PersonLabel from "./PersonLabel.astro";
import ExpertProfile from "./ExpertProfile.astro";
interface Props {
  id?: string;
  compact?: boolean;
  variant?: "question" | "contact" | "popup";
  title?: string;
  buttonLabel?: string;
  endpoint?: string;
  description?: string;
  note?: string;
  resume?: boolean;
  subject?: string;
  /** Figma node панели; у внутренних страниц — свои instance */
  node?: string;
}
const {
  id = "question",
  compact = false,
  variant = "question",
  title = siteText("lead-form.title.1"),
  buttonLabel = variant === "question"
    ? siteText("lead-form.buttonlabel.2")
    : siteText("lead-form.buttonlabel.3"),
  endpoint,
  description,
  note,
  resume = false,
  subject = "",
  node = "1380:5753",
} = Astro.props;
---

<div
  class:list={[
    "lead-panel",
    { compact: compact, "popup-panel": variant === "popup" },
  ]}
  data-node-id={node}
>
  <form
    class:list={["lead-form", { "popup-form": variant === "popup" }]}
    novalidate
    data-form={id}
    data-lead-source={`${["home-question", "sell-question", "buy-question"].includes(id) ? "Форма внизу страницы · " : ""}${title.replace(/\n/g, " ")} · Кнопка «${buttonLabel}»`}
    data-endpoint={
      endpoint ??
      (import.meta.env.PUBLIC_LEAD_ENDPOINT ||
        (import.meta.env.DEV ? "/lead" : ""))
    }
  >
    <span hidden aria-hidden="true">
      <input name="honeypot" tabindex="-1" autocomplete="off" />
    </span>
    {variant === "popup" ? (
      <>
        <h2 id={id + "-title"} class="popup-title">
          {title}
        </h2>
        <slot name="context" />
        <div class="popup-body">
          <p id={id + "-description"} class="popup-description">
            {description}
          </p>
          <slot name="media" />
          <div class="popup-fields">
            <slot name="expert" />
            <label class="sr-only" for={id + "-phone"}>
              Телефон
            </label>
            <PhoneField id={id + "-phone"} />
            {resume && <ResumeField id={id + "-resume"} />}
            <div class="popup-channel">
              <p>Выберите удобный способ связи:</p>
              <ContactMethods />
              <input
                class="sr-only"
                type="text"
                name="channel"
                value=""
                tabindex="-1"
                autocomplete="off"
                required
                aria-label="Способ связи"
              />
            </div>
            <ConsentCheckbox />
            <div class="popup-actions">
              <div class="popup-submit">
                <Button label={buttonLabel} type="submit" />
                {note && <p class="popup-action-note">{note}</p>}
              </div>
              {note && <hr class="popup-actions-divider" />}
              <FormSocial />
            </div>
            <p class="form-result" role="status" aria-live="polite" hidden></p>
          </div>
        </div>
        <input name="subject" type="hidden" value={subject} />
      </>
    ) : (
      <>
        <h2 id={id + "-title"}>
          {title.split("\n").map((line, i) => (
            <>
              {i > 0 && " "}
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>
        {!compact && variant === "question" && (
          <ExpertProfile
            name="Елена Горбанева"
            role="Специалист по недвижимости"
            src="/assets/staff-elena-gorbaneva-consultation.webp"
          />
        )}
        <input name="subject" type="hidden" value={subject} />
        {variant === "question" ? (
          <>
            <label class="sr-only" for={id + "-question"}>
              {siteText("lead-form.text.4")}
            </label>
            <textarea
              id={id + "-question"}
              name="question"
              maxlength="1200"
              placeholder="Напишите свой вопрос"
              required
            ></textarea>
          </>
        ) : (
          <>
            <label class="sr-only" for={id + "-name"}>
              Ваше имя
            </label>
            <input
              id={id + "-name"}
              name="name"
              maxlength="80"
              autocomplete="name"
              placeholder="Ваше имя"
              required
            />
            <>
              <ContactMethods />
              <input
                class="sr-only"
                type="text"
                name="channel"
                value=""
                tabindex="-1"
                autocomplete="off"
                required
                aria-label="Способ связи"
              />
            </>
          </>
        )}
        <label class="sr-only" for={id + "-phone"}>
          {siteText("lead-form.text.6")}
        </label>
        <PhoneField id={id + "-phone"} />
        <ConsentCheckbox />
        <div class="form-bottom">
          <Button label={buttonLabel} type="submit" />
          <FormSocial />
        </div>
        <p class="form-result" role="status" aria-live="polite" hidden></p>
      </>
    )}
  </form>
  {!compact && (
    <div class="form-person">
      <img
        class="form-person-stroke"
        src="/assets/consultation-person-shadow.svg"
        alt=""
        width="498.909"
        height="656.2"
        loading="lazy"
        decoding="async"
      />
      <img
        class="person person-photo"
        src="/assets/staff-elena-gorbaneva-consultation.webp"
        alt="Елена Горбанева"
        loading="lazy"
        width="1280"
        height="1600"
        decoding="async"
      />
      <PersonLabel
        class="name-tag"
        name="Елена Горбанева"
        role="Специалист по недвижимости"
      />
    </div>
  )}
</div>
<script>
  import { formErrors } from "../lib/form-errors";
  import { applyPhoneMask } from "../lib/phone-mask";
  document
    .querySelectorAll<HTMLFormElement>(".lead-form")
    .forEach((form, formIndex) => {
      const phone = form.querySelector<HTMLInputElement>("[name=phone]")!;
      form.noValidate = true;
      const phoneMessage = formErrors.phone;
      const validate = () => {
        const digits = phone.value.replace(/\D/g, "");
        phone.setCustomValidity(
          /^\+?[\d()\s-]+$/.test(phone.value) &&
            (phone.value.startsWith("+")
              ? /^7\d{10}$/
              : /^(?:[78]\d{10}|\d{10})$/
            ).test(digits)
            ? ""
            : phoneMessage,
        );
      };
      applyPhoneMask(phone, validate);
      // Ошибки показываются под полями после попытки отправки.
      const messages = formErrors;
      const alertBox = document.createElement("p");
      alertBox.className = "sr-only";
      alertBox.setAttribute("role", "alert");
      form.append(alertBox);
      const fields = [
        ...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input[required], textarea[required]",
        ),
      ];
      fields.forEach((field, index) => {
        if (!field.id) field.id = `lead-${formIndex}-${field.name}-${index}`;
        const error = document.createElement("span");
        error.className = "lead-field-error form-error";
        error.hidden = true;
        error.id = `${field.id}-error`;
        const anchor = field.closest("label") ?? field;
        if (field.name !== "channel") {
          const group = document.createElement("div");
          group.className = "lead-field-group";
          anchor.before(group);
          group.append(anchor, error);
        } else {
          anchor.after(error);
        }
        const sync = () => {
          if (field.name === "phone") validate();
          else
            field.setCustomValidity(
              (
                field.type === "checkbox"
                  ? !(field as HTMLInputElement).checked
                  : !field.value.trim()
              )
                ? (messages[field.name] ?? formErrors.required)
                : "",
            );
          if (
            field.getAttribute("aria-invalid") === "true" &&
            field.validity.valid
          ) {
            field.removeAttribute("aria-invalid");
            field.removeAttribute("aria-describedby");
            error.textContent = "";
            error.hidden = true;
          }
          alertBox.textContent = fields
            .filter(
              (item) =>
                item.getAttribute("aria-invalid") === "true" &&
                !item.validity.valid,
            )
            .map((item) => item.validationMessage)
            .join(" ");
        };
        sync();
        field.addEventListener("input", sync);
        field.addEventListener("change", sync);
        field.addEventListener("invalid", (event) => {
          event.preventDefault();
          field.setAttribute("aria-invalid", "true");
          field.setAttribute("aria-describedby", error.id);
          error.textContent = field.validationMessage;
          error.hidden = false;
          queueMicrotask(() => {
            const invalid = fields.filter((item) => !item.validity.valid);
            alertBox.textContent = invalid.length
              ? `Проверьте форму: ${invalid.map((item) => item.validationMessage).join(" ")}`
              : "";
          });
        });
      });
      const status = form.querySelector<HTMLElement>(".form-result")!;
      const initialChoices = [
        ...form.querySelectorAll<HTMLElement>("[data-choice-group]"),
      ].map((group) => ({
        group,
        selected: group.querySelector("[aria-pressed=true]"),
      }));
      form.addEventListener("reset", () => {
        status.hidden = true;
        status.textContent = "";
        alertBox.textContent = "";
        fields.forEach((field) => {
          field.setCustomValidity("");
          field.removeAttribute("aria-invalid");
          field.removeAttribute("aria-describedby");
          document.getElementById(`${field.id}-error`)!.textContent = "";
          document.getElementById(`${field.id}-error`)!.hidden = true;
        });
        initialChoices.forEach(({ group, selected }) => {
          group.querySelectorAll("button").forEach((button) => {
            button.classList.toggle("selected", button === selected);
            button.setAttribute("aria-pressed", String(button === selected));
          });
        });
      });
      form.addEventListener("input", () => {
        status.hidden = true;
        status.textContent = "";
      });
      form.addEventListener("choice-change", ((e: CustomEvent) => {
        const field = form.querySelector<HTMLInputElement>("[name=channel]");
        if (field) {
          field.value = e.detail.value;
          field.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }) as EventListener);
      let sending = false;
      const loadSubmit = () => import("../scripts/lead-submit");
      form.addEventListener(
        "focusin",
        () => {
          void loadSubmit().catch(() => {});
        },
        { once: true },
      );
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (sending) return;
        fields.forEach((field) => field.dispatchEvent(new Event("input")));
        if (!form.checkValidity()) {
          const invalid = fields.find((field) => !field.validity.valid);
          if (invalid?.name === "channel")
            form.querySelector<HTMLButtonElement>(".channels button")?.focus();
          else invalid?.focus();
          return;
        }
        sending = true;
        const submit = form.querySelector<HTMLButtonElement>("[type=submit]")!;
        submit.disabled = true;
        form.setAttribute("aria-busy", "true");
        status.hidden = false;
        status.textContent = "Отправляем заявку…";
        try {
          const { sendLead } = await loadSubmit();
          await sendLead(form);
          form.reset();
          window.location.assign(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/spasibo/`);
        } catch (error) {
          status.hidden = false;
          status.textContent =
            error instanceof Error
              ? error.message
              : "Не удалось отправить заявку. Попробуйте ещё раз.";
        } finally {
          sending = false;
          submit.disabled = false;
          form.removeAttribute("aria-busy");
        }
      });
    });
</script>

<style>
  /* Статус вне потока: отправка/ошибка не увеличивают панель и страницу. */
  .lead-form > .form-result {
    position: absolute;
    left: 0;
    top: calc(100% + 4px);
  }
</style>

<style is:global>
  @media (max-width: 767px) {
    .lead-form > .lead-field-group:has(.consent) ~ .form-bottom {
      margin-top: var(--space-2);
    }
    #lead-dialog
      .popup-fields
      > .lead-field-group:has(.consent)
      ~ .popup-actions {
      margin-top: 0;
    }
  }
</style>
