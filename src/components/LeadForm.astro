---
import Button from "./Button.astro";
import SocialLinks from "./SocialLinks.astro";
import ChoiceGroup from "./ChoiceGroup.astro";
import ConsentCheckbox from "./ConsentCheckbox.astro";
interface Props {
  id?: string;
  compact?: boolean;
  variant?: "question" | "contact";
  title?: string;
  buttonLabel?: string;
  endpoint?: string;
  subject?: string;
  /** Figma node панели; у внутренних страниц — свои instance */
  node?: string;
}
const {
  id = "question",
  compact = false,
  variant = "question",
  title = "Остались вопросы?\nЗадайте их здесь",
  buttonLabel = variant === "question" ? "Задать вопрос" : "Оставить заявку",
  endpoint,
  subject = "",
  node = "1380:5753",
} = Astro.props;
---

<div class:list={["lead-panel", { compact: compact }]} data-node-id={node}>
  <form
    class="lead-form"
    data-form={id}
    data-lead-source={
      id === "modal"
        ? "Модальная форма"
        : `${["home-question", "sell-question", "buy-question"].includes(id) ? "Форма внизу страницы · " : ""}${title.replace(/\n/g, " ")} · Кнопка «${buttonLabel}»`
    }
    data-endpoint={
      endpoint ??
      (import.meta.env.PUBLIC_LEAD_ENDPOINT ||
        (import.meta.env.DEV ? "/lead" : ""))
    }
  >
    <span hidden aria-hidden="true">
      <input name="honeypot" tabindex="-1" autocomplete="off" />
    </span>
    <h2 id={id + "-title"}>
      {title.split("\n").map((line, i) => (
        <>
          {i > 0 && " "}
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h2>
    <input name="subject" type="hidden" value={subject} />
    {variant === "question" ? (
      <>
        <label class="sr-only" for={id + "-question"}>
          Ваш вопрос
        </label>
        <textarea
          id={id + "-question"}
          name="question"
          maxlength="1200"
          placeholder="Напишите свой вопрос"
          required
        ></textarea>
      </>
    ) : (
      <>
        <label class="sr-only" for={id + "-name"}>
          Ваше имя
        </label>
        <input
          id={id + "-name"}
          name="name"
          maxlength="80"
          autocomplete="name"
          placeholder="Ваше имя"
          required
        />
        <ChoiceGroup
          name="Предпочитаемый способ связи"
          options={["По телефону", "Telegram", "WhatsApp"]}
          channels
        />
        <input type="hidden" name="channel" value="По телефону" />
      </>
    )}
    <label class="sr-only" for={id + "-phone"}>
      Телефон
    </label>
    <input
      id={id + "-phone"}
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder="+7 (999) 999-99-99"
      required
    />
    <ConsentCheckbox />
    <div class="form-bottom">
      <Button label={buttonLabel} type="submit" />
      <div class="form-social">
        <span>
          Или свяжитесь
          <br />
          с нами сами
        </span>
        <SocialLinks />
      </div>
    </div>
    <p class="form-result" role="status" aria-live="polite" hidden></p>
  </form>
  {!compact && (
    <div class="form-person">
      <img
        class="form-person-stroke"
        src="/assets/53384.svg"
        alt=""
        width="498.909"
        height="656.2"
        loading="lazy"
        decoding="async"
      />
      <img
        class="person"
        src="/assets/03306.webp"
        alt="Елена Горбанева"
        loading="lazy"
        width="1280"
        height="1600"
        decoding="async"
      />
      <div class="paper name-tag">
        <h3>Елена Горбанева</h3>
        <p>Специалист по недвижимости</p>
      </div>
    </div>
  )}
</div>
<script>
  import { applyPhoneMask } from "../lib/phone-mask";
  document
    .querySelectorAll<HTMLFormElement>(".lead-form")
    .forEach((form, formIndex) => {
      const phone = form.querySelector<HTMLInputElement>("[name=phone]")!;
      const phoneMessage = "Введите российский телефон: +7 и 10 цифр номера.";
      const validate = () => {
        const digits = phone.value.replace(/\D/g, "");
        phone.setCustomValidity(
          /^[+\d()\s-]*$/.test(phone.value) &&
            /^(?:[78][349]\d{9}|[349]\d{9})$/.test(digits)
            ? ""
            : phoneMessage,
        );
      };
      applyPhoneMask(phone, validate);
      // a11y: ошибки связаны с полем (aria-invalid + aria-describedby на
      // скрытый текст ошибки) и объявляются сводкой role="alert". Вид не
      // меняется: визуально ошибку по-прежнему показывает браузерная подсказка.
      const messages: Record<string, string> = {
        question: "Напишите свой вопрос.",
        name: "Укажите ваше имя.",
        phone: phoneMessage,
        consent: "Нужно согласие на обработку персональных данных.",
      };
      const alertBox = document.createElement("p");
      alertBox.className = "sr-only";
      alertBox.setAttribute("role", "alert");
      form.append(alertBox);
      const fields = [
        ...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input[required], textarea[required]",
        ),
      ];
      fields.forEach((field, index) => {
        if (!field.id) field.id = `lead-${formIndex}-${field.name}-${index}`;
        const error = document.createElement("span");
        error.className = "sr-only";
        error.id = `${field.id}-error`;
        (field.closest("label") ?? field).after(error);
        const sync = () => {
          if (field.name === "phone") validate();
          else
            field.setCustomValidity(
              (
                field.type === "checkbox"
                  ? !(field as HTMLInputElement).checked
                  : !field.value.trim()
              )
                ? (messages[field.name] ?? "Заполните поле.")
                : "",
            );
          if (
            field.getAttribute("aria-invalid") === "true" &&
            field.validity.valid
          ) {
            field.removeAttribute("aria-invalid");
            field.removeAttribute("aria-describedby");
            error.textContent = "";
          }
          alertBox.textContent = fields
            .filter(
              (item) =>
                item.getAttribute("aria-invalid") === "true" &&
                !item.validity.valid,
            )
            .map((item) => item.validationMessage)
            .join(" ");
        };
        sync();
        field.addEventListener("input", sync);
        field.addEventListener("change", sync);
        field.addEventListener("invalid", () => {
          field.setAttribute("aria-invalid", "true");
          field.setAttribute("aria-describedby", error.id);
          error.textContent = field.validationMessage;
          queueMicrotask(() => {
            const invalid = fields.filter((item) => !item.validity.valid);
            alertBox.textContent = invalid.length
              ? `Проверьте форму: ${invalid.map((item) => item.validationMessage).join(" ")}`
              : "";
          });
        });
      });
      const status = form.querySelector<HTMLElement>(".form-result")!;
      const initialChoices = [
        ...form.querySelectorAll<HTMLElement>("[data-choice-group]"),
      ].map((group) => ({
        group,
        selected: group.querySelector("[aria-pressed=true]"),
      }));
      form.addEventListener("reset", () => {
        status.hidden = true;
        status.textContent = "";
        alertBox.textContent = "";
        fields.forEach((field) => {
          field.setCustomValidity("");
          field.removeAttribute("aria-invalid");
          field.removeAttribute("aria-describedby");
          document.getElementById(`${field.id}-error`)!.textContent = "";
        });
        initialChoices.forEach(({ group, selected }) => {
          group.querySelectorAll("button").forEach((button) => {
            button.classList.toggle("selected", button === selected);
            button.setAttribute("aria-pressed", String(button === selected));
          });
        });
      });
      form.addEventListener("input", () => {
        status.hidden = true;
        status.textContent = "";
      });
      form.addEventListener("choice-change", ((e: CustomEvent) => {
        const field = form.querySelector<HTMLInputElement>("[name=channel]");
        if (field) field.value = e.detail.value;
      }) as EventListener);
      let sending = false;
      const loadSubmit = () => import("../scripts/lead-submit");
      form.addEventListener(
        "focusin",
        () => {
          void loadSubmit().catch(() => {});
        },
        { once: true },
      );
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (sending) return;
        validate();
        if (!form.reportValidity()) return;
        sending = true;
        const submit = form.querySelector<HTMLButtonElement>("[type=submit]")!;
        submit.disabled = true;
        form.setAttribute("aria-busy", "true");
        status.hidden = false;
        status.textContent = "Отправляем заявку…";
        try {
          const { sendLead } = await loadSubmit();
          await sendLead(form);
          form.reset();
          status.hidden = false;
          status.textContent = "Заявка отправлена. Мы свяжемся с вами.";
        } catch (error) {
          status.hidden = false;
          status.textContent =
            error instanceof Error
              ? error.message
              : "Не удалось отправить заявку. Попробуйте ещё раз.";
        } finally {
          sending = false;
          submit.disabled = false;
          form.removeAttribute("aria-busy");
        }
      });
    });
</script>

<style>
  /* Статус вне потока: отправка/ошибка не увеличивают панель и страницу. */
  .lead-form > .form-result {
    position: absolute;
    left: 0;
    top: calc(100% + 4px);
  }
</style>
