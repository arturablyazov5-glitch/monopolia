---
import { siteText } from "../data/site-texts.mjs";
const {
  text = siteText("speech-bubble.text.1"),
  side = "left",
  tail = "speech-tail-white-left.svg",
  class: className = "",
} = Astro.props;
---

<div class:list={["speech-bubble", side, className]} data-node-id="1380:5769">
  <p>{text}</p>
  <img
    src={"/assets/" + tail}
    alt=""
    width="42.183"
    height="24.858"
    loading={Astro.props.loading ?? "lazy"}
    decoding="async"
  />
</div>
