---
import { siteText } from "../data/site-texts.mjs";
const {
  text = siteText("speech-bubble.text.1"),
  side = "left",
  tail = "speech-tail-white-left.svg",
  class: className = "",
} = Astro.props;
const isBlue = tail === "speech-tail-blue-left.svg" || tail === "speech-tail-blue-right.svg";
---

<div class:list={["speech-bubble", side, { "speech-bubble-blue": isBlue }, className]} data-node-id="1380:5769">
  <p>{text}</p>
  {isBlue ? (
    <span class="speech-bubble-blue-tail" aria-hidden="true"></span>
  ) : (
    <img
      src={"/assets/" + tail}
      alt=""
      width="42.183"
      height="24.858"
      loading={Astro.props.loading ?? "lazy"}
      decoding="async"
    />
  )}
</div>
