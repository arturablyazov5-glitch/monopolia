---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import Button from "./Button.astro";
import Badge from "./Badge.astro";
import BadgeGroup from "./BadgeGroup.astro";
import MarketplaceBadge from "./MarketplaceBadge.astro";
import "../styles/private-catalog.css";
const marketIntroWords = siteText("private-catalog.text.14").split(/\s+/);
const marketPreposition = marketIntroWords.pop();
const marketLead = marketIntroWords.join(" ");
const checks = [
  siteText("private-catalog.checks.1"),
  siteText("private-catalog.checks.2"),
  siteText("private-catalog.checks.3"),
  siteText("private-catalog.checks.4"),
  siteText("private-catalog.checks.5"),
  siteText("private-catalog.checks.6"),
  siteText("private-catalog.checks.7"),
  siteText("private-catalog.checks.8"),
  siteText("private-catalog.checks.9"),
];
---

<section
  class="private-catalog"
  aria-labelledby="private-catalog-title"
  data-node-id="1380:5060"
>
  <div class="private-catalog-heading">
    <h2 id="private-catalog-title">
      <span class="private-catalog-intro">{siteText("private-catalog.text.10")} <br class="private-catalog-desktop-break" />{siteText("private-catalog.text.11")}</span>{" "}
      <span class="private-catalog-count-space">{siteText("private-catalog.text.12")}</span>
      <span class="private-catalog-tail">
        {siteText("private-catalog.text.13")}
        <span class="private-catalog-mobile-intro"> {marketLead}</span>
      </span>
    </h2>
    <span class="private-catalog-count" aria-hidden="true">
      {siteText("private-catalog.text.12")}
    </span>
    <div class="private-catalog-markets">
      <span class="private-catalog-market-intro">{siteText("private-catalog.text.14")}</span>
      <span class="private-catalog-mobile-intro">{marketPreposition}</span>
      <MarketplaceBadge name="avito" />
      <span>и</span>
      <MarketplaceBadge name="cian" />
    </div>
  </div>
  <Paper class="private-catalog-card paper-torn-card" tapeNode="1433:9821" node="1433:9821">
    <div class="private-catalog-assurance">
      <img
        src="/assets/catalog-assurance-icon.svg"
        alt=""
        width="36"
        height="36"
        loading="lazy"
        decoding="async"
      />
      <p>
        {siteText("private-catalog.text.17")} <br />
        <span class="private-catalog-assurance-detail">{siteText("private-catalog.text.18")}</span>
      </p>
    </div>
    <BadgeGroup class="private-catalog-checks">
      {checks.map((text, index) => (
        <Badge text={text} angle={[-1, 1, -1, -2, 2, 2, -0.5, -1, 2][index]} mobileOrder={[0, 0, 0, 1, 1, 0, 2, 3, 3][index]} />
      ))}
    </BadgeGroup>
    <Button popup="closed-base"
      label={siteText("private-catalog.label.19")}
      icon="access"
      subject="Доступ к закрытой базе недвижимости"
    />
  </Paper>
</section>
