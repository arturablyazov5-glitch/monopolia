---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import "../styles/company-guild.css";
---

<section
  data-surface="dark"
  class="company-guild"
  aria-labelledby="guild-title"
  data-node-id="1380:5266"
>
  <Paper class="guild-card paper-frame-deep">
    <h1 id="guild-title">
      {siteText("company-guild.text.1")} <br />{siteText("company-guild.text.2")} <br />
      {siteText("company-guild.text.3")}
    </h1>
    <div class="guild-details">
      <Paper class="guild-note" tapeNode="I1380:5271;569:1388">
        <p>
          {siteText("company-guild.text.4")} <br />
          {siteText("company-guild.text.5")} <strong>{siteText("company-guild.text.6")}</strong>
        </p>
      </Paper>
      <p>
        {siteText("company-guild.text.7")}
      </p>
    </div>
    <div class="guild-logo-crop" aria-hidden="true">
      <img
        src="/assets/logo-realtors-guild.svg"
        width="399.44"
        height="352.154"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </Paper>
</section>
