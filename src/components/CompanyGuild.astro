---
import Paper from "./Paper.astro";
import "../styles/company-guild.css";
---

<section
  class="company-guild"
  aria-labelledby="guild-title"
  data-node-id="1380:5266"
>
  <Paper class="guild-card">
    <h2 id="guild-title">
      Входим в Российскую <br />и Дальневосточную <br />
      гильдию риелторов
    </h2>
    <div class="guild-details">
      <Paper class="guild-note" tapeNode="I1380:5271;569:1388">
        <p>
          Это как звезда Мишлен, но только <br />
          вместо повара — <strong>риелтор</strong>
        </p>
      </Paper>
      <p>
        Гильдия следит за тем, чтобы агенты работали по кодексу этики и единым стандартам
      </p>
    </div>
    <div class="guild-logo-crop" aria-hidden="true">
      <img
        src="/assets/298bd.svg"
        width="399.44"
        height="352.154"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </Paper>
</section>
