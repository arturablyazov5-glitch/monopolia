---
import { socialUrls } from "../data/social-links";
import { imageSize } from "../lib/image-size";
interface Props {
  loading?: "eager" | "lazy";
  dark?: boolean;
  purpose?: "contact" | "channel";
  size?: 32 | 40;
  links?: { label: string; href?: string; icon: string }[];
}
const { dark = false, size = 32, links, purpose = "contact" } = Astro.props;
const defaults: { label: string; icon: string; href?: string }[] = [
  { label: "Telegram", icon: dark ? "social-telegram-dark.svg" : "social-telegram-color.svg" },
  { label: "Макс", icon: dark ? "social-max-dark.svg" : "social-max-color.svg" },
  { label: "WhatsApp", icon: dark ? "social-whatsapp-dark.svg" : "social-whatsapp-color.svg" },
];
---

<div class="socials" style={`--social-size:${size}px`}>
  {(links ?? defaults).map((item) => ({
    ...item,
    href: item.href ?? (item.label === "Telegram" && purpose === "contact" ? socialUrls.TelegramContact : socialUrls[item.label]),
  })).map((item) =>
    item.href ? (
      <a href={item.href} aria-label={item.label} target="_blank" rel="noopener noreferrer">
        <img
          src={"/assets/" + item.icon}
          alt=""
          loading={Astro.props.loading ?? "lazy"}
          width={imageSize("/assets/" + item.icon).width}
          height={imageSize("/assets/" + item.icon).height}
          decoding="async"
        />
      </a>
    ) : (
      <span title={item.label}>
        <img
          src={"/assets/" + item.icon}
          alt={item.label}
          loading={Astro.props.loading ?? "lazy"}
          width={imageSize("/assets/" + item.icon).width}
          height={imageSize("/assets/" + item.icon).height}
          decoding="async"
        />
      </span>
    ),
  )}
</div>
