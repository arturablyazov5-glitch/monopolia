---
import "../styles/handwritten-number.css";
import { siteText } from "../data/site-texts.mjs";
import Button from "./Button.astro";
import TapedNote from "./TapedNote.astro";
import SpeechBubble from "./SpeechBubble.astro";
import "../styles/deal-insurance.css";
interface Props {
  id?: string;
  node?: string;
  subject?: string;
}
const {
  id = "deal-insurance",
  node = "1380:6562",
  subject = "Страхование сделки: покупка",
} = Astro.props;
---

<section
  class="deal-insurance"
  data-node-id={node}
  aria-labelledby={`${id}-title`}
>
  <div class="deal-insurance-copy">
    <div class="deal-insurance-heading">
      <h2 id={`${id}-title`}>
        {siteText("deal-insurance.text.1")}
        <br />
        {siteText("deal-insurance.text.2")}
        <span class="deal-insurance-hand handwritten-number">{siteText("deal-insurance.text.3")}</span>
      </h2>
      <p class="deal-insurance-description">
        {siteText("deal-insurance.text.4")}
      </p>
    </div>
    <TapedNote
      class="deal-insurance-note"
      tapeNode={`I${node};1168:7198;569:1388`}
      textured
    >
      {siteText("deal-insurance.text.5")}{" "}
      <strong>
        {siteText("deal-insurance.text.6")}
        <br />
        {siteText("deal-insurance.text.7")}
      </strong>{" "}
      {siteText("deal-insurance.text.8")}
    </TapedNote>
    <div class="deal-insurance-actions">
      <Button
        popup="service"
        label={siteText("client-cases.label.28")}
        subject={subject}
      />
      <p>
        {siteText("realtor-comparison.text.3")}{" "}
        <strong>{siteText("deal-insurance.text.9")}</strong>
      </p>
    </div>
  </div>
  <div class="deal-insurance-visual">
    {/* На десктопе обертка display: contents (прежние координаты слоев);
        на узких экранах — масштабируемая сцена фото + SVG-тень. */}
    <div class="deal-insurance-stage">
      <img
        class="deal-insurance-shadow"
        src="/assets/insurance-people-shadow.svg"
        alt=""
        loading="lazy"
        width="867.935"
        height="726.779"
        decoding="async"
      />
      <img
        class="deal-insurance-photo person-photo"
        src="/assets/insurance-elena-and-client.webp"
        width="732.233"
        height="570.513"
        alt="Елена с клиентом"
        loading="lazy"
        decoding="async"
      />
    </div>
    <img
      class="deal-insurance-edge"
      src="/assets/insurance-bottom-paper-edge.svg"
      alt=""
      loading="lazy"
      width="1440"
      height="51.5"
      decoding="async"
    />
    <div class="deal-insurance-client">
      <p>{siteText("deal-insurance.text.10")}</p>
      <SpeechBubble side="right" tail="speech-tail-white-right.svg" text="🤨🤨🤨🤨" />
    </div>
    <div class="deal-insurance-elena">
      <p>{siteText("deal-insurance.name")}</p>
      <SpeechBubble
        tail="speech-tail-blue-left.svg"
        text={siteText("deal-insurance.text.11")}
      />
    </div>
  </div>
</section>
