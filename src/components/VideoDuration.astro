---
interface Props {
  time: string;
  placement?: "bottom-right" | "top-right";
}
const { time, placement = "bottom-right" } = Astro.props;
const parts = /^(\d+):(\d{2})$/.exec(time);
const datetime = parts ? `PT${parts[1]}M${parts[2]}S` : undefined;
---

<time class:list={["video-duration", "brush-stroke", placement]} datetime={datetime} aria-label={`Длительность ${time}`}>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 6C12 9.31371 9.31371 12 6 12C2.68629 12 0 9.31371 0 6C0 2.68629 2.68629 0 6 0C9.31371 0 12 2.68629 12 6ZM6 2.05714C6.28403 2.05714 6.51429 2.2874 6.51429 2.57143L6.51429 5.48571H8.57143C8.85546 5.48571 9.08571 5.71597 9.08571 6C9.08571 6.28403 8.85546 6.51429 8.57143 6.51429H6C5.71597 6.51429 5.48571 6.28403 5.48571 6V2.57143C5.48571 2.2874 5.71597 2.05714 6 2.05714Z" fill="var(--color-dark)"></path>
  </svg>
  <span>{time}</span>
</time>

<style>
  .video-duration {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 3px 8px;
    border-radius: 0;
    --brush-images: var(--brush-square-images);
    background: var(--color-paper);
    font: 14px/1.2 var(--font-body);
    color: var(--color-ink);
  }
  .video-duration svg {
    display: block;
    flex: none;
    transform: translateY(-1px);
  }
  .bottom-right {
    position: absolute;
    right: 16px;
    bottom: 16px;
  }
  .top-right {
    align-self: flex-end;
  }
  @media (max-width: 767px) {
    .top-right { margin-bottom: 4px; }
  }
  @media (max-width: 767px) {
    @supports (-webkit-touch-callout: none) {
      .video-duration {
        padding-top: 6px;
        padding-bottom: 2px;
      }
      .video-duration svg {
        transform: translateY(1px);
      }
    }
  }
  :global(html[data-iphone]) .video-duration {
    padding-top: 4px;
    padding-bottom: 4px;
  }
  :global(html[data-iphone]) .video-duration svg {
    transform: translateY(-1px);
  }
</style>
