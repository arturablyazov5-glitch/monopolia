---
import { tapesFor, cleanTapeSource, type TapePlacement } from "../lib/tape";
import "../styles/tape.css";
interface Props {
  node?: string;
  tapes?: TapePlacement[];
}
const { node = "", tapes = tapesFor(node) } = Astro.props;
// Только пара верх-слева / низ-справа у заметки или купона (TASK-067).
// Одиночные, центральные, обратная диагональ и четыре угла остаются по Figma.
const notePair =
  tapes.length === 2 &&
  tapes.some((t) => t.horizontal === "left" && t.vertical === "top") &&
  tapes.some((t) => t.horizontal === "right" && t.vertical === "bottom");
---

<span class="tape-layer" aria-hidden="true">
  {tapes.map((t) => (
    <img
      class="paper-tape"
      data-tape-node={t.node}
      data-tape-shift={notePair ? t.vertical : undefined}
      data-tape-corner={t.vertical === "bottom" && t.horizontal === "right" ? "bottom-right" : undefined}
      src={cleanTapeSource(t.src)}
      width={t.width}
      height={t.height}
      alt=""
      loading="lazy"
      decoding="async"
      style={`--tape-width:${t.width}px;--tape-height:${t.height}px;--tape-x:${t.horizontal === "right" ? `calc(100% + ${t.x}px)` : t.horizontal === "center" ? `calc(50% + ${t.x}px)` : `${t.x}px`};--tape-y:${t.vertical === "bottom" ? `calc(100% + ${t.y}px)` : `${t.y}px`};--tape-transform:matrix(${t.matrix.join(",")},0,0);--tape-box-left:calc(var(--tape-width) * ${Math.min(0, t.matrix[0])} + var(--tape-height) * ${Math.min(0, t.matrix[2])});--tape-box-top:calc(var(--tape-width) * ${Math.min(0, t.matrix[1])} + var(--tape-height) * ${Math.min(0, t.matrix[3])});--tape-box-width:calc(var(--tape-width) * ${Math.abs(t.matrix[0])} + var(--tape-height) * ${Math.abs(t.matrix[2])});--tape-box-height:calc(var(--tape-width) * ${Math.abs(t.matrix[1])} + var(--tape-height) * ${Math.abs(t.matrix[3])});--tape-shadow:${t.shadow};--tape-opacity:${t.opacity}`}
    />
  ))}
</span>
