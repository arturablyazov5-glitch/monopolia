---
import Paper from "./Paper.astro";
import { siteText } from "../data/site-texts.mjs";
---

<Paper class="pdf-file-note" tapeNode="1380:5795" node="1380:5795">
  <img src="/assets/sell-valuation-note-icon.svg" alt="" width="36" height="36" loading="lazy" decoding="async" />
  <p>
    <span>{siteText("sell-valuation.text.5")}</span>
    <small>{siteText("sell-valuation.text.6")}</small>
  </p>
</Paper>

<style is:global>
  .pdf-file-note {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    transform: rotate(-3deg);
  }
  .pdf-file-note p {
    display: flex;
    flex-direction: column;
    font: 16px/1.2 var(--font-body);
    color: var(--color-ink);
    white-space: nowrap;
  }
  .pdf-file-note small {
    font-size: 14px;
    line-height: 1.2;
    color: var(--color-muted);
  }
</style>
