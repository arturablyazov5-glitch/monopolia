---
import { siteText } from "../data/site-texts.mjs";
import "../styles/office-expansion.css";
import "../styles/office-expansion-mobile.css";
---

<section
  data-surface="dark"
  class="office-expansion"
  aria-labelledby="expansion-title"
  data-node-id="1380:5274"
>
  <div class="expansion-map" aria-hidden="true">
    <img
      src="/assets/office-building-photo.svg"
      width="5385.13"
      height="3034.879"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div></div>
  </div>
  <div class="expansion-container">
    <h2 id="expansion-title">
      {siteText("office-expansion.text.1")} <br />{siteText("office-expansion.text.2")}
    </h2>
    <div class="expansion-locations">
    <svg class="office-mobile-leaders" viewBox="0 0 360 400" aria-hidden="true" focusable="false">
      <defs>
        <marker id="office-leader-arrow" viewBox="0 0 6 6" refX="0" refY="3" markerWidth="4" markerHeight="4" orient="auto">
          <path d="M0 0 6 3 0 6Z" fill="var(--color-paper)" stroke="none" />
        </marker>
      </defs>
      <path d="M104.4 254.4 C102.4 262 104.4 268 113.4 272 C122.4 276 135.4 276.2 149.4 278.4" marker-end="url(#office-leader-arrow)" />
      <path d="M280.8 193.6 C280.8 206 266.5 204 256 222" marker-end="url(#office-leader-arrow)" />
    </svg>
    <div class="office-marker future-office">
      <div class="office-label-group">
        <div class="office-label">
          {siteText("office-expansion.text.3")} <span>{siteText("office-expansion.text.4")}</span>
        </div>
        <img
          class="office-arrow"
          src="/assets/office-future-arrow.svg"
          width="27.776"
          height="23.3"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <img
        src="/assets/office-photo-decor.svg"
        width="29"
        height="40"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="office-marker current-office">
      <img
        src="/assets/office-photo-decor.svg"
        width="29"
        height="40"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="office-label-group">
        <div class="office-label">{"Белогорск"}</div>
        <img
          class="office-arrow"
          src="/assets/office-history-arrow.svg"
          width="27.776"
          height="23.3"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="office-photo-bubble future-photo">
      <div class="office-photo-frame">
        <img
          src="/assets/office-blagoveshchensk-preview.webp"
          width="200"
          height="120"
          alt="Иллюстрация офисного интерьера"
          loading="lazy"
          decoding="async"
        />
      </div>
      <img
        class="office-bubble-tail"
        src="/assets/office-speech-tail.svg"
        width="42.183"
        height="24.858"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="office-photo-bubble current-photo">
      <div class="office-photo-frame">
        <img
          class="office-photo-underlay"
          src="/assets/office-future-photo-placeholder.webp"
          width="200"
          height="120"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <img
          src="/assets/office-belogorsk-interior.webp"
          width="200"
          height="120"
          alt="Интерьер офиса Монополии в Белогорске"
          loading="lazy"
          decoding="async"
        />
      </div>
      <img
        class="office-bubble-tail"
        src="/assets/office-speech-tail.svg"
        width="42.183"
        height="24.858"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    </div>
  </div>
</section>
