---
import "../styles/office-expansion.css";
---

<section
  class="office-expansion"
  aria-labelledby="expansion-title"
  data-node-id="1380:5274"
>
  <div class="expansion-map" aria-hidden="true">
    <img
      src="/assets/5ac82.svg"
      width="5385.13"
      height="3034.879"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div></div>
  </div>
  <div class="expansion-container">
    <h2 id="expansion-title">
      Мы добрались до Благовещенска{" "}
      <br />— открываем второй офис
    </h2>
    <div class="office-marker future-office">
      <div class="office-label-group">
        <div class="office-label">
          Благовещенск <span>Скоро</span>
        </div>
        <img
          class="office-arrow"
          src="/assets/d8515.svg"
          width="27.776"
          height="23.3"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <img
        src="/assets/66fdd.svg"
        width="29"
        height="40"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="office-marker current-office">
      <img
        src="/assets/66fdd.svg"
        width="29"
        height="40"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="office-label-group">
        <div class="office-label">Белогорск</div>
        <img
          class="office-arrow"
          src="/assets/72e89.svg"
          width="27.776"
          height="23.3"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="office-photo-bubble future-photo">
      <div class="office-photo-frame">
        <img
          src="/assets/268b2.webp"
          width="200"
          height="120"
          alt="Место для фотографии будущего офиса"
          loading="lazy"
          decoding="async"
        />
        <span>Фото офиса</span>
      </div>
      <img
        class="office-bubble-tail"
        src="/assets/2b5ba.svg"
        width="42.183"
        height="24.858"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="office-photo-bubble current-photo">
      <div class="office-photo-frame">
        <img
          class="office-photo-underlay"
          src="/assets/268b2.webp"
          width="200"
          height="120"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <img
          src="/assets/291d1.webp"
          width="200"
          height="120"
          alt="Интерьер офиса Монополии в Белогорске"
          loading="lazy"
          decoding="async"
        />
      </div>
      <img
        class="office-bubble-tail"
        src="/assets/2b5ba.svg"
        width="42.183"
        height="24.858"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
