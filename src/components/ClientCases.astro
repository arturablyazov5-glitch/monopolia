---
import { siteText } from "../data/site-texts.mjs";
import { clientCases } from "../data/client-cases";
import Paper from "./Paper.astro";
import ConsultationButton from "./ConsultationButton.astro";
import ChoiceGroup from "./ChoiceGroup.astro";
import ScrollHint from "./ScrollHint.astro";
import CarouselControls from "./CarouselControls.astro";
import "../styles/client-cases.css";
const cases = clientCases;
---

<section
  data-surface="dark"
  class="client-cases"
  id="cases"
  aria-labelledby="cases-title"
  data-node-id="1380:5193"
>
  <div class="cases-container" data-surface="light">
    <div class="cases-heading">
      <div>
        <h2 id="cases-title">
          {siteText("client-cases.text.18")} <br />
          {siteText("client-cases.text.19")}
        </h2>
        <p class="cases-handwriting">{siteText("client-cases.text.20")}</p>
      </div>
      <div class="cases-tabs">
        <ChoiceGroup
          name="Категория кейсов"
          labelClass="cases-tab-label"
          channels
          options={[
            siteText("client-cases.options.21"),
            siteText("client-cases.options.22"),
            siteText("client-cases.options.23"),
          ]}
        />
        <img
          class="cases-pointer"
          src="/assets/icon-cases-cursor.svg"
          alt=""
          aria-hidden="true"
          width="17.6346"
          height="19.3498"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <ScrollHint />
    <div
      class="cases-content"
      data-case-content
      role="region"
      aria-label="Кейсы клиентов: прокрутка стрелками клавиатуры"
      tabindex="0"
    >
      {cases.map((caseItem, index) => (
        <article
          class:list={["case-slide", { "is-active": index === 0 }]}
          data-case-slide
          data-category={caseItem.category}
          data-node-id={caseItem.id}
          aria-hidden={index !== 0 ? "true" : undefined}
        >
          <div
            class:list={[
              "case-photo",
              {
                "case-photo-natural": caseItem.naturalPhoto,
              },
            ]}
          >
            {caseItem.photo ? (
              <img
                src={caseItem.photo}
                width="426"
                height="561"
                alt={caseItem.object}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="case-photo-placeholder">
                <svg
                  aria-hidden="true"
                  width="48"
                  height="48"
                  viewBox="0 0 48 48"
                  fill="none"
                >
                  <path
                    d="M6 15h8l3-5h14l3 5h8v23H6z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"
                  />
                  <circle
                    cx="24"
                    cy="26"
                    r="7"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                </svg>
                <span>Фото объекта</span>
              </div>
            )}
            <Paper class="case-person">
              <span
                class="case-person-photo"
                style={`--portrait-zoom: ${caseItem.personPhotoZoom ?? 1}; --portrait-focus: ${caseItem.personPhotoFocus ?? "50% 50%"}; --portrait-position: ${caseItem.personPhotoPosition ?? "50% 50%"}`}
              >
                <img
                  src={caseItem.personPhoto}
                  width="50"
                  height="50"
                  alt={
                    caseItem.personPhotoStock
                      ? "Иллюстративное фото"
                      : `Фото клиента: ${caseItem.person}`
                  }
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <strong>{caseItem.person}</strong>
            </Paper>
          </div>
          <div class="case-details">
            <div class="case-object">
              <p>{siteText("client-cases.text.24")}</p>
              <h3>{caseItem.object}</h3>
            </div>
            {caseItem.result && (
              <Paper class="case-result" tapeNode="I1380:5213;569:1388">
                <p>{caseItem.result}</p>
                <img
                  class="case-quote"
                  src="/assets/cases-quote-mark.svg"
                  alt=""
                  width="26.0607"
                  height="20.4199"
                  loading="lazy"
                  decoding="async"
                />
              </Paper>
            )}
            <div class="case-columns">
              {[
                {
                  title: siteText("client-cases.title.25"),
                  items: caseItem.situation,
                },
                {
                  title: siteText("client-cases.title.26"),
                  items: caseItem.actions,
                },
              ].map((col, index) => (
                <div
                  class:list={[
                    "case-column",
                    { "case-column--actions": index === 1 },
                  ]}
                >
                  <h4>{col.title}</h4>
                  <ul class="bullet-list">
                    {col.items.map((item) => (
                      <li>
                        {item.endsWith(siteText("client-cases.text.27")) ? (
                          <>
                            {item.slice(
                              0,
                              -siteText("client-cases.text.27").length,
                            )}
                            <strong>{siteText("client-cases.text.27")}</strong>
                          </>
                        ) : (
                          item
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <div class="case-actions">
              <ConsultationButton
                label={siteText("client-cases.label.28")}
                subject={
                  caseItem.category === "sell"
                    ? "Консультация по продаже недвижимости"
                    : "Консультация по покупке недвижимости"
                }
              />
              <span></span>
              <CarouselControls
                prevLabel="Предыдущий кейс"
                nextLabel="Следующий кейс"
              />
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="cases-mobile-cta">
      <ConsultationButton
        label={siteText("client-cases.label.28")}
        subject="Консультация по продаже недвижимости"
      />
    </div>
    <p class="sr-only" data-case-status aria-live="polite">
      {"Кейс 1 из"} {cases.length}
    </p>
    <div class="cases-empty" data-case-empty hidden role="status">
      <figure class="cases-empty-polaroid">
        <img
          class="cases-empty-photo"
          src="/assets/cases/other-woman-wringing-rag.webp"
          width="1536"
          height="1024"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>(".client-cases").forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-case-slide]")];
    const previous = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-direction=prev]"),
    ];
    const next = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-direction=next]"),
    ];
    const status = root.querySelector<HTMLElement>("[data-case-status]")!;
    const mobile = matchMedia("(max-width: 767px)");
    let current = 0;
    let category = "sell";
    let categorySlides = slides.filter(
      (slide) => slide.dataset.category === category,
    );
    const content = root.querySelector<HTMLElement>("[data-case-content]")!;
    const empty = root.querySelector<HTMLElement>("[data-case-empty]")!;
    const scrollHint = root.querySelector<HTMLElement>(".mobile-scroll-hint")!;
    const mobileCta = root.querySelector<HTMLElement>(".cases-mobile-cta")!;
    const mobileButton = mobileCta.querySelector<HTMLElement>(".button")!;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let scrolling = false;
    let scrollFrame = 0;
    let ctaAnimation: Animation | null = null;
    let targetHeight: number | null = null;
    let initialized = false;
    let scrollSettleTimer: ReturnType<typeof setTimeout> | undefined;
    // offsetLeft не меняется во время прокрутки: кэшируем и сбрасываем
    // только при реальной смене раскладки (resize, смена категории).
    let offsetsValid = false;
    let contentOffsetLeft = 0;
    let slideOffsets: number[] = [];
    const invalidateCaseOffsets = () => {
      offsetsValid = false;
    };
    const measureCaseOffsets = () => {
      offsetsValid = true;
      contentOffsetLeft = content.offsetLeft;
      slideOffsets = categorySlides.map((slide) => slide.offsetLeft);
    };
    const fitActiveCase = (animateButton = false) => {
      // Do not move the CTA while the user is swiping between cards.
      if (scrolling) return;
      const active = categorySlides[current];
      if (!mobile.matches || !active) {
        ctaAnimation?.cancel();
        ctaAnimation = null;
        targetHeight = null;
        content.classList.remove("is-resizing");
        content.style.removeProperty("height");
        return;
      }
      const style = getComputedStyle(content);
      const height =
        active.getBoundingClientRect().height +
        parseFloat(style.paddingTop) +
        parseFloat(style.paddingBottom);
      if (ctaAnimation?.playState === "running" && targetHeight === height)
        return;
      const previousHeight = content.getBoundingClientRect().height;
      if (Math.abs(previousHeight - height) < 1) return;

      const animateCta =
        animateButton && !reduceMotion.matches && !mobileCta.hidden;
      // Preserve the current layout before cancelling a previous effect.
      content.style.height = `${previousHeight}px`;
      ctaAnimation?.cancel();
      ctaAnimation = null;
      targetHeight = height;
      content.classList.toggle("is-resizing", animateCta);

      if (animateCta) {
        content.classList.add("is-resizing");
        // Animate the layout itself so the button and everything below it
        // move together, including when a running animation is retargeted.
        ctaAnimation = content.animate(
          [{ height: `${previousHeight}px` }, { height: `${height}px` }],
          {
            duration: 320,
            fill: "both",
            easing: "cubic-bezier(0.4, 0, 0.2, 1)",
          },
        );
        const animation = ctaAnimation;
        animation.finished
          .then(() => {
            if (ctaAnimation !== animation) return;
            content.style.height = `${height}px`;
            animation.cancel();
            content.classList.remove("is-resizing");
            ctaAnimation = null;
          })
          .catch(() => {
            // Retargeting cancels the previous animation.
          });
      } else {
        content.style.height = `${height}px`;
      }
    };
    const caseResize = new ResizeObserver(() => {
      invalidateCaseOffsets();
      // A late size change must continue from the CTA's visible position.
      fitActiveCase(initialized);
    });
    slides.forEach((slide) => caseResize.observe(slide));

    const updateCase = (index: number, focusedButton?: HTMLButtonElement) => {
      current = Math.max(0, Math.min(index, categorySlides.length - 1));
      content.hidden = categorySlides.length === 0;
      mobileCta.hidden = categorySlides.length === 0;
      mobileButton.dataset.subject =
        category === "sell"
          ? "Консультация по продаже недвижимости"
          : "Консультация по покупке недвижимости";
      scrollHint.hidden = categorySlides.length <= 1;
      empty.hidden = categorySlides.length !== 0;
      empty.classList.toggle("is-other", category === "other");
      slides.forEach((slide) => {
        const active = slide === categorySlides[current];
        slide.classList.toggle("is-active", active);
        const included = categorySlides.includes(slide);
        slide.classList.toggle("is-in-category", included);
        slide.setAttribute(
          "aria-hidden",
          String(mobile.matches ? !included : !active),
        );
        slide.inert = mobile.matches ? !included : !active;
      });
      fitActiveCase(initialized);
      initialized = true;
      const previousDisabled = current === 0 || categorySlides.length <= 1;
      const nextDisabled =
        current === categorySlides.length - 1 || categorySlides.length <= 1;
      previous.forEach((button) => {
        button.disabled = previousDisabled;
        button.setAttribute("aria-disabled", String(previousDisabled));
      });
      next.forEach((button) => {
        button.disabled = nextDisabled;
        button.setAttribute("aria-disabled", String(nextDisabled));
      });
      status.textContent = categorySlides.length
        ? `Кейс ${current + 1} из ${categorySlides.length}`
        : "В этой категории пока нет кейсов";

      if (focusedButton && document.activeElement === focusedButton) {
        const direction = focusedButton.dataset.direction!;
        const replacement = categorySlides[
          current
        ].querySelector<HTMLButtonElement>(`[data-direction=${direction}]`)!;
        const sibling = categorySlides[
          current
        ].querySelector<HTMLButtonElement>(
          `[data-direction=${direction === "prev" ? "next" : "prev"}]`,
        )!;
        (replacement.disabled ? sibling : replacement).focus();
      }
    };

    previous.forEach((button) =>
      button.addEventListener("click", () => updateCase(current - 1, button)),
    );
    next.forEach((button) =>
      button.addEventListener("click", () => updateCase(current + 1, button)),
    );
    updateCase(0);
    mobile.addEventListener("change", () => {
      scrolling = false;
      clearTimeout(scrollSettleTimer);
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      invalidateCaseOffsets();
      updateCase(current);
      content.scrollLeft = 0;
    });
    const syncScrolledCase = () => {
      if (!mobile.matches || !categorySlides.length) return;
      if (!offsetsValid) measureCaseOffsets();
      const scrollLeft = content.scrollLeft - contentOffsetLeft;
      const nearest = categorySlides.reduce(
        (best, slide, index) =>
          Math.abs(slideOffsets[index] - scrollLeft) <
          Math.abs(slideOffsets[best] - scrollLeft)
            ? index
            : best,
        0,
      );
      if (nearest !== current) {
        current = nearest;
        status.textContent = `Кейс ${current + 1} из ${categorySlides.length}`;
      }
    };
    const finishScroll = () => {
      if (!scrolling) return;
      clearTimeout(scrollSettleTimer);
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      scrolling = false;
      syncScrolledCase();
      fitActiveCase(true);
    };
    content.addEventListener(
      "scroll",
      () => {
        if (!mobile.matches || !categorySlides.length) return;
        scrolling = true;
        if (!scrollFrame) {
          scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            syncScrolledCase();
          });
        }
        // Safari versions without scrollend still settle after scrolling stops.
        // 350 ms: у iOS momentum паузы между scroll-событиями бывают >200 ms,
        // finishScroll в середине инерции дёргал высоту контейнера.
        clearTimeout(scrollSettleTimer);
        scrollSettleTimer = setTimeout(finishScroll, 350);
      },
      { passive: true },
    );
    content.addEventListener("scrollend", finishScroll);

    addEventListener("resize", invalidateCaseOffsets, { passive: true });
    root.addEventListener("choice-change", (event) => {
      scrolling = false;
      clearTimeout(scrollSettleTimer);
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      invalidateCaseOffsets();
      const value = (event as CustomEvent<{ value: string }>).detail.value;
      const tabs = [
        ...root.querySelectorAll<HTMLElement>(
          ".cases-tabs [data-choice-group] button",
        ),
      ];
      category =
        ["sell", "buy", "other"][
          tabs.findIndex((tab) => tab.dataset.value === value)
        ] ?? "other";
      categorySlides = slides.filter(
        (slide) => slide.dataset.category === category,
      );
      updateCase(0);
      content.scrollLeft = 0;
    });
  });
</script>
