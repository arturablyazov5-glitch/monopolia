---
import { siteText } from "../data/site-texts.mjs";
// По умолчанию — простая таблица UI kit (да / нет / текст).
// variant="risk" — сравнение «Самостоятельно / С риелтором» со шкалой риска
// (Figma 1380:6987 «Покупка»; тот же мастер 785:7925 на «Продаже»).
import "../styles/comparison-risk.css";
import RiskMeter from "./RiskMeter.astro";

interface Row {
  label: string;
  ours: boolean | string;
  others: boolean | string;
  /** Шкала риска 1–5 для variant="risk" */
  risk?: number;
  node?: string;
}
interface Props {
  rows: Row[];
  caption?: string;
  variant?: "default" | "risk";
  /** Заголовки колонок для variant="risk": [без нас, с нами] */
  columns?: [string, string];
  icons?: [string, string];
}
const {
  rows,
  caption = "Сравнение вариантов",
  variant = "default",
  columns = [siteText("comparison-table.columns.1"), siteText("comparison-table.columns.2")],
  icons = ["/assets/icon-comparison-cross.svg", "/assets/icon-comparison-check.svg"],
} = Astro.props;

---

{variant === "risk" ? (
  <table role="table" class="comparison-risk" data-node-id="1380:6987">
    <caption class="sr-only">{caption}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <td />
        {columns.map((label, index) => (
          <th scope="col" class:list={{ "comparison-risk-ours": index === 1 }}>
            <span class="comparison-risk-column-label">
              <img src={icons[index]} width="18" height="18" alt="" decoding="async" />
              <span>{label}</span>
            </span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((row) => (
        <tr role="row" data-node-id={row.node}>
          <th scope="row">
            <span class="comparison-risk-label">{row.label}</span>
            {row.risk && (
              <span class="comparison-risk-level">
                {siteText("comparison-table.text.3")}
                <RiskMeter value={row.risk} />
              </span>
            )}
          </th>
          {[row.others, row.ours].map((value, index) => (
            <td
              role="cell"
              class:list={{ "comparison-risk-ours": index === 1 }}
            >
              <span class="comparison-risk-cell">
                <img
                  loading="lazy"
                  src={icons[index]}
                  width="20"
                  height="20"
                  alt={index === 1 ? "Плюс" : "Минус"}
                  decoding="async"
                />
                {value}
              </span>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
) : (
  <div class="comparison-wrap">
    <table class="comparison" data-node-id="1380:6996">
      <caption>{caption}</caption>
      <thead role="rowgroup">
        <tr>
          <th scope="col">Услуга</th>
          <th scope="col">{"С Монополией"}</th>
          <th scope="col">{siteText("comparison-table.columns.1")}</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {[row.ours, row.others].map((value) => (
              <td>
                {typeof value === "boolean" ? (
                  <img
                    loading="lazy"
                    src={"/assets/" + (value ? "icon-comparison-check.svg" : "icon-comparison-cross.svg")}
                    alt={value ? "Да" : "Нет"}
                    width="24"
                    height="24"
                    decoding="async"
                  />
                ) : (
                  value
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
