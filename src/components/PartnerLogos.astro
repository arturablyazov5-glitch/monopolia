---
import { imageSize } from "../lib/image-size";
// etalonIndex — позиция плашки «Эталон» в ряду (по умолчанию в конце, как в UI kit).
// На «Покупке» (1380:6392) она восьмая: etalonIndex={7}.
const { home = false, etalonIndex } = Astro.props;
const homeLogos = [
  ["partner-rosgosstrakh-home.svg", 243, -1.58, "Росгосстрах"],
  ["partner-ingosstrakh-home.svg", 253, -1.59, "Ингосстрах"],
  ["partner-glorax-home.svg", 180, -1.584, "GloraX"],
  ["partner-pik-home.svg", 132, -1.676, "ПИК"],
  ["partner-lsr-home.svg", 149, -1.594, "ЛСР"],
  ["partner-sodruzhestvo-home.svg", 285, -1.653, "Содружество"],
  ["partner-setlgroup-home.svg", 174, -1.583, "SetlGroup"],
  ["partner-etalon-home.svg", 200.367, 0, "Эталон"],
  ["partner-brusnika-home.svg", 238, -1.594, "Брусника"],
  ["partner-dom-rf-home.svg", 96, -2.256, "ДОМ.РФ"],
];
const logos = [
  ["partner-rosgosstrakh.svg", 175.5, 5.23, 4.64],
  ["partner-ingosstrakh.svg", 182.722, 5.03, 4.46],
  ["partner-glorax.svg", 130, 7.29, 6.27],
  ["partner-pik.svg", 95.333, 10.33, 8.61],
  ["partner-lsr.svg", 107.611, 9.15, 7.57],
  ["partner-sodruzhestvo.svg", 164.988, 5.7, 4.94],
  ["partner-setlgroup.svg", 125.667, 7.55, 6.48],
  ["partner-brusnika.svg", 171.889, 5.41, 4.74],
  ["partner-dom-rf.svg", 69.333, 14.21, 12.45],
];
---

{home ? (
  <div class="home-partner-logos" role="group" aria-label="Логотипы партнёров">
    {homeLogos.map(([file, width, left, name]) => (
      <span
        class:list={[
          "home-partner-logo",
          { "home-partner-etalon": name === "Эталон" },
        ]}
        style={`width:${width}px;--asset-left:${left}px`}
      >
        <img
          src={"/assets/" + file}
          alt={String(name)}
          loading="lazy"
          width={imageSize("/assets/" + file).width}
          height={imageSize("/assets/" + file).height}
          decoding="async"
        />
      </span>
    ))}
  </div>
) : (
  <div
    class="partner-logos"
    data-node-id="1380:6392"
    role="group"
    aria-label="Логотипы партнёров"
  >
    {[
      ...logos.slice(0, etalonIndex ?? logos.length),
      null,
      ...logos.slice(etalonIndex ?? logos.length),
    ].map((logo) =>
      logo ? (
        <span
          class="partner-logo"
          style={`width:${logo[1]}px;--logo-left:-${logo[3]}%;--logo-right:-${logo[2]}%`}
        >
          <img
            src={"/assets/" + logo[0]}
            alt="Партнёр агентства"
            loading="lazy"
            width={imageSize("/assets/" + logo[0]).width}
            height={imageSize("/assets/" + logo[0]).height}
            decoding="async"
          />
        </span>
      ) : (
        <span class="partner-etalon">
          <img
            src="/assets/partner-etalon.svg"
            alt="Эталон"
            width="110"
            height="19"
            loading="lazy"
            decoding="async"
          />
        </span>
      ),
    )}
  </div>
)}
