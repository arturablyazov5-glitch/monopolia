---
import { siteText } from "../data/site-texts.mjs";
import { socialUrls } from "../data/social-links";
import Paper from "./Paper.astro";
import PersonLabel from "./PersonLabel.astro";
import TapeLayer from "./TapeLayer.astro";
import "../styles/home-telegram.css";
---

<section class="home-telegram" aria-labelledby="telegram-title">
  <img
    class="telegram-background"
    src="/assets/background-paper-team-section.webp"
    alt=""
    loading="lazy"
    width="2880"
    height="4375"
    decoding="async"
  />
  <div class="telegram-news-wrap">
    <Paper class="telegram-news">
      <div>
        <h2>
          {siteText("home-telegram.text.1")} <br />
          {siteText("home-telegram.text.2")}
        </h2>
        <p>{siteText("home-telegram.text.3")}</p>
      </div>
      <img
        class="telegram-news-person"
        src="/assets/telegram-news-person.webp"
        alt=""
        loading="lazy"
        width="724"
        height="482"
        decoding="async"
      />
    </Paper>
    <TapeLayer node="1380:5647" />
  </div>
  <div class="telegram-content">
    <div class="telegram-photo">
      <div class="telegram-photo-crop">
        <img
          class="telegram-shadow"
          src="/assets/telegram-person-shadow.svg"
          alt=""
          width="514.447"
          height="665.128"
          loading="lazy"
          decoding="async"
        />
        <img
          class="telegram-person person-photo"
          src="/assets/staff-ekaterina-korneeva-telegram.webp"
          alt="Екатерина Корнеева показывает Telegram на телефоне"
          loading="lazy"
          width="1630"
          height="3490"
          decoding="async"
        />
      </div>
      <PersonLabel
        class="telegram-signature"
        name="Екатерина Корнеева"
        role="Специалист по недвижимости"
      />
    </div>
    <div class="telegram-copy">
      <h2 id="telegram-title">{siteText("home-telegram.text.4")}</h2>
      <div class="telegram-benefits">
        <ul class="diamond-list bullet-list">
          <li>{siteText("home-telegram.text.5")}</li>
          <li>{siteText("home-telegram.text.6")}</li>
        </ul>
        <div class="telegram-divider column-divider" aria-hidden="true"></div>
        <ul class="diamond-list bullet-list">
          <li>{siteText("home-telegram.text.7")}</li>
          <li>{siteText("home-telegram.text.8")}</li>
        </ul>
      </div>
      <a
        class="button red telegram-subscribe"
        href={socialUrls.Telegram}
        target="_blank"
        rel="noopener noreferrer"
      >
        {siteText("home-telegram.text.9")}
        <img
          src="/assets/icon-external-link.svg"
          alt=""
          width="18.3777"
          height="18.4458"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>
