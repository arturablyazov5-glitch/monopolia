---
import Paper from "./Paper.astro";
import SpeechBubble from "./SpeechBubble.astro";
import "../styles/blockbuster-case.css";
---

<section
  class="blockbuster-case"
  aria-labelledby="blockbuster-title"
  data-node-id="1380:5599"
>
  <div class="blockbuster-scene" aria-hidden="true">
    <img
      src="/assets/47c7d.webp"
      srcset="/assets/47c7d-m.webp 1480w, /assets/47c7d.webp 3235w"
      sizes="(max-width: 767px) 740px, 3235px"
      width="1480"
      height="866.965"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="blockbuster-fade"></div>
    <img
      src="/assets/02199.webp"
      srcset="/assets/02199-m.webp 1480w, /assets/02199.webp 3235w"
      sizes="(max-width: 767px) 740px, 3235px"
      width="1480"
      height="866.965"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <img
    class="blockbuster-edge"
    src="/assets/aad8d.svg"
    alt=""
    width="1493.19"
    height="129.56"
    loading="lazy"
    decoding="async"
  />
  <div class="blockbuster-content">
    <Paper class="blockbuster-label">
      <p>Случай-блокбастер</p>
      <img
        src="/assets/55e7e.webp"
        width="50.667"
        height="15.3"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </Paper>
    <h2 id="blockbuster-title">
      Как чуть не сорвалась дистанционная продажа{" "}
      <br />
      дома, пока владельца не было в городе
    </h2>
    <p class="blockbuster-description">
      Наша беременная Саша сама перенесла забор, чтобы ускорить регистрацию и не
      ждать владельца. После подобных случаев нас часто называют
      дружочками-пирожочками
    </p>
    <SpeechBubble
      class="blockbuster-warning"
      side="right"
      tail="6e397.svg"
      text="У вас забор на 2 метра вышел за границы. Сделки НЕ БУДЕТ!!!!!"
    />
    <SpeechBubble
      class="blockbuster-reply"
      side="left"
      tail="ea997.svg"
      text="Спокойно, я прямо сейчас все перенесу"
    />
  </div>
</section>
