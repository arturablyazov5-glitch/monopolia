---
import { siteText } from "../data/site-texts.mjs";
import Paper from "./Paper.astro";
import SpeechBubble from "./SpeechBubble.astro";
import "../styles/blockbuster-case.css";
---

<section
  data-surface="dark"
  class="blockbuster-case"
  aria-labelledby="blockbuster-title"
  data-node-id="1380:5599"
>
  <div class="blockbuster-scene" aria-hidden="true">
    <img
      src="/assets/blockbuster-case-winter-sale.webp"
      width="1480"
      height="867"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <img
    class="blockbuster-edge"
    src="/assets/blockbuster-paper-edge.svg"
    alt=""
    width="1493.19"
    height="129.56"
    loading="lazy"
    decoding="async"
  />
  <div class="blockbuster-content">
    <Paper class="blockbuster-label" tapeNode="I1380:5602;569:1388">
      <p>{siteText("blockbuster-case.text.1")}</p>
    </Paper>
    <h2 id="blockbuster-title">
      {siteText("blockbuster-case.text.2")} <br />
      {siteText("blockbuster-case.text.3")}
    </h2>
    <p class="blockbuster-description">
      {siteText("blockbuster-case.text.4")}
    </p>
    <SpeechBubble
      class="blockbuster-warning"
      side="right"
      tail="blockbuster-warning-icon.svg"
      text={siteText("blockbuster-case.text.5")}
    />
    <SpeechBubble
      class="blockbuster-reply"
      side="left"
      tail="speech-tail-white-right.svg"
      text={siteText("blockbuster-case.text.6")}
    />
  </div>
</section>
