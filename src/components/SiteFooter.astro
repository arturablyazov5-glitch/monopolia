---
import { siteText } from "../data/site-texts.mjs";
import SocialLinks from "./SocialLinks.astro";
import PhoneAction from "./PhoneAction.astro";
import OfficeHours from "./OfficeHours.astro";
import "../styles/site-footer.css";
import { legal } from "../data/legal";
import { siteSections } from "../data/site-nav";

/**
 * Общий footer всех страниц — Figma 1380:5754 (главная),
 * instance 1380:6356 («Продажа») и 1380:7023 («Покупка»).
 * Соцсети без реальных адресов (SocialLinks без href), юридических
 * страниц пока нет — ссылки на документы показывают сообщение.
 */
interface Props {
  nav?: { label: string; href: string }[];
  home?: string;
  /** Совместимость с UI kit; документы в любом случае заглушки */
  demo?: boolean;
  node?: string;
}
const { nav = siteSections, home = "/", node = "1380:5754" } = Astro.props;
---

<footer data-surface="dark" class="site-footer" data-node-id={node}>
  <div class="footer-edge" aria-hidden="true">
    <img
      src="/assets/footer-background.svg"
      alt=""
      width="1440"
      height="99.2076"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="container footer-inner">
    <div class="footer-columns">
      <div class="footer-company">
        <a class="footer-brand" href={home} aria-label="Монополия — главная">
          <img
            src="/assets/logo-monopoly-mark-footer.svg"
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <div class="footer-brand-text">
            <img
              src="/assets/logo-monopoly-wordmark-footer.svg"
              alt="Монополия"
              width="201"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <p>{siteText("site-header.text.4")}</p>
          </div>
        </a>
        <div class="footer-legal">
          <p>{siteText("site-footer.text.1")}</p>
          <p>{siteText("site-footer.text.2")}</p>
          <p>{siteText("site-footer.text.3")}</p>
          <p>{siteText("site-footer.text.4")}</p>
        </div>
      </div>
      <div class="footer-navigation">
        <nav aria-label="Разделы сайта (подвал)">
          {nav.map((item) => (
            <a
              href={item.href}
              data-anchor={item.href.startsWith("/#") ? "" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="footer-policy">
          <div>
            <a
              class="footer-doc"
              href={legal.privacy.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="footer-doc-link">
                {siteText("site-footer.text.5")}
              </span>
            </a>
          </div>
          <div>
            <a
              class="footer-doc"
              href={legal.consent.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="footer-doc-link">
                {siteText("site-footer.text.6")}{" "}
                {siteText("site-footer.text.7")}
              </span>
            </a>
          </div>
        </div>
      </div>
      <div class="footer-contact">
        <div class="footer-contact-main">
          <div class="footer-phone-block">
            <PhoneAction variant="footer" />
            <OfficeHours />
          </div>
          <button
            class="email-chip"
            type="button"
            data-copy="anmonopoliya@mail.ru"
            aria-label="Скопировать почту anmonopoliya@mail.ru"
          >
            <img
              src="/assets/icon-copy-email.svg"
              alt=""
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <span class="email-chip-text">anmonopoliya@mail.ru</span>
          </button>
        </div>
        <div class="footer-social">
          <SocialLinks dark size={40} purpose="contact" />
          <p>
            {siteText("site-footer.text.10")}
            <br />
            {siteText("site-footer.text.11")}
          </p>
        </div>
        <div class="footer-subscribe">
          <div class="footer-social">
            <SocialLinks
              purpose="channel"
              dark
              size={40}
              links={[
                { label: "Telegram", icon: "social-telegram-dark.svg" },
                { label: "Instagram", icon: "social-instagram-dark.svg" },
              ]}
            />
            <p>
              {siteText("site-footer.text.12")}
              <br />
              {siteText("site-footer.text.13")}
            </p>
          </div>
          <small class="meta-note">{siteText("site-footer.text.14")}</small>
        </div>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <small>{siteText("site-footer.text.15")}</small>
    </div>
  </div>
</footer>
<script>
  document
    .querySelectorAll<HTMLButtonElement>(".email-chip")
    .forEach((chip) => {
      const text = chip.querySelector<HTMLElement>(".email-chip-text")!;
      const original = text.textContent!;
      let timer: number | undefined;
      chip.addEventListener("click", async () => {
        const value = chip.dataset.copy!;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          // Без Clipboard API (http, старые браузеры): выделяем во временном поле
          const field = document.createElement("textarea");
          field.value = value;
          field.style.position = "fixed";
          field.style.opacity = "0";
          document.body.append(field);
          field.select();
          document.execCommand("copy");
          field.remove();
        }
        // Ширина фиксируется, чтобы плашка не прыгала при смене текста
        chip.style.minWidth = `${chip.offsetWidth}px`;
        text.textContent = "Почта скопирована";
        chip.classList.add("copied");
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          text.textContent = original;
          chip.classList.remove("copied");
          chip.style.minWidth = "";
        }, 2000);
      });
    });
</script>
