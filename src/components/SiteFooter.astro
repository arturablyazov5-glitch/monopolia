---
import SocialLinks from "./SocialLinks.astro";
import "../styles/site-footer.css";

/**
 * Общий footer всех страниц — Figma 1380:5754 (главная),
 * instance 1380:6356 («Продажа») и 1380:7023 («Покупка»).
 * Соцсети без реальных адресов (SocialLinks без href), юридических
 * страниц пока нет — ссылки на документы показывают сообщение.
 */
interface Props {
  nav?: { label: string; href: string }[];
  /** Совместимость с UI kit; документы в любом случае заглушки */
  demo?: boolean;
  node?: string;
}
const {
  nav = [
    { label: "Купить недвижимость", href: "/buy/" },
    { label: "Продать недвижимость", href: "/sell/" },
    { label: "Кейсы", href: "/#cases" },
    { label: "Отзывы", href: "/#reviews" },
    { label: "Команда", href: "/#team" },
    { label: "Услуги", href: "/#services" },
    { label: "Для соискателей", href: "/#careers" },
    { label: "Вопрос‑ответ", href: "/#faq-title" },
  ],
  node = "1380:5754",
} = Astro.props;
---

<footer class="site-footer" data-node-id={node}>
  <div class="footer-edge" aria-hidden="true">
    <img
      src="/assets/8b38e.svg"
      alt=""
      width="1440"
      height="99.2076"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="container footer-inner">
    <div class="footer-columns">
      <div class="footer-company">
        <div class="footer-brand">
          <img
            src="/assets/bb79f.svg"
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <div class="footer-brand-text">
            <img
              src="/assets/12c8b.svg"
              alt="Монополия"
              width="201"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <p>Агентство недвижимости с 2006 года</p>
          </div>
        </div>
        <div class="footer-legal">
          <p>ИП Сиделина Елена Юрьевна</p>
          <p>ИНН: 280403620684</p>
          <p>ОГРНИП: 316280100058921</p>
          <p>
            Адрес: 676805, Амурская область, г. Белогорск, ул.&nbsp;Ленина,
            д.&nbsp;48
          </p>
        </div>
      </div>
      <div class="footer-navigation">
        <nav aria-label="Разделы сайта">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="footer-policy">
          <button type="button" class="footer-doc">
            <span class="footer-doc-link">Политика конфиденциальности</span>
          </button>
          <button type="button" class="footer-doc">
            Согласие на{" "}
            <span class="footer-doc-link">обработку персональных данных</span>
          </button>
          <p class="footer-doc-status" role="status" hidden>
            Документ будет опубликован позже.
          </p>
        </div>
      </div>
      <div class="footer-contact">
        <div class="footer-contact-main">
          <div class="footer-phone-block">
            <a class="footer-phone" href="tel:+79245804555">
              +7 (924) 580-45-55
            </a>
            <p>
              Пн‑Пт с 09:00 до 18:00
              <br />
              Сб с 10:00 до 15:00
            </p>
          </div>
          <a class="email-chip" href="mailto:anmonopoliya@mail.ru">
            <img
              src="/assets/decb5.svg"
              alt=""
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
            />
            anmonopoliya@mail.ru
          </a>
        </div>
        <div class="footer-social">
          <SocialLinks dark size={40} />
          <p>
            Свяжитесь
            <br />с нами
          </p>
        </div>
        <div class="footer-subscribe">
          <div class="footer-social">
            <SocialLinks
              dark
              size={40}
              links={[
                { label: "Telegram", icon: "84d6e.svg" },
                { label: "Instagram", icon: "c67f9.svg" },
              ]}
            />
            <p>
              Подписывайтесь
              <br />
              на наши соцсети
            </p>
          </div>
          <small class="meta-note">
            Meta Platforms Inc. признана экстремистской организацией в России
          </small>
        </div>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <small>© Все права защищены, 2026</small>
      <a class="footer-up" href="#top" aria-label="Наверх">
        <img
          src="/assets/d90d7.svg"
          alt=""
          width="46.1101"
          height="47.4575"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>
<script>
  document.querySelectorAll<HTMLElement>(".footer-policy").forEach((box) => {
    const status = box.querySelector<HTMLElement>(".footer-doc-status")!;
    box.querySelectorAll(".footer-doc").forEach((button) =>
      button.addEventListener("click", () => {
        status.hidden = false;
      }),
    );
  });
</script>
