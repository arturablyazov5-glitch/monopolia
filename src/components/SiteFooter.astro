---
import SocialLinks from "./SocialLinks.astro";
import "../styles/site-footer.css";
import { legal } from "../data/legal";
import { siteSections } from "../data/site-nav";

/**
 * Общий footer всех страниц — Figma 1380:5754 (главная),
 * instance 1380:6356 («Продажа») и 1380:7023 («Покупка»).
 * Соцсети без реальных адресов (SocialLinks без href), юридических
 * страниц пока нет — ссылки на документы показывают сообщение.
 */
interface Props {
  nav?: { label: string; href: string }[];
  home?: string;
  /** Совместимость с UI kit; документы в любом случае заглушки */
  demo?: boolean;
  node?: string;
}
const {
  nav = siteSections,
  home = "/",
  node = "1380:5754",
} = Astro.props;
---

<footer class="site-footer" data-node-id={node}>
  <div class="footer-edge" aria-hidden="true">
    <img
      src="/assets/8b38e.svg"
      alt=""
      width="1440"
      height="99.2076"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="container footer-inner">
    <div class="footer-columns">
      <div class="footer-company">
        <a class="footer-brand" href={home} aria-label="Монополия — главная">
          <img
            src="/assets/bb79f.svg"
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <div class="footer-brand-text">
            <img
              src="/assets/12c8b.svg"
              alt="Монополия"
              width="201"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <p>Агентство недвижимости с 2006 года</p>
          </div>
        </a>
        <div class="footer-legal">
          <p>ИП Сиделина Елена Юрьевна</p>
          <p>ИНН: 280403620684</p>
          <p>ОГРНИП: 316280100058921</p>
          <p>
            Адрес: 676805, Амурская область, г. Белогорск, ул. Ленина, д. 48
          </p>
        </div>
      </div>
      <div class="footer-navigation">
        <nav aria-label="Разделы сайта (подвал)">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="footer-policy">
          <a class="footer-doc" href={legal.privacy.href}>
            <span class="footer-doc-link">Политика конфиденциальности</span>
          </a>
          <a class="footer-doc" href={legal.consent.href}>
            Согласие на{" "}
            <span class="footer-doc-link">обработку персональных данных</span>
          </a>
        </div>
      </div>
      <div class="footer-contact">
        <div class="footer-contact-main">
          <div class="footer-phone-block">
            <a class="footer-phone" href="tel:+79245804555">
              +7 (924) 580-45-55
            </a>
            <p>
              Пн‑Пт с 09:00 до 18:00
              <br />
              Сб с 10:00 до 15:00
            </p>
          </div>
          <button
            class="email-chip"
            type="button"
            data-copy="anmonopoliya@mail.ru"
            aria-label="Скопировать почту anmonopoliya@mail.ru"
          >
            <img
              src="/assets/decb5.svg"
              alt=""
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <span class="email-chip-text">anmonopoliya@mail.ru</span>
          </button>
        </div>
        <div class="footer-social">
          <SocialLinks dark size={40} />
          <p>
            Свяжитесь
            <br />с нами
          </p>
        </div>
        <div class="footer-subscribe">
          <div class="footer-social">
            <SocialLinks
              dark
              size={40}
              links={[
                { label: "Telegram", icon: "84d6e.svg" },
                { label: "Instagram", icon: "c67f9.svg" },
              ]}
            />
            <p>
              Подписывайтесь
              <br />
              на наши соцсети
            </p>
          </div>
          <small class="meta-note">
            Meta Platforms Inc. признана экстремистской организацией в России
          </small>
        </div>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <small>© Все права защищены, 2026</small>
      <a class="footer-up" href="#top" aria-label="Наверх">
        <img
          src="/assets/d90d7.svg"
          alt=""
          width="46.1101"
          height="47.4575"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>
<script>
  document.querySelectorAll<HTMLButtonElement>(".email-chip").forEach((chip) => {
    const text = chip.querySelector<HTMLElement>(".email-chip-text")!;
    const original = text.textContent!;
    let timer: number | undefined;
    chip.addEventListener("click", async () => {
      const value = chip.dataset.copy!;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        // Без Clipboard API (http, старые браузеры): выделяем во временном поле
        const field = document.createElement("textarea");
        field.value = value;
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.append(field);
        field.select();
        document.execCommand("copy");
        field.remove();
      }
      // Ширина фиксируется, чтобы плашка не прыгала при смене текста
      chip.style.minWidth = `${chip.offsetWidth}px`;
      text.textContent = "Почта скопирована";
      chip.classList.add("copied");
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        text.textContent = original;
        chip.classList.remove("copied");
        chip.style.minWidth = "";
      }, 2000);
    });
  });
</script>
