---
import { siteText } from "../data/site-texts.mjs";
import ScrollHint from "./ScrollHint.astro";
import ServiceCard from "./ServiceCard.astro";
import "../styles/home-services.css";

const services = [
  {
    node: "1380:5682",
    tilt: -1,
    title: siteText("home-services.title.1"),
    description: siteText("home-services.description.2"),
  },
  {
    node: "1380:5683",
    tilt: 2,
    title: siteText("home-services.title.3"),
    description: siteText("home-services.description.4"),
  },
  {
    node: "1380:5684",
    tilt: -1,
    title: siteText("home-services.title.5"),
    description: siteText("home-services.description.6"),
  },
  {
    node: "1380:5685",
    tilt: 1,
    title: siteText("home-services.title.7"),
    description: siteText("home-services.description.8"),
  },
  {
    node: "1380:5686",
    tilt: -1,
    title: siteText("home-services.title.9"),
    description: siteText("home-services.description.10"),
  },
  {
    node: "1380:5687",
    tilt: 2,
    title: siteText("home-services.title.11"),
    description: siteText("home-services.description.12"),
  },
  {
    node: "1380:5688",
    tilt: 2,
    title: siteText("home-services.title.13"),
    description: siteText("home-services.description.14"),
  },
  {
    node: "1380:5689",
    tilt: -2,
    title: siteText("home-services.title.15"),
    description: siteText("home-services.description.16"),
  },
  {
    node: "1380:5690",
    tilt: 1,
    title: siteText("home-services.title.17"),
    description: siteText("home-services.description.18"),
  },
];
---

<section
  id="services"
  class="home-services"
  aria-labelledby="services-title"
  data-node-id="1380:5678"
>
  <div class="services-heading">
    <h2 id="services-title">{siteText("home-services.text.19")}</h2>
    <p>{siteText("home-services.text.20")}</p>
  </div>
  <ScrollHint class="services-scroll-hint" />
  <div
    class="services-grid"
    role="region"
    aria-label="Услуги компании"
    tabindex="0"
  >
    {services.map(({ tilt, ...service }) => (
      <div
        class="services-slot"
        style={`--service-tilt: ${tilt}deg; --service-overhang: ${(180 * Math.sin((Math.abs(tilt) * Math.PI) / 180)).toFixed(2)}px`}
      >
        <ServiceCard variant="coupon" {...service} />
      </div>
    ))}
  </div>
</section>
