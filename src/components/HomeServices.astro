---
import ServiceCard from "./ServiceCard.astro";
import "../styles/home-services.css";

const services = [
  {
    node: "1380:5682",
    tilt: -1,
    title: "Помощь в одобрении ипотеки с вероятностью 91%",
    description:
      "Подберем выгодную программу. Поможем собрать документы и подать заявки в банк",
  },
  {
    node: "1380:5683",
    tilt: 2,
    title: "Оформление сделки купли‑продажи",
    description:
      "Проверим документы, проконтролируем процесс и доведем сделку до регистрации в Росреестре",
  },
  {
    node: "1380:5684",
    tilt: -1,
    title: "Юридическая проверка объекта или собственника",
    description:
      "Проверяем риски на объекте: ограничения, долги, аресты, судебные споры и историю собственников",
  },
  {
    node: "1380:5685",
    tilt: 1,
    title: "Оформление всех документов",
    description:
      "Поможем оформить наследство, приватизацию, право собственности, перепланировку, реконструкцию и т. д.",
  },
  {
    node: "1380:5686",
    tilt: -1,
    title: "Оценка недвижимости",
    description:
      "Сравним объект с аналогичными в том же районе, определим рыночную стоимость, позицию в рейтинге предложений и срок продажи",
  },
  {
    node: "1380:5687",
    tilt: 2,
    title: "Налоговое сопровождение",
    description:
      "Рассчитаем сумму налогов, поможем оформить 3‑НДФЛ и получить налоговый вычет до 13% стоимости недвижимости",
  },
  {
    node: "1380:5688",
    tilt: 2,
    title: "Подготовка объекта к заселению",
    description:
      "Подберем проверенных подрядчиков по ремонту, оформлению интерьера и клинингу. При необходимости поможем с переездом",
  },
  {
    node: "1380:5689",
    tilt: -2,
    title: "Аренда недвижимости",
    description:
      "Подберем проверенных арендаторов или подходящие объекты для сдачи в аренду. Сопроводим сделку до подписания договора",
  },
  {
    node: "1380:5690",
    tilt: 1,
    title: "Страхование",
    description:
      "Поможем застраховать объект недвижимости, автомобиль и личные риски, включая несчастные случаи",
  },
];
---

<section
  id="services"
  class="home-services"
  aria-labelledby="services-title"
  data-node-id="1380:5678"
>
  <div class="services-heading">
    <h2 id="services-title">
      Один визит к нам вместо часовых очередей в разных кабинетах
    </h2>
    <p>Все вопросы решаем в одном окне — от подбора ипотеки до приватизации</p>
  </div>
  <div class="services-grid">
    {services.map(({ tilt, ...service }) => (
      <div
        class="services-slot"
        style={`--service-tilt: ${tilt}deg; --service-overhang: ${(180 * Math.sin((Math.abs(tilt) * Math.PI) / 180)).toFixed(2)}px`}
      >
        <ServiceCard variant="coupon" {...service} />
      </div>
    ))}
  </div>
</section>
