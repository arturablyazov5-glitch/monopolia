---
import "../styles/contact-fields.css";
interface Props {
  id: string;
  class?: string;
  "aria-describedby"?: string;
}
const { id, class: className, "aria-describedby": describedBy } = Astro.props;
---

<input
  class:list={["phone-field", "brush-stroke", className]}
  id={id}
  name="phone"
  type="tel"
  maxlength="18"
  inputmode="tel"
  autocomplete="tel"
  placeholder="+7 (999) 999-99-99"
  aria-describedby={describedBy}
  required
/>
