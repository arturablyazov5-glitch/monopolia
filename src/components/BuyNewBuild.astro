---
// Figma 1380:6553 (Mask group — красный разделитель) + 1380:6554 (блок «05»):
// бесплатный подбор новостройки, комиссия 0%.
import Paper from "./Paper.astro";
import Button from "./Button.astro";
import "../styles/buy-new-build.css";
---

<section
  class="buy-new-build"
  aria-labelledby="buy-new-build-title"
  data-node-id="1380:6554"
>
  <span
    class="buy-new-build-divider"
    aria-hidden="true"
    data-node-id="1380:6553"
  ></span>
  <Paper class="buy-new-build-card" node="1380:6554">
    <h2 id="buy-new-build-title">
      Бесплатно подберем и поможем с покупкой новостройки
    </h2>
    <p>
      А также поможем доработать заявку на ипотеку и подадим ее в банк, чтобы повысить шанс одобрения. Комиссию агентства за вас оплатит застройщик
    </p>
    <Button
      label="Хочу купить новостройку"
      subject="Подбор новостройки, комиссия 0%"
    />
    <div class="buy-new-build-note-wrap">
      <Paper class="buy-new-build-note" tapeNode="I1380:6559;569:1388" node="1380:6559">
        <p>
          Комиссия — <strong>0%</strong>
        </p>
      </Paper>
    </div>
  </Paper>
</section>
