---
import SocialLinks from "./SocialLinks.astro";
import { cities as defaultCities } from "../data/cities";
import Button from "./Button.astro";
import { siteSections } from "../data/site-nav";
interface Props {
  variant?: "site" | "admin";
  nav?: { label: string; href: string }[];
  home?: string;
  city?: string;
  cities?: string[];
  desktop?: boolean;
  socialLinks?: { label: string; icon: string; href?: string }[];
}
const {
  variant = "site",
  nav = [
    { label: "Хочу продать", href: "/sell/" },
    { label: "Хочу купить", href: "/buy/" },
    { label: "Кейсы", href: "/#cases" },
  ],
  home = "/",
  city = "Белогорск",
  desktop = true,
  cities = defaultCities,
  socialLinks = [
    { label: "Telegram", icon: "2dc32.svg" },
    { label: "MAX", icon: "0a072.svg" },
  ],
} = Astro.props;
---

<header
  class:list={["site-header", { desktop: desktop, "admin-site-header": variant === "admin" }]}
  data-node-id="1380:4922"
>
  <a class="brand" href={home} aria-label="Монополия — главная">
    <img
      src="/assets/a2665.svg"
      width="32"
      height="32"
      alt=""
      loading="eager"
      decoding="async"
    />
    <div class="brand-text">
      <img
        src="/assets/027b4.svg"
        width="131"
        height="13"
        alt="Монополия"
        loading="eager"
        decoding="async"
      />
      <span class="tagline">Агентство недвижимости с 2006 года</span>
    </div>
  </a>
  {variant === "admin" ? <><span class="admin-header-label">Админка</span><button id="logout" class="admin-text-button admin-logout" type="button" hidden>Выйти</button></> : <>
  <div class="city-picker" data-city-picker>
    <button
      type="button"
      class="city"
      data-city-toggle
      aria-haspopup="listbox"
      aria-expanded="false"
    >
      <img
        src="/assets/20afe.svg"
        width="10"
        height="13"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span data-city-label>{city}</span>
      <img
        class="city-chevron"
        src="/assets/98485.svg"
        width="5"
        height="3"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </button>
    <ul class="city-menu" role="listbox" aria-label="Город" hidden>
      {cities.map((c) => (
        <li role="option" aria-selected={c === city} tabindex="-1" data-city-option={c}>
          {c}
        </li>
      ))}
    </ul>
  </div>
  <nav aria-label="Разделы сайта">
    {nav.map((item) => (
      <a href={item.href}>
        {item.label}
        {item.label === "Кейсы" && (
          <img
            class="nav-marker"
            src="/assets/febb1.svg"
            alt=""
            width="5"
            height="5"
            loading="lazy"
            decoding="async"
          />
        )}
      </a>
    ))}
  </nav>
  <div class="header-right">
    <div class="header-contact">
      <div class="header-social">
        <SocialLinks loading="lazy" links={socialLinks} />
      </div>
      <div class="header-phone">
        <a href="tel:+79245804555">+7 (924) 580-45-55</a>
        <small class="office-status">
          <span class="time" data-office-status>Пн‑Пт 09:00–18:00</span>
        </small>
      </div>
    </div>
    <!-- Адаптив: звонок одним касанием на телефоне; на десктопе скрыто -->
    <a
      class="header-call"
      href="tel:+79245804555"
      aria-label="Позвонить: +7 (924) 580-45-55"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
        ></path>
      </svg>
    </a>
    <button
      type="button"
      class="menu-button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="site-menu-panel"
    >
      <img
        src="/assets/63228.svg"
        fetchpriority="low"
        alt=""
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <svg class="menu-close" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="4" y="5" width="25" height="24" fill="#D52D2D"></rect>
        <path d="M10 10l12 12M22 10L10 22" stroke="#fff" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <!-- Меню сайта: выпадающая панель под бургером на всех ширинах.
       Не <nav>: правила шапки `.site-header nav` относятся к inline-навигации. -->
  <div class="menu-panel-shadow">
  <div
    class="menu-panel brush-stroke"
    id="site-menu-panel"
    role="navigation"
    aria-label="Все разделы сайта"
    hidden
  >
    <ul>
      {siteSections.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <div class="menu-panel-actions">
      <Button label="Оставить заявку" loading="lazy" />
      <a class="menu-panel-phone" href="tel:+79245804555">+7 (924) 580-45-55</a>
    </div>
  </div>
  </div>
  </>}
</header>
{variant !== "admin" && <script>
  import { initCityPickers } from "../lib/city-picker";
  initCityPickers();
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const officeStatus = header.querySelector<HTMLElement>(
      "[data-office-status]",
    );
    if (officeStatus) {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Yakutsk",
        weekday: "short",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      }).formatToParts(new Date());
      const part = (key: string) =>
        parts.find((p) => p.type === key)?.value ?? "";
      const day = part("weekday");
      const minutes = Number(part("hour")) * 60 + Number(part("minute"));
      const open =
        day === "Sat"
          ? minutes >= 600 && minutes < 900
          : day !== "Sun" && minutes >= 540 && minutes < 1080;
      officeStatus.textContent = open ? "Сейчас работаем" : "Сейчас закрыто";
      header.querySelector(".office-status")?.classList.toggle("closed", !open);
    }
    if (header.classList.contains("admin-site-header")) return;
    const menu = header.querySelector<HTMLButtonElement>(".menu-button")!;
    const panel = header.querySelector<HTMLElement>(".menu-panel")!;
    const setOpen = (open: boolean) => {
      menu.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-label", open ? "Закрыть меню" : "Открыть меню");
      header.classList.toggle("menu-open", open);
      panel.hidden = !open;
    };
    menu.addEventListener("click", (e) => {
      const open = menu.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      // a11y: при открытии с клавиатуры (detail 0) фокус — на первый пункт
      if (open && e.detail === 0)
        panel.querySelector<HTMLElement>("a")?.focus();
    });
    // a11y: фокус ушёл из шапки (Tab дальше последнего пункта) — меню закрывается
    header.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (
        header.classList.contains("menu-open") &&
        next &&
        !header.contains(next)
      )
        setOpen(false);
    });
    // переход по разделу или открытие формы закрывают меню
    panel
      .querySelectorAll("a, [data-lead]")
      .forEach((a) => a.addEventListener("click", () => setOpen(false)));
    // клик/тап вне шапки закрывает открытое меню
    document.addEventListener("click", (e) => {
      if (
        header.classList.contains("menu-open") &&
        !header.contains(e.target as Node)
      )
        setOpen(false);
    });
    // a11y: бургер управляет панелью (aria-controls); Escape закрывает меню,
    // где бы ни был фокус, и возвращает фокус на бургер.
    panel.id = `site-menu-panel-${[...document.querySelectorAll(".site-header")].indexOf(header)}`;
    menu.setAttribute("aria-controls", panel.id);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.classList.contains("menu-open")) {
        setOpen(false);
        menu.focus();
      }
    });
  });
</script>}
