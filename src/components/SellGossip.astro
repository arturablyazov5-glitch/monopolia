---
// «Продажа», Figma 1380:5760: сцена с соседками и агентами, два речевых облака.
import SpeechBubble from "./SpeechBubble.astro";
import "../styles/sell-gossip.css";
---

<section
  class="sell-gossip"
  aria-label="Соседи обсуждают цену квартиры"
  data-node-id="1380:5760"
>
  <img
    class="sell-gossip-edge"
    src="/assets/7b038.svg"
    alt=""
    width="1440"
    height="51.5"
    loading="eager"
    decoding="async"
  />
  <picture style="display:contents">
    {/* ≤ 767 px: левая часть кадра (соседки) в высоте исходника — 2× показа. */}
    <source
      media="(max-width: 767px)"
      srcset="/assets/1eb75-r2-m.webp"
      style="display:none"
    />
    <img
      class="sell-gossip-photo"
      src="/assets/1eb75.webp"
      alt="Пожилые соседки на лавочке и два специалиста Монополии на прогулке"
      width="1440"
      height="703.806"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="sell-gossip-content">
    <SpeechBubble
      class="sell-gossip-rumor"
      loading="eager"
      side="left"
      tail="3b04c.svg"
      text={
        "Клава, ты слыхала? Васька за квартиру\nпросит годовой бюджет Белогорска"
      }
    />
    <SpeechBubble
      class="sell-gossip-reply"
      side="right"
      tail="c8148.svg"
      text={"Да не слушай их.\nПусть Монополия\nоценит твою квартиру"}
    />
  </div>
</section>
