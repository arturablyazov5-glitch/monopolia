---
import "../styles/global.css";
import LeadDialog from "../components/LeadDialog.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteUrl } from "../lib/seo";
const pageSeo: Record<string, { title: string; description: string }> = {
  "/": {
    title: "Монополия — агентство недвижимости в Белогорске с 2006 года",
    description:
      "Поможем выгодно купить или срочно продать квартиру, дом или коммерческую недвижимость. Монополия — агентство недвижимости в Белогорске с 2006 года.",
  },
  "/sell/": {
    title: "Продажа недвижимости в Белогорске — Монополия",
    description:
      "Продадим вашу недвижимость за 2 недели по рыночной цене или выше. В нашей базе 1 500+ покупателей с одобренной ипотекой или наличкой.",
  },
  "/buy/": {
    title: "Покупка недвижимости в Белогорске — Монополия",
    description:
      "800+ проверенных объектов недвижимости, которых нет на Авито и Циан. За 5 дней поможем купить объект по цене ниже рынка и получить одобрение по ипотеке.",
  },
};
const pathname = Astro.url.pathname.replace(/\/?$/, "/");
const seo = pageSeo[pathname];
// footer по умолчанию выводится на страницах сайта (с header);
// UI kit вызывает SiteFooter сам со своими ссылками.
const {
  title = "Монополия",
  noindex = false,
  header = false,
  footer = header,
} = Astro.props;
const pageTitle = seo?.title ?? title;
const description = seo?.description;
const preventIndexing = noindex || pathname === "/ui-kit/";
const canonical =
  Astro.site && !preventIndexing ? siteUrl(pathname, Astro.site) : undefined;
const imagePath = "/seo/team-1200x630.jpg";
const socialImage = Astro.site ? siteUrl(imagePath, Astro.site) : imagePath;
const imageAlt = "Специалисты агентства недвижимости Монополия";
// Контакты и часы сверены с SiteFooter; неподтверждённых рейтингов,
// геокоординат, внешних профилей и будущего офиса здесь нет.
const business = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Монополия",
  telephone: "+7 (924) 580-45-55",
  email: "anmonopoliya@mail.ru",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ул. Ленина, д. 48",
    addressLocality: "Белогорск",
    addressRegion: "Амурская область",
    postalCode: "676805",
    addressCountry: "RU",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "10:00",
      closes: "15:00",
    },
  ],
  ...(Astro.site && {
    "@id": `${siteUrl("/", Astro.site)}#agency`,
    url: siteUrl("/", Astro.site),
    image: socialImage,
  }),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#ededed" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {seo && !preventIndexing && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="ru_RU" />
        <meta property="og:site_name" content="Монополия" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <script
          type="application/ld+json"
          set:html={JSON.stringify(business).replace(/</g, "\\u003c")}
        />
      </>
    )}
    <link
      rel="preload"
      href="/fonts/calibri.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preventIndexing && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link
      rel="preload"
      href="/fonts/forma.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body id="top">
    {header && (
      <div class="fixed-site-header">
        <SiteHeader />
      </div>
    )}
    <slot />
    {footer && <SiteFooter />}
    <LeadDialog />
  </body>
</html>
