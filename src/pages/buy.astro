---
import { siteText } from "../data/site-texts.mjs";
import SiteLayout from "../layouts/SiteLayout.astro";
import InnerHero from "../components/InnerHero.astro";
import BuyMortgage from "../components/BuyMortgage.astro";
import BuyClosedBase from "../components/BuyClosedBase.astro";
import BuyNewBuild from "../components/BuyNewBuild.astro";
import OfficeConsultation from "../components/OfficeConsultation.astro";
import TrustAndViewing from "../components/TrustAndViewing.astro";
import FaqSection from "../components/FaqSection.astro";
import LeadSection from "../components/LeadSection.astro";
import { buyFaq } from "../data/faq";
import "../styles/inner-faq.css";
import RelocationMap from "../components/RelocationMap.astro";
import DealSteps from "../components/DealSteps.astro";
import RealtorComparison from "../components/RealtorComparison.astro";
import { buyDealSteps } from "../data/deal-steps";
import { buyRealtorComparison } from "../data/realtor-comparison";
import "../styles/buy-page.css";
---

<SiteLayout title="Покупка недвижимости — Монополия" header>
  <main class="buy-desktop">
    <InnerHero
      node="1380:6363"
      title={[siteText("buy.title.1"), siteText("buy.title.2") + " нет"]}
      markets
      description={siteText("buy.description.3")}
    />
    <BuyMortgage />
    <BuyClosedBase />
    <BuyNewBuild />
    <OfficeConsultation />
    <TrustAndViewing />
    <!-- 1380:6589: карта 6590, шаги 6839, сравнение 6977 (агент G) -->
    <RelocationMap />
    <DealSteps steps={buyDealSteps} />
    <RealtorComparison rows={buyRealtorComparison} />
    <FaqSection id="faq" items={buyFaq} node="1380:7007" class="inner-faq" />
    <LeadSection
      id="buy-question"
      node="1380:7022"
      subject="Вопрос со страницы «Покупка»"
    />
    <!-- 1380:7023 — общий footer выводится SiteLayout автоматически. -->
  </main>
</SiteLayout>
