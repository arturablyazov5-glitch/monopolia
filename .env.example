# Скопируйте в .env и заполните. .env не коммитится.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный URL обработчика. В dev без значения используется относительный /lead через прокси.
PUBLIC_LEAD_ENDPOINT=
# Origin сайта без пути и завершающего /, например https://example.github.io
PUBLIC_SITE_ORIGIN=
# Только локальная проверка без обращения в Telegram (по умолчанию выключена).
LEAD_DRY_RUN=0

ALLOWED_ORIGINS=
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=0
# Необязательно: собственный доверенный HTTPS прокси Telegram
TELEGRAM_API_BASE=https://api.telegram.org

# Админка: задаёт владелец, server/admin-set-password.mjs
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Отдельный серверный каталог: properties.json, properties.json.bak, media/
DATA_DIR=

# Открытый пароль для выдачи владельцу через Telegram; файл .env — права 600.
ADMIN_PASSWORD=
# Точный origin API (HTTPS); в dev обычно не нужен.
ADMIN_API_ORIGIN=
ADMIN_TELEGRAM_ID=
TELEGRAM_BOT_USERNAME=
# 0 выключает polling бота восстановления
ADMIN_RECOVERY_BOT=
# Публичные URL задаются при сборке сайта; в dev без них используются относительные пути через 4321.
PUBLIC_CATALOG_ENDPOINT=
PUBLIC_MEDIA_BASE=
