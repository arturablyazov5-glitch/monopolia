{
  "name": "monopoly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "share": "node scripts/share.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write src",
    "test": "node --test",
    "test:content": "node --test scripts/content-admin-test.mjs",
    "test:content:browser": "CONTENT_BROWSER_TEST=1 node --test scripts/content-admin-test.mjs",
    "test:content:preview": "CONTENT_PREVIEW_BROWSER_TEST=1 node --test scripts/content-preview-test.mjs",
    "dev:site": "astro dev --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3"
  }
}
